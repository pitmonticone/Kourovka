/-- Key symmetry: `(σ₀ * τ₀)³ = (τ₀ * σ₀)³` pointwise. -/
lemma h_cube_sym_lemma {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin (lcmN (k + 1))) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) := by
  have hσ_inv : ∀ n, σ₀ (σ₀ n) = n := fun n ↦ by
    have h := congr_fun (congr_arg (↑·) hσ₀_sq) n
    simpa [Equiv.Perm.mul_apply]
  have hτ_inv : ∀ n, τ₀ (τ₀ n) = n := fun n ↦ by
    have h := congr_fun (congr_arg (↑·) hτ₀_sq) n
    simpa [Equiv.Perm.mul_apply]
  rcases st_period_divides_6 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m with h1 | h2 | h3
  · -- Period 1: f(m) = m, so τ₀ m = σ₀ m, both sides reduce to m
    have hτm : τ₀ m = σ₀ m := by
      have := congr_arg σ₀ h1
      simp [hσ_inv] at this
      exact this
    have hg : τ₀ (σ₀ m) = m := by rw [← hτm, hτ_inv]
    simp [h1, hg]
  · -- Period 2: f²(m) = m. Both sides equal σ₀(τ₀ m).
        -- LHS: σ₀(τ₀(σ₀(τ₀(σ₀(τ₀ m)))))
        --  = σ₀(τ₀(m))  [since σ₀(τ₀(σ₀(τ₀ m))) = m by h2, applied to inner]
    have lhs_eq : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = σ₀ (τ₀ m) := by
      have : σ₀ (τ₀ (σ₀ (τ₀ m))) = m := h2
      show σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = σ₀ (τ₀ m)
      conv_lhs =>
        rw [show σ₀ (τ₀ (σ₀ (τ₀ m))) = m from h2]
          -- RHS: τ₀(σ₀(τ₀(σ₀(τ₀(σ₀ m)))))
              -- key: σ₀(τ₀ m) = τ₀(σ₀ m)
    have key : σ₀ (τ₀ m) = τ₀ (σ₀ m) := by
      have h := congr_arg σ₀ h2
      simp [hσ_inv] at h
      have h' := congr_arg τ₀ h
      simp [hτ_inv] at h'
      exact h'
    have rhs_eq : τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) = σ₀ (τ₀ m) := by
      calc
        τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (σ₀ (τ₀ m))))) := by rw [key]
        _ = τ₀ (σ₀ (τ₀ (τ₀ m))) := by rw [hσ_inv]
        _ = τ₀ (σ₀ m) := by rw [hτ_inv]
        _ = σ₀ (τ₀ m) := key.symm
    rw [lhs_eq, rhs_eq]
  · -- Period 3: f³(m) = m, and RHS = f⁻³(m) = m since f³ = id on orbit
        -- h3: σ₀(τ₀(σ₀(τ₀(σ₀(τ₀ m))))) = m. LHS = m.
        -- For RHS: apply alternating σ₀, τ₀ to h3 to get τ₀(σ₀(τ₀(σ₀(τ₀(σ₀ m))))) = m
    have rhs_eq : τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) = m := by
      -- From h3, apply σ₀ then τ₀ alternately:
      have s1 := congr_arg σ₀ h3
      simp [hσ_inv] at s1
      have s2 := congr_arg τ₀ s1
      simp [hτ_inv] at s2
      have s3 := congr_arg σ₀ s2
      simp [hσ_inv] at s3
      have s4 := congr_arg τ₀ s3
      simp [hτ_inv] at s4
      have s5 := congr_arg σ₀ s4
      simp [hσ_inv] at s5
      have s6 := congr_arg τ₀ s5
      simp [hτ_inv] at s6
      exact s6.symm
    rw [h3, rhs_eq]

/-- The commutator `g = σ₀ * τ₀ * σ₀ * τ₀` satisfies `g³ = 1`. -/
lemma commutator_swap01_swap02_cubed {k : ℕ} (hk : k ≥ 4)
    (σ₀ τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) :
    let g := σ₀ * τ₀ * σ₀ * τ₀
    g * g * g = 1 := by
  have hσ_inv : ∀ n, σ₀ (σ₀ n) = n := fun n ↦ by
    have h := congr_fun (congr_arg (↑·) hσ₀_sq) n
    simpa [Equiv.Perm.mul_apply]
  have hτ_inv : ∀ n, τ₀ (τ₀ n) = n := fun n ↦ by
    have h := congr_fun (congr_arg (↑·) hτ₀_sq) n
    simpa [Equiv.Perm.mul_apply]
  have h_cube_sym := h_cube_sym_lemma hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq
  have : σ₀ * τ₀ * σ₀ * τ₀ * (σ₀ * τ₀ * σ₀ * τ₀) * (σ₀ * τ₀ * σ₀ * τ₀) = 1 := by
    ext n
    simp only [Equiv.Perm.mul_apply, Equiv.Perm.one_apply]
    rw [show σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ n))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ n))))) from h_cube_sym n]
    simp only [hτ_inv, hσ_inv]
  exact this

