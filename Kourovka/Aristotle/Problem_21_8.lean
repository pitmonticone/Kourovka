/-- The class transposition swapping residues `0` and `2` modulo `4`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct4_02 : Equiv.Perm (Fin (lcmN 4)) :=
  (Equiv.swap (0 : Fin 4) 2).lcmRepeat (by omega) (by omega)

/-- The class transposition swapping residues `0` and `3` modulo `4`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct4_03 : Equiv.Perm (Fin (lcmN 4)) :=
