/-- In the prime case `k + 1 = p`, the commutator-type element `g'` constructed from
`g = [σ₀, τ₀]` and the conjugating sync permutation `ρ` is a `3`-cycle on
`Fin (lcmN (k + 1))`. -/
lemma prime_commutator_is_three_cycle {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_prime : Nat.Prime (k + 1)) (σ₀ τ₀ h₁ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1)
    (hh₁ :
      ∀ n : Fin (lcmN (k + 1)),
        (h₁ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (⟨5, by linarith [lcmN_ge_12 hk]⟩ : Fin (lcmN k))
                ⟨lcmN k - 1, Nat.sub_one_lt_of_le (by linarith [lcmN_ge_12 hk]) (le_refl _)⟩
                ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ :
              ℕ))
    (hh₁_sq : h₁ * h₁ = 1) :
    let g := σ₀ * τ₀ * σ₀ * τ₀
    let g'' := h₁ * g * h₁
    let result := g * g'' * g''
    result.IsCycle ∧ result.support.card = 3 := by
  have hN_eq := lcmN_succ_prime hk hne h_prime
  have hcop := coprime_prime_lcmN hk hne h_prime
  have hL_ge := lcmN_ge_12 hk
  have ⟨A', hA'_p, hA'_L⟩ :=
    crt_fin_exists (show 0 < k + 1 by omega) lcmN_pos hcop 3 (by omega) 2 (by linarith)
  set A : Fin (lcmN (k + 1)) := (finCongr hN_eq.symm) A'
  have hA_p : A.val % (k + 1) = 3 := by
    show A'.val % (k + 1) = 3
    exact hA'_p
  have hA_L : A.val % lcmN k = 2 := by
    show A'.val % lcmN k = 2
    exact hA'_L
  have hA_div_L : A.val = lcmN k * (A.val / lcmN k) + 2 := by
    have := Nat.div_add_mod A.val (lcmN k)
    omega
  have hA_div_p : A.val = (k + 1) * (A.val / (k + 1)) + 3 := by
    have := Nat.div_add_mod A.val (k + 1)
    omega
  have hA_ge : A.val ≥ lcmN k + 2 := by
    by_contra h_lt
    push_neg at h_lt
    have hq : A.val / lcmN k = 0 := by
      by_contra hq
      push_neg at hq
      have : A.val / lcmN k ≥ 1 := Nat.one_le_iff_ne_zero.mpr hq
      nlinarith [Nat.le_mul_of_pos_right (lcmN k) (by omega : A.val / lcmN k > 0)]
    have hval : A.val = 2 := by
      have := Nat.mul_sub_one (lcmN k) (A.val / lcmN k)
      simp [hq] at hA_div_L
      omega
    rw [hval, Nat.mod_eq_of_lt (by omega : 2 < k + 1)] at hA_p
    omega
  have hA_quot_ge : A.val / lcmN k ≥ 1 := Nat.div_pos (by omega : A.val ≥ lcmN k) lcmN_pos
  set B : Fin (lcmN (k + 1)) := ⟨A.val - 3, by omega⟩
  have hB_val : B.val = A.val - 3 := rfl
  have hB_p : B.val % (k + 1) = 0 := by
    rw [hB_val]
    rw [show A.val - 3 = (k + 1) * (A.val / (k + 1)) from by omega]
    exact Nat.mul_mod_right _ _
  have hB_L : B.val % lcmN k = lcmN k - 1 := by
    rw [hB_val]
    have hLsub : lcmN k * (A.val / lcmN k - 1) = lcmN k * (A.val / lcmN k) - lcmN k :=
      Nat.mul_sub_one (lcmN k) (A.val / lcmN k)
    have hLq_ge : lcmN k * (A.val / lcmN k) ≥ lcmN k :=
      Nat.le_mul_of_pos_right (lcmN k) (by omega)
    rw [show A.val - 3 = lcmN k * (A.val / lcmN k - 1) + (lcmN k - 1) from by omega]
    rw [Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (by omega)
  set C : Fin (lcmN (k + 1)) := ⟨A.val - lcmN k + 3, by omega⟩
  have hC_val : C.val = A.val - lcmN k + 3 := rfl
  have hC_L : C.val % lcmN k = 5 := by
    rw [hC_val]
    have hLsub : lcmN k * (A.val / lcmN k - 1) = lcmN k * (A.val / lcmN k) - lcmN k :=
      Nat.mul_sub_one (lcmN k) (A.val / lcmN k)
    have hLq_ge : lcmN k * (A.val / lcmN k) ≥ lcmN k :=
      Nat.le_mul_of_pos_right (lcmN k) (by omega)
    rw [show A.val - lcmN k + 3 = lcmN k * (A.val / lcmN k - 1) + 5 from by omega]
    rw [Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (by omega)
  have hAB : A ≠ B := by
    intro h
    have := congrArg Fin.val h
    simp [hB_val] at this
    omega
  have hBC : B ≠ C := by
    intro h
    have := congrArg Fin.val h
    simp [hB_val, hC_val] at this
    omega
  have hAC : A ≠ C := by
    intro h
    have := congrArg Fin.val h
    simp [hC_val] at this
    omega
  intro g g'' result
  have hAminus2_p : (A.val - 2) % (k + 1) = 1 := by
    rw [show A.val - 2 = (k + 1) * (A.val / (k + 1)) + 1 from by omega]
    rw [Nat.mul_add_mod]
    exact Nat.mod_eq_of_lt (by omega)
  have hAminus2_L : (A.val - 2) % lcmN k = 0 := by
    rw [show A.val - 2 = lcmN k * (A.val / lcmN k) from by omega]
    exact
      Nat.mul_mod_right _
        _
          /-
            The four key facts: result A = B, result B = C, result C = A, and fixpoint.
            Each is proved by tracing through the permutation composition using
            σ₀, τ₀, h₁ value hypotheses.
            -/
  have hσ₀_A : σ₀ A = A := by
    rw [Fin.ext_iff, hσ₀]
    norm_num [hA_p, Equiv.swap_apply_def]
    simp [Fin.ext_iff]
    rw [if_neg (by rw [Nat.mod_eq_of_lt] <;> linarith)]
    norm_num [Nat.div_add_mod']
    linarith [Nat.mod_add_div A (k + 1)]
  have hτ₀_fix :
    ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % lcmN k ≠ 0 → (n : ℕ) % lcmN k ≠ 2 → τ₀ n = n := by
    intros n hn0 hn2
    have h_swap :
      (Equiv.swap 0 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : Fin (lcmN k)) =
        ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ := by
      rw [Equiv.swap_apply_def]
      simp [Fin.ext_iff, hn0]
      exact fun h ↦ False.elim <| hn2 <| h.trans <| Nat.mod_eq_of_lt <| by linarith
    exact
      Fin.ext (by
          rw [hτ₀, h_swap]
          linarith [Nat.mod_add_div n (lcmN k)])
  have hh₁_fix :
    ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % lcmN k ≠ 5 → (n : ℕ) % lcmN k ≠ lcmN k - 1 → h₁ n = n := by
    intros n hn5 hnL
    have h_swap :
      Equiv.swap (⟨5, by linarith⟩ : Fin (lcmN k))
          (⟨lcmN k - 1, by exact Nat.pred_lt (ne_bot_of_gt hL_ge)⟩ : Fin (lcmN k))
          ⟨n.val % lcmN k, Nat.mod_lt _ (by linarith)⟩ =
        ⟨n.val % lcmN k, Nat.mod_lt _ (by linarith)⟩ :=
      by simp [Equiv.swap_apply_def, hn5, hnL]
    exact
      Fin.ext (by
          simp [hh₁, h_swap]
          linarith [Nat.mod_add_div n (lcmN k)])
  set Am2 : Fin (lcmN (k + 1)) := ⟨A.val - 2, by omega⟩ with hAm2_def
  have hAm2_val : Am2.val = A.val - 2 := rfl
  have hg_C : g C = C := by
    apply invol_comm_fix hσ₀_sq hτ₀_sq
    left
    refine
      ⟨hτ₀_fix C (by
            rw [hC_L]
            omega) (by
            rw [hC_L]
            omega),
        ?_⟩
    have hσ₀C_tri := swap01_lcmRepeat_val_trichotomy σ₀ hσ₀ C
    have hσ₀C_mod := mod_ne_zero_two_of_close (by linarith : lcmN k ≥ 7) hC_L hσ₀C_tri
    exact hτ₀_fix (σ₀ C) hσ₀C_mod.1 hσ₀C_mod.2
  have hg_A : g A = Am2 := by
    simp [g]
    rw [show τ₀ A = ⟨A.val - 2, by omega⟩ from ?_,
      show σ₀ ⟨A.val - 2, by omega⟩ = ⟨A.val - 3, by omega⟩ from ?_,
      show τ₀ ⟨A.val - 3, by omega⟩ = ⟨A.val - 3, by omega⟩ from ?_]
    · rw [Fin.ext_iff]
      rw [hσ₀]
      simp [Equiv.swap_apply_def]
      split_ifs <;> norm_num at *
      · rw [Nat.mod_eq_of_lt (by linarith : 1 < k + 1)]
        rw [Nat.div_mul_cancel (Nat.dvd_of_mod_eq_zero ‹_›)]
        omega
      · grind
    · convert hτ₀_fix _ _ _ using 1
      · grind
      · grind
    · refine' Fin.ext _
      rw [hσ₀]
      simp [hAminus2_p, Equiv.swap_apply_def]
      simp [Fin.ext_iff]
      rw [if_pos (by
            rw [Nat.mod_eq_of_lt]
            linarith)]
      norm_num
      rw [← Nat.mod_add_div (A : ℕ) (k + 1), hA_p]
      norm_num
      rw [show 3 + (k + 1) * (A / (k + 1)) - 2 = (k + 1) * (A / (k + 1)) + 1 by
          rw [Nat.sub_eq_of_eq_add]
          ring]
      norm_num [Nat.add_div]
      ring_nf
      rcases k with (_ | _ | k) <;> simp +arith +decide [Nat.div_eq_of_lt] at *
    · ext
      simp [hτ₀, hA_L]
      simp [Equiv.swap_apply_def]
      simp [Fin.ext_iff]
      rw [if_pos (by
            rw [Nat.mod_eq_of_lt]
            linarith)]
      norm_num
      linarith [Nat.sub_add_cancel (by linarith : 2 ≤ (A : ℕ))]
  have hg_Am2 : g Am2 = B := by
    -- Since σ₀ fixes A, we have σ₀ Am2 = B.
    have hσ₀_Am2 : σ₀ Am2 = B := by
      ext
      simp [hσ₀]
      norm_num [hAm2_val, hAminus2_p]
      norm_num [Equiv.swap_apply_def]
      norm_num [Fin.ext_iff]
      rw [if_pos (by
            rw [Nat.mod_eq_of_lt]
            linarith)]
      norm_num [hB_val]
      rw [← Nat.mod_add_div (A : ℕ) (k + 1), hA_p]
      norm_num [Nat.add_mod, Nat.mul_mod]
      rw [show 3 + (k + 1) * (A / (k + 1)) - 2 = (k + 1) * (A / (k + 1)) + 1 by
          rw [Nat.sub_eq_of_eq_add]
          ring]
      norm_num [Nat.add_div]
      ring_nf
      rcases k with (_ | _ | k) <;> simp +arith +decide [Nat.div_eq_of_lt] at *
    simp [g]
    rw [show τ₀ Am2 = A from _]
    · rw [hσ₀_A, show τ₀ A = Am2 from _]
      · exact hσ₀_Am2
      · rw [← Fin.val_inj]
        simp [hτ₀, hA_L]
        simp [Equiv.swap_apply_def]
        simp [Fin.ext_iff]
        rw [if_pos (by
              rw [Nat.mod_eq_of_lt]
              linarith)]
        norm_num [hAm2_val]
        exact eq_tsub_of_add_eq (by linarith)
    · refine' Fin.ext _
      rw [hτ₀]
      norm_num [hAm2_val, hAminus2_L]
      rw [Nat.mod_eq_of_lt] <;>
        linarith [Nat.div_mul_cancel
            (show lcmN k ∣ (A : ℕ) - 2 from Nat.dvd_of_mod_eq_zero hAminus2_L),
          Nat.sub_add_cancel (show 2 ≤ (A : ℕ) from by linarith)]
  have hg_B : g B = A := by
    have hg_B : σ₀ B = Am2 := by
      ext
      rw [hσ₀, hB_val]
      rw [← Nat.mod_add_div (A : ℕ) (k + 1), hA_p]
      norm_num [Nat.add_mod, Nat.mul_mod] at *
      simp +decide [hAminus2_p] at *
      rw [Nat.mod_eq_of_lt] <;>
        linarith [Nat.sub_add_cancel (show 2 ≤ (A : ℕ) from by linarith)]
    have hg_B : τ₀ Am2 = A := by
      ext
      simp [hτ₀, hAm2_val]
      simp [hAminus2_L]
      rw [Nat.mod_eq_of_lt (by linarith : 2 < lcmN k)]
      linarith [Nat.div_mul_cancel
          (show lcmN k ∣ (A : ℕ) - 2 from Nat.dvd_of_mod_eq_zero hAminus2_L),
        Nat.sub_add_cancel (show 2 ≤ (A : ℕ) from by linarith)]
    have hg_B : g B = σ₀ (τ₀ (σ₀ (τ₀ B))) := by simp [g, Equiv.Perm.mul_apply]
    rw [hg_B, show τ₀ B = B from ?_]
    · rw [‹σ₀ B = Am2›, ‹τ₀ Am2 = A›, hσ₀_A]
    · exact hτ₀_fix B (by omega) (by omega)
  have hh₁_B : h₁ B = C := by
    rw [Fin.ext_iff]
    rw [hh₁, hC_val]
    simp [hB_L]
    rw [hB_val, hA_div_L]
    rw [show (lcmN k * (A / lcmN k) + 2 - 3 : ℕ) = lcmN k * (A / lcmN k - 1) + (lcmN k - 1) by
        exact
          Nat.sub_eq_of_eq_add <| by
            nlinarith only [Nat.sub_add_cancel hA_quot_ge,
              Nat.sub_add_cancel (by linarith : 1 ≤ lcmN k)]]
    rw [Nat.add_div] <;> norm_num [Nat.div_eq_of_lt, hL_ge]
    · rw [Nat.mul_div_cancel_left _ (by linarith),
        Nat.div_eq_of_lt (Nat.sub_lt (by linarith) (by linarith))]
      split_ifs <;> norm_num at *
      · exact absurd ‹_› (not_le_of_gt (Nat.pred_lt (ne_bot_of_gt hL_ge)))
      · exact eq_tsub_of_add_eq (by nlinarith only [Nat.sub_add_cancel hA_quot_ge])
    · linarith
  have hh₁_C : h₁ C = B := by
    rw [← hh₁_B]
    have := congr_arg (fun f ↦ f B) hh₁_sq
    simpa [Equiv.Perm.mul_apply] using this
  have hh₁_A : h₁ A = A :=
    hh₁_fix A (by
        rw [hA_L]
        omega) (by
        rw [hA_L]
        omega)
  have hh₁_Am2 : h₁ Am2 = Am2 :=
    hh₁_fix Am2 (by
        simp [hAm2_def]
        rw [hAminus2_L]
        omega) (by
        simp [hAm2_def]
        rw [hAminus2_L]
        omega)
  have hg''_A : g'' A = Am2 := by
    show h₁ (g (h₁ A)) = Am2
    rw [hh₁_A, hg_A, hh₁_Am2]
  have hg''_Am2 : g'' Am2 = C := by
    show h₁ (g (h₁ Am2)) = C
    rw [hh₁_Am2, hg_Am2, hh₁_B]
  have hg''_B : g'' B = B := by
    show h₁ (g (h₁ B)) = B
    rw [hh₁_B, hg_C, hh₁_C]
  have hg''_C : g'' C = A := by
    show h₁ (g (h₁ C)) = A
    rw [hh₁_C, hg_B, hh₁_A]
  have hres_A : result A = C := by
    show g (g'' (g'' A)) = C
    rw [hg''_A, hg''_Am2, hg_C]
  have hres_B : result B = A := by
    show g (g'' (g'' B)) = A
    rw [hg''_B, hg''_B, hg_B]
  have hres_C : result C = B := by
    show g (g'' (g'' C)) = B
    rw [hg''_C, hg''_A, hg_Am2]
  have hg_cubed : g * g * g = 1 := commutator_swap01_swap02_cubed hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq
  have hh₁_invol : ∀ x : Fin (lcmN (k + 1)), h₁ (h₁ x) = x := by
    intro x
    have := congr_fun (congr_arg (↑·) hh₁_sq) x
    simpa [Equiv.Perm.mul_apply] using this
  have hg_fixes_L5 : ∀ m : Fin (lcmN (k + 1)), m.val % lcmN k = 5 → g m = m := by
    intro m hm
    apply invol_comm_fix hσ₀_sq hτ₀_sq
    left
    refine
      ⟨hτ₀_fix m (by
            rw [hm]
            omega) (by
            rw [hm]
            omega),
        ?_⟩
    exact
      hτ₀_fix (σ₀ m)
        (mod_ne_zero_two_of_close (by linarith) hm (swap01_lcmRepeat_val_trichotomy σ₀ hσ₀ m)).1
        (mod_ne_zero_two_of_close (by linarith) hm (swap01_lcmRepeat_val_trichotomy σ₀ hσ₀ m)).2
  have hg_fixes_Lm1 : ∀ m : Fin (lcmN (k + 1)), m.val % lcmN k = lcmN k - 1 → m ≠ B → g m = m := by
    intro m hm hmB
    have hm_p_ne0 : m.val % (k + 1) ≠ 0 := by
      intro hp
      apply hmB
      ext
      have hcrt : m.val ≡ B.val [MOD ((k + 1) * lcmN k)] := by
        rw [← Nat.modEq_and_modEq_iff_modEq_mul hcop]
        exact ⟨by simp [Nat.ModEq, hp, hB_p], by simp [Nat.ModEq, hm, hB_L]⟩
      rwa [Nat.ModEq, Nat.mod_eq_of_lt (hN_eq ▸ m.2), Nat.mod_eq_of_lt (hN_eq ▸ B.2)] at hcrt
    apply invol_comm_fix hσ₀_sq hτ₀_sq
    left
    refine ⟨hτ₀_fix m (by omega) (by omega), ?_⟩
    exact
      hτ₀_fix (σ₀ m)
        (mod_ne_zero_two_of_close_Lm1 (by linarith) hm (swap01_no_inc σ₀ hσ₀ m hm_p_ne0)).1
        (mod_ne_zero_two_of_close_Lm1 (by linarith) hm (swap01_no_inc σ₀ hσ₀ m hm_p_ne0)).2
  have hg_cubed_app : ∀ x : Fin (lcmN (k + 1)), g (g (g x)) = x := by
    intro x
    have := congr_fun (congr_arg (↑·) hg_cubed) x
    simpa [Equiv.Perm.mul_apply] using this
  have hg2_fix_implies_fix : ∀ x : Fin (lcmN (k + 1)), g (g x) = x → g x = x := by
    intro x hg2x
    exact (congr_arg g hg2x).symm.trans (hg_cubed_app x)
  have hg_fix_gn : ∀ x : Fin (lcmN (k + 1)), g (g x) = g x → g x = x := by
    intro x hfx
    exact hg2_fix_implies_fix x ((congr_arg g hfx).symm.trans (hg_cubed_app x))
  have hres_fix : ∀ n : Fin (lcmN (k + 1)), n ≠ A → n ≠ C → n ≠ B → result n = n := by
    intro n hnA hnC hnB
    show g (g'' (g'' n)) = n
    by_cases hnAm2 : n = Am2
    · subst hnAm2
      rw [hg''_Am2, hg''_C, hg_A]
    · by_cases hgn : g n = n
      · have hg''n : g'' n = n := by
          show h₁ (g (h₁ n)) = n
          by_cases hh1n : h₁ n = n
          · rw [hh1n, hgn]
            exact hh1n
          · have hh1n_fixed : g (h₁ n) = h₁ n := by
              by_cases hL5 : n.val % lcmN k = 5
              · have hh1n_ne_B : h₁ n ≠ B := by
                  intro heq
                  apply hnC
                  have : n = h₁ (h₁ n) := (hh₁_invol n).symm
                  rw [heq, hh₁_B] at this
                  exact this
                exact hg_fixes_Lm1 (h₁ n) (swap_lcmk_5_to_Lm1 hk h₁ hh₁ n hL5) hh1n_ne_B
              · by_cases hLm1 : n.val % lcmN k = lcmN k - 1
                · exact hg_fixes_L5 (h₁ n) (swap_lcmk_Lm1_to_5 hk h₁ hh₁ n hLm1)
                · exact absurd (hh₁_fix n hL5 hLm1) hh1n
            rw [hh1n_fixed]
            exact hh₁_invol n
        rw [hg''n, hg''n, hgn]
      · have hn_not_L5 : n.val % lcmN k ≠ 5 := fun h ↦ hgn (hg_fixes_L5 n h)
        have hn_not_Lm1 : n.val % lcmN k ≠ lcmN k - 1 := fun h ↦ hgn (hg_fixes_Lm1 n h hnB)
        have hh1_n : h₁ n = n := hh₁_fix n hn_not_L5 hn_not_Lm1
        have hgn_not_L5 : (g n).val % lcmN k ≠ 5 := by
          intro h
          exact
            hgn
              (hg_fix_gn n (hg_fixes_L5 (g n) h))
        have hgn_not_Lm1 : (g n).val % lcmN k ≠ lcmN k - 1 := by
          intro h
          by_cases hgnB : g n = B
          · have h3 := hg_cubed_app n
            rw [show g (g n) = A from hgnB ▸ hg_B] at h3
            rw [hg_A] at h3
            exact hnAm2 h3.symm
          · exact hgn (hg_fix_gn n (hg_fixes_Lm1 (g n) h hgnB))
        have hh1_gn : h₁ (g n) = g n := hh₁_fix (g n) hgn_not_L5 hgn_not_Lm1
        have hg2n_not_L5 : (g (g n)).val % lcmN k ≠ 5 := by
          intro h
          have hfix := hg_fixes_L5 (g (g n)) h
          have h3 := hg_cubed_app n
          exact
            hgn
              (hg2_fix_implies_fix n (hfix.symm.trans h3))
                -- g²(n) avoids L=L-1
        have hg2n_not_Lm1 : (g (g n)).val % lcmN k ≠ lcmN k - 1 := by
          intro h
          by_cases hg2B : g (g n) = B
          · -- g²(n)=B ⟹ g³(n)=g(B)=A ⟹ n=A. Contradiction.
            have h3 := hg_cubed_app n
            rw [hg2B, hg_B] at h3
            exact hnA h3.symm
          · have hfix := hg_fixes_Lm1 (g (g n)) h hg2B
            have h3 := hg_cubed_app n
            exact hgn (hg2_fix_implies_fix n (hfix.symm.trans h3))
        have hh1_g2n : h₁ (g (g n)) = g (g n) := hh₁_fix (g (g n)) hg2n_not_L5 hg2n_not_Lm1
        have hg''_n : g'' n = g n := by
          show h₁ (g (h₁ n)) = g n
          rw [hh1_n, hh1_gn]
        have hg''_gn : g'' (g n) = g (g n) := by
          show h₁ (g (h₁ (g n))) = g (g n)
          rw [hh1_gn, hh1_g2n]
        rw [hg''_n, hg''_gn, hg_cubed_app]
  exact is_three_cycle_of_vals hAC hBC.symm hAB hres_A hres_C hres_B hres_fix

/-- CT(k+1) contains a 3-cycle in the prime growth case. -/
lemma CT_growth_three_cycle_prime {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (ih : CT k = ⊤) (h_prime : Nat.Prime (k + 1)) :
    ∃ σ ∈ CT (k + 1), σ.IsCycle ∧ σ.support.card = 3 := by
  have hd_pos : (0 : ℕ) < k + 1 := by omega
  have hL_ge : lcmN k ≥ 12 := lcmN_ge_12 hk
  set σ₀ := (Equiv.swap (0 : Fin (k + 1)) 1).lcmRepeat (le_refl _) hd_pos
  have hσ₀_mem : σ₀ ∈ CT (k + 1) := lcmRepeat_mem_CT (le_refl _) hd_pos (by omega) 0 1
  have hσ₀_val :
    ∀ n : Fin (lcmN (k + 1)),
      (σ₀ n : ℕ) =
        (n : ℕ) / (k + 1) * (k + 1) +
          (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ hd_pos⟩ : ℕ) :=
    fun n ↦ lcmRepeat_val (le_refl _) hd_pos _ n
  have hσ₀_sq : σ₀ * σ₀ = 1 := lcmRepeat_swap_sq (le_refl _) hd_pos 0 1
  obtain ⟨τ₀, hτ₀_mem, hτ₀_val⟩ :=
    syncPerm_mem_CT (show 2 ≤ k by omega) hne ih (Equiv.swap (0 : Fin (lcmN k)) 2)
  have hτ₀_sq : τ₀ * τ₀ = 1 := syncPerm_invol_of_swap (lcmN k) lcmN_pos _ τ₀ 0 2 hτ₀_val
  obtain ⟨h₁, hh₁_mem, hh₁_val⟩ :=
    syncPerm_mem_CT (show 2 ≤ k by omega) hne ih
      (Equiv.swap (⟨5, by omega⟩ : Fin (lcmN k)) ⟨lcmN k - 1, by omega⟩)
  have hh₁_sq : h₁ * h₁ = 1 :=
    syncPerm_invol_of_swap (lcmN k) lcmN_pos _ h₁ ⟨5, by omega⟩ ⟨lcmN k - 1, by omega⟩ hh₁_val
  set g := σ₀ * τ₀ * σ₀ * τ₀
  set g'' := h₁ * g * h₁
  set result := g * g'' * g''
  refine ⟨result, ?_, ?_⟩
  · -- Membership: result ∈ CT(k+1)
    have hg : g ∈ CT (k + 1) :=
      (CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem hσ₀_mem hτ₀_mem) hσ₀_mem)
        hτ₀_mem
    have hg'' : g'' ∈ CT (k + 1) :=
      (CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem hh₁_mem hg) hh₁_mem
    exact (CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem hg hg'') hg''
  · -- 3-cycle property
    exact
      prime_commutator_is_three_cycle hk hne h_prime σ₀ τ₀ h₁ hσ₀_val hτ₀_val hσ₀_sq hτ₀_sq
        hh₁_val hh₁_sq

/-- CT(k+1) contains a 3-cycle in the growth case. -/
lemma CT_growth_contains_three_cycle {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (ih : CT k = ⊤) : ∃ σ ∈ CT (k + 1), σ.IsCycle ∧ σ.support.card = 3 := by
  by_cases hp : Nat.Prime (k + 1)
  · exact CT_growth_three_cycle_prime hk hne ih hp
  · exact CT_growth_three_cycle_composite hk hne ih hp

/-- The alternating group is contained in CT(k+1) in the growth case.
Combines Jordan's theorem (Mathlib's `alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem`)
with transitivity, primitivity, and the existence of a three-cycle. -/
lemma CT_growth_alt_le {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤) :
    alternatingGroup (Fin (lcmN (k + 1))) ≤ CT (k + 1) := by
  obtain ⟨σ, hσ_mem, hσ_cycle, hσ_card⟩ := CT_growth_contains_three_cycle hk hne ih
  have hσ_three : σ.IsThreeCycle := card_support_eq_three_iff.mp hσ_card
  exact
    Equiv.Perm.alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem
      (isPreprimitive_of_transitive_primitive (CT (k + 1)) (CT_growth_transitive hk hne ih)
        (CT_growth_primitive hk hne ih))
      hσ_three hσ_mem

/-- The key inductive step when `lcmN` grows (k+1 is a prime power). -/
lemma CT_step_lcmN_grows {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤) :
    CT (k + 1) = ⊤ :=
  eq_top_of_alt_le_of_odd_perm (CT (k + 1)) (CT_growth_alt_le hk hne ih)
    (CT_growth_odd_perm hk hne)

/-- **Kourovka Notebook Problem 21.8**: For `k ≥ 4`, `CT(k) = Sym(N)` where
`N = lcm(2, 3, ..., k)`. -/
theorem kourovka_21_8_alt (k : ℕ) (hk : k ≥ 4) : CT k = ⊤ := by
  induction k with
  | zero => omega
  | succ n ih =>
    by_cases hn : n < 4
    · have : n = 3 := by omega
      subst this
      exact CT4_eq_top
    · push_neg at hn
      by_cases heq : lcmN (n + 1) = lcmN n
      · exact CT_le_succ_of_lcmN_eq (by omega) heq (ih (by omega))
      · exact CT_step_lcmN_grows (by omega) heq (ih (by omega))

namespace Kourovka21_8

/-!
# Residue Class Swap Permutation
We define residue classes `residueClass r m = {r + k * m | k ∈ ℤ}` and construct
a permutation of `ℤ` that swaps elements between two disjoint residue classes,
pairing `r₁ + t * m₁` with `r₂ + t * m₂` for each `t ∈ ℤ` and fixing all other elements.
-/

/-- The residue class `{r + k * m | k ∈ ℤ}`, equivalently `{n ∈ ℤ | m ∣ n - r}`. -/
def residueClass (r m : ℤ) : Set ℤ :=
  {n | m ∣ (n - r)}

/-- Membership in the residue class `r(m)` is divisibility of `n - r` by `m`. -/
theorem mem_residueClass_iff {r m n : ℤ} : n ∈ residueClass r m ↔ m ∣ (n - r) :=
  Iff.rfl

/-- The representative `r` lies in its own residue class `r(m)`. -/
theorem self_mem_residueClass (r m : ℤ) : r ∈ residueClass r m := by simp [residueClass]

/-- Every element of the form `r + k * m` belongs to the residue class `r(m)`. -/
theorem mem_residueClass_add_mul (r m k : ℤ) : r + k * m ∈ residueClass r m := by
  simp [residueClass]

/--
The class transposition function for swapping residue classes `r₁(k)` and `r₂(k)` for a fixed
`k`, since these are the only kinds of maps appearing in `CT_{(k)}`.   -/
def τFun (k r₁ r₂ : ℤ) (n : ℤ) : ℤ :=
  if k ∣ (n - r₁) then n + r₂ - r₁ else if k ∣ (n - r₂) then n + r₁ - r₂ else n

section involution

variable {k r₁ r₂ n : ℤ}

/-- If `n` lies in the residue class `r₁(k)`, then `τFun k r₁ r₂ n = n + r₂ - r₁`. -/
lemma τFun_of_mem_class1 (h : k ∣ (n - r₁)) : τFun k r₁ r₂ n = n + r₂ - r₁ := by simp [τFun, h]

/-- If `n` lies in the residue class `r₂(k)` but not `r₁(k)`, then
`τFun k r₁ r₂ n = n + r₁ - r₂`. -/
lemma τFun_of_mem_class2 (h₁ : ¬k ∣ (n - r₁)) (h₂ : k ∣ (n - r₂)) :
    τFun k r₁ r₂ n = n + r₁ - r₂ := by simp [τFun, h₁, h₂]

/-- If `n` lies in neither residue class, then `τFun` fixes `n`. -/
lemma τFun_of_not_mem (h₁ : ¬k ∣ (n - r₁)) (h₂ : ¬k ∣ (n - r₂)) : τFun k r₁ r₂ n = n := by
  simp [τFun, h₁, h₂]

/-- `τFun` maps the residue class `r₁(k)` into the residue class `r₂(k)`. -/
lemma τFun_image_in_class2 (h : k ∣ (n - r₁)) : k ∣ (τFun k r₁ r₂ n - r₂) := by
  rw [τFun_of_mem_class1 h]
  ring_nf
  exact h

/-- `τFun` maps the residue class `r₂(k)` (excluding `r₁(k)`) into the residue class `r₁(k)`. -/
lemma τFun_image_in_class1 (h₁ : ¬k ∣ (n - r₁)) (h₂ : k ∣ (n - r₂)) :
    k ∣ (τFun k r₁ r₂ n - r₁) := by
  rw [τFun_of_mem_class2 h₁ h₂]
  ring_nf
  exact h₂

/-- `τFun` is its own inverse on `r₁(k)` when the residue classes are disjoint. -/
lemma τFun_roundtrip_class1 (h : k ∣ (n - r₁)) (h' : ¬k ∣ (r₂ - r₁)) :
    τFun k r₁ r₂ (τFun k r₁ r₂ n) = n := by
  rw [τFun_of_mem_class2]
  · rw [τFun_of_mem_class1 h]
    ring
  · rw [τFun_of_mem_class1 h]
    by_contra h''
    apply h'
    have := Int.dvd_sub h'' h
    ring_nf at this
    exact this
  · rw [τFun_of_mem_class1 h]
    ring_nf
    exact h

/-- `τFun` is its own inverse on `r₂(k)` (when `n ∉ r₁(k)`). -/
lemma τFun_roundtrip_class2 (h₁ : ¬k ∣ (n - r₁)) (h₂ : k ∣ (n - r₂)) :
    τFun k r₁ r₂ (τFun k r₁ r₂ n) = n := by
  rw [τFun_of_mem_class1 (τFun_image_in_class1 h₁ h₂), τFun_of_mem_class2 h₁ h₂]
  ring

/-- `τFun k r₁ r₂` is an involution whenever the residue classes `r₁(k)` and `r₂(k)`
are disjoint, i.e. `k ∤ r₂ - r₁`. -/
theorem τ_involutive (h' : ¬k ∣ (r₂ - r₁)) : Function.Involutive (τFun k r₁ r₂) := by
  intro n
  by_cases h₁ : k ∣ (n - r₁)
  · exact τFun_roundtrip_class1 h₁ h'
  · by_cases h₂ : k ∣ (n - r₂)
    · exact τFun_roundtrip_class2 h₁ h₂
    · simp [τFun_of_not_mem h₁ h₂]

end involution

/-- The permutation of `ℤ` that swaps `r₁ + t * k` with `r₂ + t * k` for each `t ∈ ℤ`,
keeping all other integers fixed. If the residue classes are not disjoint then
is the identity permutation. -/
def τ (k r₁ r₂ : ℤ) : Equiv.Perm ℤ :=
  if h : k ∣ (r₂ - r₁) then Equiv.refl ℤ else (τ_involutive h).toPerm _

/-- The subgroup of `Perm ℤ` generated by class transpositions of modulus `k`,
i.e. all `τ k r₁ r₂` with `0 ≤ r₁, r₂ < k`. -/
def CT' (k : ℤ) : Subgroup (Equiv.Perm ℤ) :=
  Subgroup.closure ((fun (r₁, r₂) ↦ τ k r₁ r₂) '' (Set.Ico 0 k ×ˢ Set.Ico 0 k))

/-- `CT k = ⟨CT'(2), CT'(3), …, CT'(k)⟩` is the subgroup of `Perm ℤ` generated by all class
transpositions of moduli `2 ≤ d ≤ k`. -/
def CT (k : ℤ) : Subgroup (Equiv.Perm ℤ) :=
  ⨆ i ∈ Set.Icc 2 k, CT' i

section ShiftPeriodic

/-! ## Shift Periodicity Framework
A permutation `σ` of `ℤ` is *N-shift-periodic* if `σ(n + N) = σ(n) + N` for all `n`.
The class transpositions `τ_{r₁(k), r₂(k)}` are `k`-shift-periodic, and this property
is preserved under composition and inversion. Since each modulus divides
`N = lcm(2,...,k)`, every element of `CT(k)` is `N`-shift-periodic.
This allows us to define a reduction homomorphism `CT(k) → Perm(Fin N)` that
restricts each permutation to a single period `{0, 1, ..., N-1}`.
-/

/-- A permutation `σ` of `ℤ` is `N`-shift-periodic if `σ(n + N) = σ(n) + N` for all `n`. -/
def IsShiftPeriodic (σ : Equiv.Perm ℤ) (N : ℤ) : Prop :=
  ∀ n : ℤ, σ (n + N) = σ n + N

/-- The identity permutation is `N`-shift-periodic for every `N`. -/
lemma isShiftPeriodic_refl (N : ℤ) : IsShiftPeriodic (Equiv.refl ℤ) N := by
  intro
  simp

/-- The identity element of `Perm ℤ` is `N`-shift-periodic for every `N`. -/
lemma isShiftPeriodic_one (N : ℤ) : IsShiftPeriodic (1 : Equiv.Perm ℤ) N :=
  isShiftPeriodic_refl N

/-- The product of two `N`-shift-periodic permutations is `N`-shift-periodic. -/
lemma IsShiftPeriodic.mul {σ₁ σ₂ : Equiv.Perm ℤ} {N : ℤ} (h₁ : IsShiftPeriodic σ₁ N)
    (h₂ : IsShiftPeriodic σ₂ N) : IsShiftPeriodic (σ₁ * σ₂) N := by
  intro n
  simp only [Equiv.Perm.mul_apply]
  rw [h₂ n, h₁ (σ₂ n)]

/-- The inverse of an `N`-shift-periodic permutation is `N`-shift-periodic. -/
lemma IsShiftPeriodic.inv {σ : Equiv.Perm ℤ} {N : ℤ} (h : IsShiftPeriodic σ N) :
    IsShiftPeriodic σ⁻¹ N := by
  intro n
  apply σ.injective
  simp only [Equiv.Perm.coe_inv, Equiv.apply_symm_apply, h (σ.symm n)]

variable {k r₁ r₂ : ℤ}

/-- `τFun` is `k`-shift-periodic: `τFun k r₁ r₂ (n + k) = τFun k r₁ r₂ n + k`.-/
lemma τFun_shiftPeriodic (n : ℤ) : τFun k r₁ r₂ (n + k) = τFun k r₁ r₂ n + k := by
  unfold τFun
  split_ifs <;> simp_all [add_sub_right_comm]
  · lia
  · ring

/-- The class transposition `τ k r₁ r₂` is `k`-shift-periodic. -/
lemma τ_isShiftPeriodic : IsShiftPeriodic (τ k r₁ r₂) k := by
  unfold τ
  unfold IsShiftPeriodic
  split_ifs <;> simp_all [Function.Involutive.toPerm]
  exact fun n ↦ τFun_shiftPeriodic n

/-- If `σ` is `m`-shift-periodic and `m ∣ N`, then `σ` is `N`-shift-periodic. -/
lemma IsShiftPeriodic.of_dvd {σ : Equiv.Perm ℤ} {m N : ℤ} (h : IsShiftPeriodic σ m)
    (hd : m ∣ N) : IsShiftPeriodic σ N := by
  intro n
  obtain ⟨k, rfl⟩ := hd
  induction' k using Int.induction_on with k ih k ih
  · grind
  · rw [mul_add, mul_one, ← add_assoc, h, ih, add_assoc]
  · specialize h (n + m * (-k - 1))
    ring_nf at *
    linarith

/-- The lcm of `|2|, |3|, ..., |k|`, which equals `lcm(2, 3, ..., k)` for `k ≥ 2`. -/
def lcmN (k : ℤ) : ℕ :=
  (Finset.Icc 2 k).lcm Int.natAbs

/-- The least common multiple of `|2|, |3|, …, |k|` is positive. -/
lemma lcmN_pos : 0 < lcmN k :=
  Nat.pos_of_ne_zero (mt Finset.lcm_eq_zero_iff.mp (by aesop))

/-- `lcmN k` (the `ℤ` formulation) is nonzero. -/
instance : NeZero (lcmN k) :=
  NeZero.mk (mt Finset.lcm_eq_zero_iff.mp (by aesop))

/-- Every element of `CT(k)` is `lcm(2, …, k)`-shift-periodic. -/
lemma CT_isShiftPeriodic {k : ℤ} {σ : Equiv.Perm ℤ} (hσ : σ ∈ CT k) :
    IsShiftPeriodic σ ↑(lcmN k) := by
  unfold CT at hσ
  induction hσ using Subgroup.iSup_induction'
  · rename_i i σ hσ
    by_cases hi : i ∈ Set.Icc 2 k <;> simp_all
    · refine' Subgroup.closure_induction (fun x hx ↦ _) _ _ _ hσ
      · rcases hx with ⟨⟨r₁, r₂⟩, ⟨hr₁, hr₂⟩, rfl⟩
        refine' IsShiftPeriodic.of_dvd _ _
        exact i
        · exact τ_isShiftPeriodic
        · exact
            Int.dvd_natCast.mpr (Finset.dvd_lcm (Finset.mem_Icc.mpr ⟨by linarith, by linarith⟩))
      · exact isShiftPeriodic_one _
      · exact fun x y hx hy a a_1 ↦ IsShiftPeriodic.mul a a_1
      · exact fun x hx a ↦ IsShiftPeriodic.inv a
    · exact isShiftPeriodic_one ↑(lcmN k)
  · exact isShiftPeriodic_one ↑(lcmN k)
  · expose_names
    exact IsShiftPeriodic.mul h h_1

end ShiftPeriodic

section ReductionHom

/-!
## Reduction Homomorphism
We construct a group homomorphism from `CT(k)` to `Perm(Fin N)` by reducing each
shift-periodic permutation to its action on a single period `{0, ..., N-1}`.
-/

/-- For a shift-periodic permutation, `σ(n) mod N = σ(n mod N) mod N`. -/
lemma shiftPeriodic_emod_eq {σ : Equiv.Perm ℤ} {N : ℤ} (hper : IsShiftPeriodic σ N) (n : ℤ) :
    σ n % N = σ (n % N) % N := by
  conv_lhs => rw [← Int.emod_add_mul_ediv n N]
  induction' n / N using Int.induction_on with n ihn n ihn
  · grind
  · rw [mul_add, mul_one, ← add_assoc, hper, Int.add_emod, ihn]
    norm_num
  · specialize hper (‹_› % N + N * (-n - 1))
    ring_nf at *
    simp_all only [Int.add_emod_left]

/-- The element `n mod N : Fin N` corresponding to an integer `n` and a positive bound `N`. -/
def toFinN (n : ℤ) (N : ℕ) (hN : 0 < N) : Fin N :=
  ⟨(n % ↑N).toNat, by
    rw [Int.toNat_lt (Int.emod_nonneg n (by omega))]
    exact Int.emod_lt_of_pos n (by omega)⟩

/-- The integer underlying `toFinN n N hN` is `n % N`. -/
lemma toFinN_val (n : ℤ) (N : ℕ) (hN : 0 < N) : ((toFinN n N hN).val : ℤ) = n % ↑N := by
  simp only [toFinN, Int.toNat_of_nonneg (Int.emod_nonneg n (by omega : (↑N : ℤ) ≠ 0))]

/-- Restriction of an `N`-shift-periodic permutation of `ℤ` to a permutation of `Fin N`,
obtained by reducing modulo `N`. -/
noncomputable def shiftPeriodicReduce (σ : Equiv.Perm ℤ) (N : ℕ) (hN : 0 < N)
    (hper : IsShiftPeriodic σ ↑N) : Equiv.Perm (Fin N) where
  toFun n := toFinN (σ ↑n.val) N hN
  invFun n := toFinN (σ⁻¹ ↑n.val) N hN
  left_inv := by
    intro n
    have h_mod : σ⁻¹ (σ n.val) % N = n.val % N := by norm_num at *
    have h_mod : σ⁻¹ (σ n.val % N) % N = n.val % N := by
      convert h_mod using 1
      rw [← shiftPeriodic_emod_eq]
      exact IsShiftPeriodic.inv hper
    simp_all [Fin.ext_iff, toFinN]
    rw [max_eq_left (Int.emod_nonneg _ (by positivity))]
    simp_all [Int.emod_eq_of_lt]
  right_inv := by
    intro n
    simp only [toFinN, Equiv.Perm.coe_inv, Int.ofNat_toNat, ne_eq, Int.natCast_eq_zero, hN.ne',
      not_false_eq_true, Int.emod_nonneg, sup_of_le_left]
    have h_periodic : σ (σ⁻¹ n % ↑N) % ↑N = n % ↑N := by
      rw [← shiftPeriodic_emod_eq]
      · simp_all only [Equiv.Perm.coe_inv, Equiv.apply_symm_apply]
      · assumption
    simp_all [Int.emod_eq_of_lt]

/-- Pointwise formula: `(shiftPeriodicReduce σ N _ _) n = σ n % N` (cast to `ℤ`). -/
lemma shiftPeriodicReduce_apply (σ : Equiv.Perm ℤ) (N : ℕ) (hN : 0 < N)
    (hper : IsShiftPeriodic σ ↑N) (n : Fin N) :
    (shiftPeriodicReduce σ N hN hper n : ℤ) = σ ↑n.val % ↑N := by
  convert toFinN_val _ _ _
  linarith

/-- The reduction of the identity is the identity. -/
lemma shiftPeriodicReduce_one (N : ℕ) (hN : 0 < N) :
    shiftPeriodicReduce 1 N hN (isShiftPeriodic_one ↑N) = 1 := by
  convert Equiv.ext ?_
  intro x
  convert Fin.ext ?_
  convert shiftPeriodicReduce_apply 1 N hN (by tauto) x using 1
  norm_num [Fin.val_add, Fin.val_mul, Int.emod_eq_of_lt, hN]

/-- The reduction is a multiplicative homomorphism. -/
lemma shiftPeriodicReduce_mul (σ₁ σ₂ : Equiv.Perm ℤ) (N : ℕ) (hN : 0 < N)
    (h₁ : IsShiftPeriodic σ₁ ↑N) (h₂ : IsShiftPeriodic σ₂ ↑N) :
    shiftPeriodicReduce (σ₁ * σ₂) N hN (h₁.mul h₂) =
      shiftPeriodicReduce σ₁ N hN h₁ * shiftPeriodicReduce σ₂ N hN h₂ :=
  by grind only [Equiv.Perm.mul_apply, shiftPeriodicReduce_apply, shiftPeriodic_emod_eq]

/-- The reduction homomorphism from `CT(k)` to `Perm(Fin N)`, where `N = lcm(2,...,k)`. -/
noncomputable def reductionHom (k : ℤ) : CT k →* Equiv.Perm (Fin (lcmN k)) where
  toFun σ := shiftPeriodicReduce σ.val (lcmN k) lcmN_pos (CT_isShiftPeriodic σ.property)
  map_one' := by
    simp only [Subgroup.coe_one]
    exact shiftPeriodicReduce_one _ _
  map_mul' := by
    intro ⟨σ₁, hσ₁⟩ ⟨σ₂, hσ₂⟩
    simp only [Subgroup.coe_mul]
    convert shiftPeriodicReduce_mul σ₁ σ₂ (lcmN k) lcmN_pos (CT_isShiftPeriodic hσ₁)
      (CT_isShiftPeriodic hσ₂)

end ReductionHom

variable {r₁ r₂ k : ℤ}

/-- A generator `τ_{r₁(m), r₂(m)}` with `0 ≤ r₁, r₂ < m` and `m ∣ N` preserves
`{0, …, N - 1}`. -/
lemma τ_preserves_range (hr₁ : 0 ≤ r₁ ∧ r₁ < k) (hr₂ : 0 ≤ r₂ ∧ r₂ < k) {N : ℤ} (hdvd : k ∣ N)
    {n : ℤ} (hn : 0 ≤ n ∧ n < N) : 0 ≤ τ k r₁ r₂ n ∧ τ k r₁ r₂ n < N := by
  unfold τ
  split_ifs <;> simp_all [τFun]
  split_ifs <;> constructor <;> try linarith
  · obtain ⟨a, ha⟩ := ‹k ∣ n - r₁›
    nlinarith [show a ≥ 0 by nlinarith]
  · obtain ⟨m, hm⟩ := ‹k ∣ n - r₁›
    obtain ⟨a, ha⟩ := hdvd
    nlinarith [show m < a by nlinarith]
  · obtain ⟨m, hm⟩ := ‹k ∣ n - r₂›
    nlinarith [show m ≥ 0 by nlinarith]
  · obtain ⟨m, hm⟩ := ‹k ∣ n - r₂›
    obtain ⟨n, hn⟩ := hdvd
    nlinarith [show m < n by nlinarith]

/-- Elements of `CT(k)` map `{0, …, N - 1}` to `{0, …, N - 1}`, where `N = lcm(2, …, k)`.

This follows because each generator `τ_{r₁(m), r₂(m)}` with `m ∣ N` and `0 ≤ r₁, r₂ < m`
maps `r₁ + t·m` to `r₂ + t·m`, and both are in `{0, …, N - 1}` for `t ∈ {0, …, N/m - 1}`. -/
lemma CT_preserves_range {k : ℤ} {σ : Equiv.Perm ℤ} (hσ : σ ∈ CT k) {n : ℤ}
    (hn : 0 ≤ n ∧ n < ↑(lcmN k)) : 0 ≤ σ n ∧ σ n < ↑(lcmN k) := by
  have h_induction :
    ∀ (i : ℤ) (hi : 2 ≤ i ∧ i ≤ k),
      ∀ (r₁ r₂ : ℤ),
        r₁ ∈ Set.Ico 0 i ∧ r₂ ∈ Set.Ico 0 i →
          ∀ (n : ℤ), 0 ≤ n ∧ n < ↑(lcmN k) → 0 ≤ τ i r₁ r₂ n ∧ τ i r₁ r₂ n < ↑(lcmN k) := by
    intros i hi r₁ r₂ hr n hn
    apply τ_preserves_range
    · simp_all only [Set.mem_Ico, and_self]
    · simp_all only [Set.mem_Ico, and_self]
    · exact Int.dvd_natCast.mpr (Finset.dvd_lcm (Finset.mem_Icc.mpr ⟨by linarith, by linarith⟩))
    · exact hn
  have h_induction :
    ∀ (i : ℤ) (hi : 2 ≤ i ∧ i ≤ k),
      ∀
        σ ∈
          Subgroup.closure
            (Set.image (fun p : ℤ × ℤ ↦ τ i p.1 p.2) (Set.Ico 0 i ×ˢ Set.Ico 0 i)),
        ∀ n : ℤ, 0 ≤ n ∧ n < ↑(lcmN k) → 0 ≤ σ n ∧ σ n < ↑(lcmN k) := by
    intro i hi σ hσ n hn
    induction' hσ using Subgroup.closure_induction with σ hσ ih generalizing n
    · rcases hσ with ⟨⟨r₁, r₂⟩, ⟨hr₁, hr₂⟩, rfl⟩
      exact h_induction i hi r₁ r₂ ⟨hr₁, hr₂⟩ n hn
    · simp_all only [Set.mem_Ico, and_imp, Equiv.Perm.coe_one, id_eq, and_self]
    · simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Equiv.Perm.coe_mul,
        Function.comp_apply, and_self]
    · rename_i σ hσ ih
      have := ih (σ⁻¹ n)
      simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Equiv.Perm.coe_inv,
        Equiv.apply_symm_apply, and_self, implies_true]
      have h_inv : ∀ n : ℤ, 0 ≤ n ∧ n < ↑(lcmN k) → ∃ m : ℤ, 0 ≤ m ∧ m < ↑(lcmN k) ∧ σ m = n := by
        intros n hn
        have h_inv : Finset.image σ (Finset.Ico 0 ↑(lcmN k)) = Finset.Ico 0 ↑(lcmN k) := by
          exact
            Finset.eq_of_subset_of_card_le
              (Finset.image_subset_iff.mpr fun x hx ↦
                Finset.mem_Ico.mpr <|
                  ih x (Finset.mem_Ico.mp hx |>.1) (Finset.mem_Ico.mp hx |>.2))
              (by rw [Finset.card_image_of_injective _ σ.injective])
        replace h_inv := Finset.ext_iff.mp h_inv n
        aesop
      obtain ⟨m, hm₁, hm₂, hm₃⟩ := h_inv n hn
      subst hm₃
      simp_all only [and_imp, and_self, Equiv.symm_apply_apply]
  have h_induction :
    ∀ (σ : Equiv.Perm ℤ),
      σ ∈
          ⨆ i ∈ Set.Icc 2 k,
            Subgroup.closure
              (Set.image (fun p : ℤ × ℤ ↦ τ i p.1 p.2) (Set.Ico 0 i ×ˢ Set.Ico 0 i)) →
        ∀ n : ℤ, 0 ≤ n ∧ n < ↑(lcmN k) → 0 ≤ σ n ∧ σ n < ↑(lcmN k) := by
    intro σ hσ
    induction hσ using Subgroup.iSup_induction'
    · rename_i i σ hi
      by_cases hi' : 2 ≤ i ∧ i ≤ k
      · simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Set.mem_Icc, and_self, iSup_pos]
        exact h_induction i hi'.1 hi'.2 σ hi
      · simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Set.mem_Icc, not_false_eq_true,
          iSup_neg, Subgroup.mem_bot, not_and, not_le, Equiv.Perm.coe_one, id_eq, and_self,
          implies_true]
    · intro n_1 a
      simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Equiv.Perm.coe_one, id_eq, and_self]
    · intro n_1 a_2
      simp_all only [Set.mem_Ico, and_imp, Set.image_prod, Set.mem_Icc, Equiv.Perm.coe_mul,
        Function.comp_apply, and_self]
  exact h_induction σ hσ n hn

/--
A shift-periodic permutation that preserves `{0,...,N-1}` is determined by its restriction to
`{0,...,N-1}`. -/
lemma shiftPeriodic_ext {σ₁ σ₂ : Equiv.Perm ℤ} {N : ℤ} (hN : 0 < N) (hp₁ : IsShiftPeriodic σ₁ N)
    (hp₂ : IsShiftPeriodic σ₂ N) (h_eq : ∀ n : ℤ, 0 ≤ n → n < N → σ₁ n = σ₂ n) : σ₁ = σ₂ := by
  ext n
  set n' := n % N
  set k := n / N
  have h_n : n = n' + k * N := by rw [Int.emod_add_ediv_mul]
  have h_sigma1 : σ₁ n = σ₁ n' + k * N := by
    have h_sigma1 : ∀ m : ℤ, σ₁ (m + k * N) = σ₁ m + k * N := by
      intro m
      induction' k using Int.induction_on with k ih k ih
      · norm_num
      · rw [add_mul, one_mul, ← add_assoc, hp₁, ih, add_assoc]
      · have := hp₁ (m + (-k - 1) * N)
        ring_nf at *
        linarith
    rw [← h_sigma1, ← h_n]
  have h_sigma2 : σ₂ n = σ₂ n' + k * N := by
    rw [h_n]
    refine' Int.induction_on k _ _ _ <;> norm_num at *
    · intro i hi
      rw [add_mul, one_mul, ← add_assoc, hp₂, hi]
      ring
    · intro i hi
      specialize hp₂ (n' + (-i - 1) * N)
      ring_nf at *
      linarith
  rw [h_sigma1, h_sigma2, h_eq n' (Int.emod_nonneg _ hN.ne') (Int.emod_lt_of_pos _ hN)]

/-- The reduction homomorphism is injective: an `N`-shift-periodic permutation that acts
as the identity on `{0, …, N - 1}` must be the identity on all of `ℤ`. -/
lemma reductionHom_injective {k : ℤ} : Function.Injective (reductionHom k) := by
  intro σ₁ σ₂ h_eq
  have h_periodic : IsShiftPeriodic σ₁.val ↑(lcmN k) ∧ IsShiftPeriodic σ₂.val ↑(lcmN k) := by
    exact ⟨CT_isShiftPeriodic σ₁.2, CT_isShiftPeriodic σ₂.2⟩
  have h_eq_on_period : ∀ n : Fin (lcmN k), σ₁.val n.val = σ₂.val n.val := by
    have h_eq_on_period : ∀ n : Fin (lcmN k), σ₁.val n.val % lcmN k = σ₂.val n.val % lcmN k := by
      intro n
      have := congr_arg (fun f ↦ f n) h_eq
      simp [reductionHom] at this
      convert this using 1
      grind only [= Lean.Grind.toInt_fin, shiftPeriodicReduce_apply]
    intro n
    have h_eq_mod : σ₁.val n.val % lcmN k = σ₂.val n.val % lcmN k := h_eq_on_period n
    have h_eq_range :
      0 ≤ σ₁.val n.val ∧ σ₁.val n.val < lcmN k ∧ 0 ≤ σ₂.val n.val ∧ σ₂.val n.val < lcmN k := by
      have h_eq_range :
        ∀ σ : Equiv.Perm ℤ, σ ∈ CT k → ∀ n : ℤ, 0 ≤ n → n < lcmN k → 0 ≤ σ n ∧ σ n < lcmN k := by
        intro σ hσ n hn hn'
        by_cases hk : 2 ≤ k
        · exact CT_preserves_range hσ ⟨hn, hn'⟩
        · have h_empty : CT k = ⊥ := by
            unfold CT
            simp_all only [not_le, Set.Icc_eq_empty, Set.mem_empty_iff_false, not_false_eq_true,
              iSup_neg, iSup_bot]
          simp_all only [Subgroup.mem_bot, not_le, Equiv.Perm.coe_one, id_eq, and_self]
      exact
        ⟨h_eq_range _ σ₁.2 _ (Nat.cast_nonneg _) (Nat.cast_lt.mpr n.2) |>.1,
          h_eq_range _ σ₁.2 _ (Nat.cast_nonneg _) (Nat.cast_lt.mpr n.2) |>.2,
          h_eq_range _ σ₂.2 _ (Nat.cast_nonneg _) (Nat.cast_lt.mpr n.2) |>.1,
          h_eq_range _ σ₂.2 _ (Nat.cast_nonneg _) (Nat.cast_lt.mpr n.2) |>.2⟩
    rw [Int.emod_eq_of_lt, Int.emod_eq_of_lt] at h_eq_mod <;> linarith
  refine' Subtype.ext <| shiftPeriodic_ext _ h_periodic.1 h_periodic.2 _
  · exact_mod_cast lcmN_pos
  · exact fun n hn₁ hn₂ ↦ by
      simpa using
        h_eq_on_period ⟨n.toNat, by linarith [Int.toNat_of_nonneg hn₁]⟩ |> fun h ↦ by
          simpa [Int.toNat_of_nonneg hn₁] using h

/-! ### Surjectivity of `reductionHom 4` (base case for the `ℤ` formulation) -/

/-- The class transposition `τ k r₁ r₂` belongs to `CT' k` whenever `0 ≤ r₁, r₂ < k`. -/
lemma τ_mem_CT'_surj {k r₁ r₂ : ℤ} (hr₁ : r₁ ∈ Set.Ico 0 k) (hr₂ : r₂ ∈ Set.Ico 0 k) :
    τ k r₁ r₂ ∈ CT' k :=
  Subgroup.subset_closure ⟨(r₁, r₂), Set.mk_mem_prod hr₁ hr₂, rfl⟩

/-- A class transposition with `2 ≤ k ≤ 4` belongs to `CT 4`. -/
lemma τ_mem_CT4_surj {k r₁ r₂ : ℤ} (hk : k ∈ Set.Icc 2 4) (hr₁ : r₁ ∈ Set.Ico 0 k)
    (hr₂ : r₂ ∈ Set.Ico 0 k) : τ k r₁ r₂ ∈ CT 4 :=
  (le_iSup₂ (f := fun i (_ : i ∈ Set.Icc 2 (4 : ℤ)) ↦ CT' i) k hk) (τ_mem_CT'_surj hr₁ hr₂)

/-- The product `τ(3, 0, 1) * τ(3, 0, 2) * τ(4, 0, 3)` lies in `CT 4`; its image under
`reductionHom 4` is a `12`-cycle on `Fin 12`. -/
lemma σ_mem_surj : τ 3 0 1 * τ 3 0 2 * τ 4 0 3 ∈ CT 4 :=
  (CT 4).mul_mem
    ((CT 4).mul_mem (τ_mem_CT4_surj (by norm_num) (by norm_num) (by norm_num))
      (τ_mem_CT4_surj (by norm_num) (by norm_num) (by norm_num)))
    (τ_mem_CT4_surj (by norm_num) (by norm_num) (by norm_num))

/-- The element `(τ(3, 0, 1) * τ(4, 0, 1))³` lies in `CT 4`; its reduction equals `swap(6, 7)`. -/
lemma t_mem_surj : (τ 3 0 1 * τ 4 0 1) ^ 3 ∈ CT 4 :=
  (CT 4).pow_mem
    ((CT 4).mul_mem (τ_mem_CT4_surj (by norm_num) (by norm_num) (by norm_num))
      (τ_mem_CT4_surj (by norm_num) (by norm_num) (by norm_num)))
    3

/-- `lcmN 4 = 12` (the `ℤ` formulation). -/
lemma lcmN4_surj : lcmN 4 = 12 := by native_decide

/-- `reductionHom 4 σ` is a cycle, where `σ = τ(3, 0, 1) * τ(3, 0, 2) * τ(4, 0, 3)`. -/
lemma rh_σ_isCycle_surj :
    (reductionHom 4 ⟨τ 3 0 1 * τ 3 0 2 * τ 4 0 3, σ_mem_surj⟩).IsCycle := by
  exact Equiv.Perm.card_cycleType_eq_one.mp rfl

/-- The support of `reductionHom 4 σ` is the entire `Fin 12`. -/
lemma rh_σ_support_surj :
    (reductionHom 4 ⟨τ 3 0 1 * τ 3 0 2 * τ 4 0 3, σ_mem_surj⟩).support = Finset.univ := by
  simp +decide

/-- The fifth power of `reductionHom 4 σ` sends `6` to `7` on `Fin 12`. -/
lemma rh_σ_pow5_at_6_surj :
    ((reductionHom 4 ⟨τ 3 0 1 * τ 3 0 2 * τ 4 0 3, σ_mem_surj⟩) ^ 5)
        (lcmN4_surj ▸ (⟨6, by omega⟩ : Fin 12)) =
      lcmN4_surj ▸ (⟨7, by omega⟩ : Fin 12) := by
  unfold reductionHom
  unfold shiftPeriodicReduce
  aesop

/-- `reductionHom 4 t = swap(6, 7)` on `Fin 12`, where `t = (τ(3, 0, 1) * τ(4, 0, 1))³`. -/
lemma rh_t_eq_swap_surj :
    reductionHom 4 ⟨(τ 3 0 1 * τ 4 0 1) ^ 3, t_mem_surj⟩ =
      Equiv.swap (lcmN4_surj ▸ (⟨6, by omega⟩ : Fin 12))
        (lcmN4_surj ▸ (⟨7, by omega⟩ : Fin 12)) :=
  by decide +kernel

/-- Base case of the surjectivity induction: `reductionHom 4` is surjective onto `Perm (Fin 12)`. -/
lemma reductionHom_surjective_base : Function.Surjective (reductionHom 4) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff]
  have hσ_range : reductionHom 4 ⟨_, σ_mem_surj⟩ ∈ MonoidHom.range (reductionHom 4) :=
    ⟨⟨_, σ_mem_surj⟩, rfl⟩
  have ht_range : reductionHom 4 ⟨_, t_mem_surj⟩ ∈ MonoidHom.range (reductionHom 4) :=
    ⟨⟨_, t_mem_surj⟩, rfl⟩
  have h5_coprime : Nat.Coprime 5 (Fintype.card (Fin (lcmN 4))) := by
    simp [lcmN4_surj]
    native_decide
  have hclosure :=
    Equiv.Perm.closure_cycle_coprime_swap h5_coprime rh_σ_isCycle_surj rh_σ_support_surj
      (lcmN4_surj ▸ (⟨6, by omega⟩ : Fin 12))
  rw [rh_σ_pow5_at_6_surj] at hclosure
  rw [← hclosure, Subgroup.closure_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · exact hσ_range
  · rw [← rh_t_eq_swap_surj]
    exact ht_range

/-- The chain of subgroups `CT k ≤ CT (k + 1)` (more generators allowed at the next step). -/
lemma CT_mono {k : ℤ} : CT k ≤ CT (k + 1) := by
  refine' iSup₂_le fun i hi ↦ le_iSup₂_of_le i _ _
  · grind
  · rfl

/-- When `lcmN (k + 1) = lcmN k`, the reduction homomorphism at level `k + 1` agrees with the
one at level `k` (modulo the natural identification of the underlying `Fin` types). -/
lemma reductionHom_eq_of_lcmN_eq {k : ℤ} (heq : lcmN (k + 1) = lcmN k)
    (σ : Equiv.Perm ℤ) (hσ : σ ∈ CT k) :
    (finCongr heq).permCongr (reductionHom (k + 1) ⟨σ, CT_mono hσ⟩) = reductionHom k ⟨σ, hσ⟩ := by
  unfold reductionHom
  unfold shiftPeriodicReduce
  simp [Equiv.Perm.ext_iff, Fin.ext_iff, toFinN]
  aesop

/-- Inductive step for surjectivity when `lcmN (k + 1) = lcmN k`: surjectivity at level `k`
transfers to level `k + 1`. -/
lemma reductionHom_surjective_of_lcmN_eq {k : ℤ} (_hk : 4 ≤ k)
    (heq : lcmN (k + 1) = lcmN k) (hsurj : Function.Surjective (reductionHom k)) :
    Function.Surjective (reductionHom (k + 1)) := by
  intro σ
  set σ' := (finCongr heq).permCongr σ
  obtain ⟨⟨τ, hτ_mem⟩, hτ_eq⟩ := hsurj σ'
  refine ⟨⟨τ, CT_mono hτ_mem⟩, ?_⟩
  apply (finCongr heq).permCongr.injective
  rw [reductionHom_eq_of_lcmN_eq heq τ hτ_mem]
  exact hτ_eq

/-! ### Bridge between the ℤ formulation and the ℕ formulation from 21_8_6 -/

/-- The `lcmN` from the `ℕ` formulation equals our `lcmN` for `k ≥ 2`. -/
lemma lcmN_eq_lcmN_nat {k : ℤ} (hk : 2 ≤ k) : lcmN k = _root_.lcmN k.toNat := by
  refine' Nat.dvd_antisymm _ _
  · refine' Finset.lcm_dvd fun x hx ↦ _
    refine' Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨_, _⟩)
    · rcases x with (_ | _ | x) <;> norm_num at *
      linarith
    · cases x <;> cases k <;> norm_num at *
      linarith
      · grind
      · tauto
      · tauto
  · refine' Finset.lcm_dvd fun x hx ↦ _
    by_cases hx2 : x = 1
    · aesop
    · refine' Finset.dvd_lcm (show (x : ℤ) ∈ Finset.Icc 2 k from _) |> fun h ↦ dvd_trans _ h
      · norm_num
      · grind +qlia

/-! ### Bridge: generator correspondence between ℤ and ℕ formulations -/

/-- τ d r₁ r₂ is in CT k when d ∈ [2, k] and r₁, r₂ ∈ [0, d). -/
lemma τ_mem_CT_bridge {k d r₁ r₂ : ℤ} (hd : d ∈ Set.Icc 2 k) (hr₁ : r₁ ∈ Set.Ico 0 d)
    (hr₂ : r₂ ∈ Set.Ico 0 d) : τ d r₁ r₂ ∈ CT k :=
  (le_iSup₂ (f := fun i (_ : i ∈ Set.Icc 2 k) ↦ CT' i) d hd) (τ_mem_CT'_surj hr₁ hr₂)

/-- When `0 ≤ r₁ < d`, `0 ≤ r₂ < d`, `0 ≤ n`, and `0 < d`:
`τFun d r₁ r₂ n = n / d * d +
  (if n % d = r₁ then r₂ else if n % d = r₂ then r₁ else n % d)`. -/
lemma τFun_eq_div_mod {d r₁ r₂ n : ℤ} (hr₁ : 0 ≤ r₁) (hr₁' : r₁ < d) (hr₂ : 0 ≤ r₂)
    (hr₂' : r₂ < d) (hd : 0 < d) :
    τFun d r₁ r₂ n =
      n / d * d + (if n % d = r₁ then r₂ else if n % d = r₂ then r₁ else n % d) := by
  unfold τFun
  split_ifs <;> simp_all +decide [dvd_sub_comm]
  any_goals rw [Int.ediv_mul_add_emod]
  all_goals
    rw [Int.dvd_iff_emod_eq_zero] at *
    simp_all +decide [Int.sub_emod]
  · linarith [Int.emod_add_mul_ediv n d]
  · simp_all +decide [Int.emod_eq_of_lt]
    obtain ⟨k, hk⟩ := ‹d ∣ r₁ - r₂›
    exact False.elim <| ‹¬r₂ = r₁› <| by nlinarith [show k = 0 by nlinarith]
  · rw [Int.dvd_iff_emod_eq_zero] at *
    simp_all +decide [Int.sub_emod, Int.emod_eq_of_lt]
    exact
      False.elim <|
        ‹¬n % d = r₁› <| by
          obtain ⟨k, hk⟩ := ‹d ∣ r₁ - n % d›
          nlinarith [show k = 0 by
              nlinarith [Int.emod_nonneg n hd.ne', Int.emod_lt_of_pos n hd]]
  · linarith [Int.emod_add_mul_ediv n d]
  · simp_all +decide [Int.emod_eq_of_lt]
    exact
      False.elim <|
        ‹¬n % d = r₂› <| by
          obtain ⟨k, hk⟩ := ‹d ∣ r₂ - n % d›
          nlinarith [show k = 0 by
              nlinarith [Int.emod_nonneg n hd.ne', Int.emod_lt_of_pos n hd]]

/-- The reduction of `τ d r₁ r₂` matches the `lcmRepeat` value.
For `n : Fin (lcmN k)`, the reduction gives
`n.val / d * d + swap(r₁, r₂)(n.val % d)`. -/
lemma reductionHom_τ_apply_val {k d r₁ r₂ : ℤ} (hd : d ∈ Set.Icc 2 k)
    (hr₁ : r₁ ∈ Set.Ico 0 d) (hr₂ : r₂ ∈ Set.Ico 0 d) (n : Fin (lcmN k)) :
    ((reductionHom k ⟨τ d r₁ r₂, τ_mem_CT_bridge hd hr₁ hr₂⟩ n).val : ℤ) =
      ↑n.val / d * d +
        (if ↑n.val % d = r₁ then r₂ else if ↑n.val % d = r₂ then r₁ else ↑n.val % d) := by
  have h_periodic : IsShiftPeriodic (τ d r₁ r₂) d := by exact τ_isShiftPeriodic
  have h_mod : (τ d r₁ r₂ n.val : ℤ) % lcmN k = (τ d r₁ r₂ n.val : ℤ) := by
    have h_mod : 0 ≤ (τ d r₁ r₂ n.val : ℤ) ∧ (τ d r₁ r₂ n.val : ℤ) < lcmN k := by
      apply CT_preserves_range
      · exact τ_mem_CT_bridge hd hr₁ hr₂
      · exact ⟨Nat.cast_nonneg _, Nat.cast_lt.mpr n.2⟩
    rw [Int.emod_eq_of_lt] <;> linarith
  have h_mod : (τ d r₁ r₂ n.val : ℤ) = τFun d r₁ r₂ n.val := by
    by_cases h : d ∣ (r₂ - r₁) <;> simp_all +decide [τ]
    obtain ⟨m, hm⟩ := h
    norm_num [show r₂ = r₁ by nlinarith [show m = 0 by nlinarith]] at *
    unfold τFun
    aesop
  convert h_mod using 1
  · convert shiftPeriodicReduce_apply _ _ _ _ _ using 1
    · aesop
    · exact CT_isShiftPeriodic (τ_mem_CT_bridge hd hr₁ hr₂)
  · rw [τFun_eq_div_mod]
    all_goals linarith [hr₁.1, hr₁.2, hr₂.1, hr₂.2, hd.1, hd.2]

/-- The reduction of `τ d r₁ r₂` equals the `lcmRepeat` of `swap(r₁, r₂)` under `finCongr`.
This is the key bridge between the `ℤ` and `ℕ` formulations. -/
lemma reductionHom_τ_eq_lcmRepeat {k : ℤ} (hk : 2 ≤ k) (d : ℕ) (hd2 : 2 ≤ d)
    (hdk : d ≤ k.toNat) (r₁ r₂ : Fin d) :
    (finCongr (lcmN_eq_lcmN_nat hk)).permCongr
        (reductionHom k
          ⟨τ ↑d ↑r₁.val ↑r₂.val,
            τ_mem_CT_bridge (show (↑d : ℤ) ∈ Set.Icc 2 k by constructor <;> omega)
              (show (↑r₁.val : ℤ) ∈ Set.Ico 0 ↑d by constructor <;> omega)
              (show (↑r₂.val : ℤ) ∈ Set.Ico 0 ↑d by constructor <;> omega)⟩) =
      (Equiv.swap r₁ r₂).lcmRepeat hdk (by omega) := by
  ext n
  convert
    reductionHom_τ_apply_val (show (d : ℤ) ∈ Set.Icc 2 k from ⟨mod_cast hd2, mod_cast by omega⟩)
      (show (r₁ : ℤ) ∈ Set.Ico 0 (d : ℤ) from
        ⟨by linarith [Fin.is_lt r₁], by linarith [Fin.is_lt r₁]⟩)
      (show (r₂ : ℤ) ∈ Set.Ico 0 (d : ℤ) from
        ⟨by linarith [Fin.is_lt r₂], by linarith [Fin.is_lt r₂]⟩)
      (finCongr (_ : _) n) using 1
  swap
  exact Eq.symm (lcmN_eq_lcmN_nat hk)
  simp [lcmRepeat_val]
  grind +revert

/-- The image of `reductionHom k` contains all generators of the finite `CT(k)`.
Combined with `CT = ⊤`, this gives surjectivity. -/
lemma reductionHom_surjective_of_CT_fin_eq_top {k : ℤ} (hk : 4 ≤ k)
    (h_top : _root_.CT k.toNat = ⊤) : Function.Surjective (reductionHom k) := by
  set heq : lcmN k = _root_.lcmN k.toNat := lcmN_eq_lcmN_nat (by omega : 2 ≤ k)
  set φ := (finCongr heq).permCongr ∘ reductionHom k
  have h_range : _root_.CT k.toNat ≤ Subgroup.map (MonoidHom.mk' φ (by aesop)) ⊤ := by
    all_goals generalize_proofs at *
    refine' iSup_le _
    intro i
    unfold _root_.CT'
    simp
    split_ifs <;> simp_all +decide [Subgroup.closure_le]
    rintro _ ⟨⟨r₁, r₂⟩, rfl⟩
    use ⟨τ i.val r₁.val r₂.val, τ_mem_CT_bridge (by
            exact ⟨by linarith [Finset.mem_Icc.mp i.2], by
              linarith [Finset.mem_Icc.mp i.2, Int.toNat_of_nonneg (by linarith : 0 ≤ k)]⟩)
          (by exact ⟨Nat.cast_nonneg _, Nat.cast_lt.mpr r₁.2⟩)
          (by exact ⟨Nat.cast_nonneg _, Nat.cast_lt.mpr r₂.2⟩)⟩
    convert reductionHom_τ_eq_lcmRepeat (by omega : 2 ≤ k) i.val (by linarith [Finset.mem_Icc.mp i.2])
      (by linarith [Finset.mem_Icc.mp i.2]) r₁ r₂ using 1
  intro x
  specialize h_range (x := (finCongr heq).permCongr x)
  aesop

/-- Inductive step for surjectivity when `lcmN (k + 1) ≠ lcmN k`: bootstrap from the finite
`ℕ`-formulation theorem `kourovka_21_8_alt` at level `k.toNat + 1`. -/
lemma reductionHom_surjective_of_lcmN_ne {k : ℤ} (hk : 4 ≤ k) :
    Function.Surjective (reductionHom (k + 1)) := by
  refine reductionHom_surjective_of_CT_fin_eq_top (by omega) ?_
  rw [show (k + 1).toNat = k.toNat + 1 from by omega]
  exact _root_.kourovka_21_8_alt _ (by omega)

/-- The reduction homomorphism `CT k → Perm (Fin (lcmN k))` is surjective for every `k ≥ 4`. -/
lemma reductionHom_surjective {k : ℤ} (hk : 4 ≤ k) : Function.Surjective (reductionHom k) := by
  induction k, hk using Int.le_induction with
  | base => exact reductionHom_surjective_base
  | succ k hk ih =>
    by_cases heq : lcmN (k + 1) = lcmN k
    · exact reductionHom_surjective_of_lcmN_eq hk heq ih
    · exact reductionHom_surjective_of_lcmN_ne hk

/-- **Kourovka Notebook Problem 21.8**.
For every integer `k ≥ 4`, the group `CT k` of class transpositions of moduli `2, 3, …, k` is
isomorphic to the symmetric group on `N` letters, where `N = lcm(2, 3, …, k)`.
The isomorphism is realised by the reduction homomorphism that restricts each shift-periodic
permutation of `ℤ` to a single period. -/
theorem kourovka_21_8 {k : ℤ} (hk : 4 ≤ k) :
    Nonempty (CT k ≃* Equiv.Perm (Fin ((Finset.Icc 2 k).lcm Int.natAbs))) :=
  ⟨MulEquiv.ofBijective (reductionHom k) ⟨reductionHom_injective, reductionHom_surjective hk⟩⟩

end Kourovka21_8
