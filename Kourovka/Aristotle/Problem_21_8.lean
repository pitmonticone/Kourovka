/-!
# Kourovka Notebook Problem 21.8

## Problem statement

For integers `0 ≤ r < m`, define the residue class `r(m) = {r + k·m | k ∈ ℤ}`.
For disjoint classes `r₁(m₁) ∩ r₂(m₂) = ∅`, the *class transposition*
`τ_{r₁(m₁), r₂(m₂)}` is the involution interchanging `r₁ + t·m₁` and `r₂ + t·m₂`
for each integer `t`, fixing everything else. Let `CT(ℤ)` be the group generated by
all class transpositions.

Let `CT_k` be the subgroup generated by `τ_{r₁(k), r₂(k)}` for `0 ≤ r₁ ≠ r₂ < k`.
Since `τ_{r₁(k), r₂(k)}` permutes residue classes mod `k`, `CT_k ≅ S_k`.
Let `CT_{(k)} = ⟨CT_2, CT_3, …, CT_k⟩`.

**Question**: Is it true that for `k > 3`, `CT_{(k)} ≅ S_N` where `N = lcm(2, 3, …, k)`?

**Answer**: Yes. For `k ≥ 4`, the group `CT(k)` generated by all class transpositions
of moduli `2, 3, …, k` equals the full symmetric group `Sym (Fin N)` where
`N = lcm(1, 2, …, k)`.

## Setup

A **class transposition** of modulus `d` swapping residues `r₁, r₂ ∈ Fin d` is the
permutation of `Fin N` defined by `n ↦ swap(r₁, r₂)(n % d) + (n / d) · d`.
We call this `(Equiv.swap r₁ r₂).lcmRepeat`.

The subgroup `CT'(d, k)` is generated by all class transpositions of modulus `d`,
and `CT(k) = ⟨CT'(2, k), …, CT'(k, k)⟩`.

## Proof strategy

1. **Base case** (`k = 4`): Verified computationally using `native_decide`. We produce
   `swap(6,7)` via `(ct3_01 * ct4_01)³`, then conjugate to get all adjacent
   transpositions on `Fin 12`.

2. **Inductive step**: Two cases based on whether `lcmN (k+1) = lcmN k`:
   - If equal: `CT(k+1) ⊇ CT(k)` on the same space, so `CT(k+1) = ⊤`.
   - If not equal (i.e., `k+1` is a prime power): we show `CT(k+1)` is transitive and
     primitive, contains a `3`-cycle, and apply Jordan's theorem to conclude
     `Alt(N) ≤ CT(k+1)`. An odd-signature generator then gives `CT(k+1) = ⊤`.

## Note

The result requires `k ≥ 4`; for `k = 3`, `CT(3)` has `120` elements `≠ 720 = |S₆|`.
-/

/-- `lcmN k = lcm(1, 2, 3, …, k)`. -/
def lcmN (k : ℕ) : ℕ :=
  (Finset.Ioc 0 k).lcm id

/-- The least common multiple of `1, 2, …, k` is positive. -/
lemma lcmN_pos {k : ℕ} : 0 < lcmN k :=
  Nat.pos_of_ne_zero (mt Finset.lcm_eq_zero_iff.mp (by grind))

/-- `lcmN k` is nonzero. -/
instance {k : ℕ} : NeZero (lcmN k) :=
  NeZero.mk (mt Finset.lcm_eq_zero_iff.mp (by aesop))

/-- `lcmN 0 = 1` (the empty product/`lcm`). -/
lemma lcmN_zero : lcmN 0 = 1 := rfl

/-- `lcmN 1 = 1`. -/
lemma lcmN_one : lcmN 1 = 1 := rfl

/-- For `0 < d ≤ k`, `d` divides `lcmN k = lcm(1, 2, …, k)`. -/
lemma dvd_lcmN {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) : d ∣ lcmN k :=
  Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨hd', hd⟩)

namespace Equiv

/-- Column-major equivalence: `Fin l × Fin d ≃ Fin (d * l)` mapping `(j, i) ↦ j * d + i`. -/
def finProdFinEquivCol (d l : ℕ) : Fin l × Fin d ≃ Fin (d * l) :=
  finProdFinEquiv.trans (finCongr (Nat.mul_comm l d))

/-- Extend a permutation of `Fin d` to `Fin (d * l)` using class transposition ordering.
Element `n` is mapped to `σ(n % d) + (n / d) * d`. -/
def Perm.classRepeat {d : ℕ} (_hd : 0 < d) (σ : Perm (Fin d)) (l : ℕ) : Perm (Fin (d * l)) :=
  (finProdFinEquivCol d l).permCongr
    { toFun := fun p ↦ (p.1, σ p.2)
      invFun := fun p ↦ (p.1, σ.symm p.2)
      left_inv := by
        intro ⟨_, _⟩
        simp
      right_inv := by
        intro ⟨_, _⟩
        simp }

/-- Extend a permutation of `Fin d` to `Fin (lcmN k)` using class transposition repetition. -/
def Perm.lcmRepeat {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (σ : Perm (Fin d)) :
    Perm (Fin (lcmN k)) :=
  (finCongr (Nat.mul_div_eq_iff_dvd.mpr (dvd_lcmN hd hd'))).permCongr
    (σ.classRepeat hd' (lcmN k / d))

end Equiv

/-- The subgroup of `Perm (Fin (lcmN k))` generated by class transpositions of modulus `d`. -/
def CT' (d k : ℕ) : Subgroup (Equiv.Perm (Fin (lcmN k))) :=
  if hd : d ≤ k ∧ 0 < d then
    Subgroup.closure
      (Set.range (fun (⟨r₁, r₂⟩ : Fin d × Fin d) ↦ (Equiv.swap r₁ r₂).lcmRepeat hd.1 hd.2))
  else ⊥

/-- `CT k = ⟨CT'(2, k), CT'(3, k), …, CT'(k, k)⟩` is the subgroup of `Perm (Fin (lcmN k))`
generated by class transpositions of all moduli `2 ≤ d ≤ k`. -/
def CT (k : ℕ) : Subgroup (Equiv.Perm (Fin (lcmN k))) :=
  ⨆ i : Finset.Icc 2 k, CT' i k

/-! ## General permutation group infrastructure -/

/-- If a subgroup of `Perm (Fin (n+1))` contains all adjacent transpositions, it is `⊤`. -/
theorem eq_top_of_adj_swap_mem {n : ℕ} (G : Subgroup (Equiv.Perm (Fin (n + 1))))
    (h : ∀ i : Fin n, Equiv.swap (Fin.castSucc i) (Fin.succ i) ∈ G) : G = ⊤ := by
  rw [eq_top_iff]
  intro σ _
  have h_gen := Equiv.Perm.mclosure_swap_castSucc_succ n
  rw [eq_top_iff] at h_gen
  exact Submonoid.closure_induction (fun x hx ↦ by obtain ⟨i, rfl⟩ := hx; exact h i) G.one_mem
    (fun _ _ _ _ hx hy ↦ G.mul_mem hx hy) (h_gen (Submonoid.mem_top σ))

/-- A generator `(swap r₁ r₂).lcmRepeat` is in `CT' d k`. -/
lemma lcmRepeat_mem_CT' {d k : ℕ} (hd : d ≤ k) (hd' : 0 < d) (r₁ r₂ : Fin d) :
    (Equiv.swap r₁ r₂).lcmRepeat hd hd' ∈ CT' d k := by
  simp only [CT', hd, hd', and_self, ↓reduceDIte]
  exact Subgroup.subset_closure ⟨⟨r₁, r₂⟩, rfl⟩

/-- A generator of `CT' d k` is in `CT k` when `2 ≤ d ≤ k`. -/
lemma lcmRepeat_mem_CT {d k : ℕ} (hd : d ≤ k) (hd' : 0 < d) (hd2 : 2 ≤ d) (r₁ r₂ : Fin d) :
    (Equiv.swap r₁ r₂).lcmRepeat hd hd' ∈ CT k :=
  Subgroup.mem_iSup_of_mem ⟨d, Finset.mem_Icc.mpr ⟨hd2, hd⟩⟩ (lcmRepeat_mem_CT' hd hd' r₁ r₂)

/-! ## Base case: `CT 4 = ⊤`

We produce `swap(6,7)` via `(ct3_01 * ct4_01)³`, then conjugate to get all adjacent
