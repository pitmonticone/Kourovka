  simp [*, Nat.add_mod]
  rw [← Nat.mod_add_div n (k + 1), hp]
  norm_num [Nat.add_mod, Nat.mul_mod]
  simp [mul_comm]
  rcases k with (_ | _ | k) <;> simp_all +arith +decide [Nat.mod_eq_of_lt]

