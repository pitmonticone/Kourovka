-/

/-- Shorthand for an element of `Fin (lcmN 4) = Fin 12` from a proven-small natural. -/
abbrev F (n : ℕ) (h : n < lcmN 4 := by native_decide) : Fin (lcmN 4) :=
  ⟨n, h⟩

/-- The class transposition swapping residues `0` and `1` modulo `2`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct2_01 : Equiv.Perm (Fin (lcmN 4)) :=
  (Equiv.swap (0 : Fin 2) 1).lcmRepeat (by omega) (by omega)

/-- The class transposition swapping residues `0` and `1` modulo `3`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct3_01 : Equiv.Perm (Fin (lcmN 4)) :=
  (Equiv.swap (0 : Fin 3) 1).lcmRepeat (by omega) (by omega)

/-- The class transposition swapping residues `0` and `2` modulo `3`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct3_02 : Equiv.Perm (Fin (lcmN 4)) :=
  (Equiv.swap (0 : Fin 3) 2).lcmRepeat (by omega) (by omega)

/-- The class transposition swapping residues `1` and `2` modulo `3`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct3_12 : Equiv.Perm (Fin (lcmN 4)) :=
  (Equiv.swap (1 : Fin 3) 2).lcmRepeat (by omega) (by omega)

/-- The class transposition swapping residues `0` and `1` modulo `4`,
lifted to `Fin (lcmN 4) = Fin 12`. -/
def ct4_01 : Equiv.Perm (Fin (lcmN 4)) :=
