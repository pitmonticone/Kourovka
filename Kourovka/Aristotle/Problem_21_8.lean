        apply orbit4_period3 hk σ₀ τ₀ hσ₀ hτ₀ m h_eq hl
  · interval_cases _ : (m : ℕ) % (k + 1) <;> simp_all +decide
    · convert orbit1_period3 hk σ₀ τ₀ hσ₀ hτ₀ m ‹_› hl using 1
    · apply orbit2_period3 hk σ₀ τ₀ hσ₀ hτ₀ m ‹_› ‹_›

