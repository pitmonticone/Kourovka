    (τ₀ n).val % lcmN k = n.val % lcmN k := by
  simp_all +decide [Equiv.swap_apply_def]
  simp [Fin.ext_iff]
  split_ifs <;> simp_all +decide
  rcases x : lcmN k with (_ | _ | _ | k) <;> simp_all +arith +decide [Nat.mod_eq_of_lt]

