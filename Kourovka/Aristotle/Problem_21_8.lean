/-- Conjugation closure: if `g, s ∈ CT 4`, then `g * s * g ∈ CT 4`. -/
lemma mem_cj {g s : Equiv.Perm (Fin (lcmN 4))} (hg : g ∈ CT 4) (hs : s ∈ CT 4) :
    g * s * g ∈ CT 4 :=
  (CT 4).mul_mem ((CT 4).mul_mem hg hs) hg

/-- Key identity: `(ct3_01 * ct4_01)³ = swap(F 6, F 7)`, verified by `native_decide`.
This produces our seed adjacent transposition for the base case. -/
lemma s67_eq :
    ct3_01 * ct4_01 * ct3_01 * ct4_01 * ct3_01 * ct4_01 = Equiv.swap (F 6) (F 7) := by
  native_decide

/-- The transposition `swap(6, 7)` lies in `CT 4`. -/
lemma mem_s67 : Equiv.swap (F 6) (F 7) ∈ CT 4 := by
  rw [← s67_eq]
  exact
    (CT 4).mul_mem
      ((CT 4).mul_mem
        ((CT 4).mul_mem ((CT 4).mul_mem ((CT 4).mul_mem mem_ct3_01 mem_ct4_01) mem_ct3_01)
          mem_ct4_01)
        mem_ct3_01)
      mem_ct4_01

lemma swap_56_eq : ct4_13 * Equiv.swap (F 6) (F 7) * ct4_13 = Equiv.swap (F 5) (F 6) :=
  by native_decide

lemma mem_swap_56 : Equiv.swap (F 5) (F 6) ∈ CT 4 :=
  swap_56_eq ▸ mem_cj mem_ct4_13 mem_s67

lemma swap_78_eq : ct3_02 * Equiv.swap (F 6) (F 7) * ct3_02 = Equiv.swap (F 7) (F 8) :=
  by native_decide

lemma mem_swap_78 : Equiv.swap (F 7) (F 8) ∈ CT 4 :=
  swap_78_eq ▸ mem_cj mem_ct3_02 mem_s67

lemma swap_45_eq : ct4_02 * Equiv.swap (F 5) (F 6) * ct4_02 = Equiv.swap (F 4) (F 5) :=
  by native_decide

lemma mem_swap_45 : Equiv.swap (F 4) (F 5) ∈ CT 4 :=
  swap_45_eq ▸ mem_cj mem_ct4_02 mem_swap_56

lemma swap_34_eq :
    ct4_02 * (ct3_01 * (ct4_02 * Equiv.swap (F 6) (F 7) * ct4_02) * ct3_01) * ct4_02 =
      Equiv.swap (F 3) (F 4) :=
  by native_decide

lemma mem_swap_34 : Equiv.swap (F 3) (F 4) ∈ CT 4 :=
  swap_34_eq ▸ mem_cj mem_ct4_02 (mem_cj mem_ct3_01 (mem_cj mem_ct4_02 mem_s67))

lemma swap_89_eq :
    ct3_12 * (ct4_01 * (ct3_02 * Equiv.swap (F 6) (F 7) * ct3_02) * ct4_01) * ct3_12 =
      Equiv.swap (F 8) (F 9) :=
  by native_decide

lemma mem_swap_89 : Equiv.swap (F 8) (F 9) ∈ CT 4 :=
  swap_89_eq ▸ mem_cj mem_ct3_12 (mem_cj mem_ct4_01 (mem_cj mem_ct3_02 mem_s67))

lemma swap_910_eq :
    ct2_01 *
          (ct3_02 * (ct2_01 * (ct3_02 * Equiv.swap (F 6) (F 7) * ct3_02) * ct2_01) * ct3_02) *
        ct2_01 =
      Equiv.swap (F 9) (F 10) :=
  by native_decide

lemma mem_swap_910 : Equiv.swap (F 9) (F 10) ∈ CT 4 :=
  swap_910_eq ▸
    mem_cj mem_ct2_01 (mem_cj mem_ct3_02 (mem_cj mem_ct2_01 (mem_cj mem_ct3_02 mem_s67)))

lemma swap_1011_eq :
    ct4_02 * (ct3_02 * (ct2_01 * (ct3_02 * Equiv.swap (F 6) (F 7) * ct3_02) * ct2_01) * ct3_02) *
      ct4_02 = Equiv.swap (F 10) (F 11) := by
  native_decide

lemma mem_swap_1011 : Equiv.swap (F 10) (F 11) ∈ CT 4 :=
  swap_1011_eq ▸
    mem_cj mem_ct4_02 (mem_cj mem_ct3_02 (mem_cj mem_ct2_01 (mem_cj mem_ct3_02 mem_s67)))

lemma swap_01_eq :
    ct4_03 *
          (ct3_01 *
              (ct4_03 * (ct3_01 * (ct4_03 * Equiv.swap (F 6) (F 7) * ct4_03) * ct3_01) *
                ct4_03) *
            ct3_01) *
        ct4_03 =
      Equiv.swap (F 0) (F 1) :=
  by native_decide

lemma mem_swap_01 : Equiv.swap (F 0) (F 1) ∈ CT 4 :=
  swap_01_eq ▸
    mem_cj mem_ct4_03
      (mem_cj mem_ct3_01 (mem_cj mem_ct4_03 (mem_cj mem_ct3_01 (mem_cj mem_ct4_03 mem_s67))))

lemma swap_12_eq :
    ct4_23 *
          (ct3_01 *
              (ct4_03 * (ct3_01 * (ct4_03 * Equiv.swap (F 6) (F 7) * ct4_03) * ct3_01) *
                ct4_03) *
            ct3_01) *
        ct4_23 =
      Equiv.swap (F 1) (F 2) :=
  by native_decide

lemma mem_swap_12 : Equiv.swap (F 1) (F 2) ∈ CT 4 :=
  swap_12_eq ▸
    mem_cj mem_ct4_23
      (mem_cj mem_ct3_01 (mem_cj mem_ct4_03 (mem_cj mem_ct3_01 (mem_cj mem_ct4_03 mem_s67))))

lemma swap_23_eq :
    ct3_01 *
          (ct4_03 *
              (ct2_01 * (ct3_01 * (ct4_02 * Equiv.swap (F 6) (F 7) * ct4_02) * ct3_01) *
                ct2_01) *
            ct4_03) *
        ct3_01 =
      Equiv.swap (F 2) (F 3) :=
  by native_decide

lemma mem_swap_23 : Equiv.swap (F 2) (F 3) ∈ CT 4 :=
  swap_23_eq ▸
    mem_cj mem_ct3_01
      (mem_cj mem_ct4_03 (mem_cj mem_ct2_01 (mem_cj mem_ct3_01 (mem_cj mem_ct4_02 mem_s67))))

/-- All transpositions on `Fin (lcmN 4)` are in `CT 4`. -/
lemma all_swap_mem (a b : Fin (lcmN 4)) : Equiv.swap a b ∈ CT 4 := by
  have h_top : ⊤ = CT 4 := by
    have h_adjacent : ∀ i : Fin 11, Equiv.swap (Fin.castSucc i) (Fin.succ i) ∈ CT 4 := by
      simp_all +decide [Fin.forall_fin_succ]
      exact
        ⟨mem_swap_01, mem_swap_12, mem_swap_23, mem_swap_34, mem_swap_45, mem_swap_56, mem_s67,
          mem_swap_78, mem_swap_89, mem_swap_910, mem_swap_1011⟩
    convert eq_top_of_adj_swap_mem (CT 4) h_adjacent |> Eq.symm
  exact h_top ▸ Subgroup.mem_top _

/-- `CT 4 = ⊤` on `Perm (Fin (lcmN 4))`. -/
theorem CT4_eq_top : CT 4 = ⊤ := by
  rw [eq_top_iff]
  intro σ _
  induction σ using Equiv.Perm.swap_induction_on with
  | one => exact (CT 4).one_mem
  | swap_mul τ a b _hab hτ => exact (CT 4).mul_mem (all_swap_mem a b) (hτ trivial)

/-! ## Induction step

For the general case, we use induction on `k`:
- When `k+1 ∣ lcmN k`, we have `lcmN(k+1) = lcmN k` and `CT(k+1) ⊇ CT(k)` on the
  same space (all generators are preserved plus new ones from `CT'(k+1)`).
- When `k+1 ∤ lcmN k`, the space grows and a genuine inductive argument is needed.
  This case only occurs when `k+1` is a prime power.
-/

/-- When `lcmN (k + 1) = lcmN k`, the `CT k` generators are also `CT (k + 1)` generators
on the same space, so `CT k = ⊤ → CT (k + 1) = ⊤`. -/
lemma CT_le_succ_of_lcmN_eq {k : ℕ} (hk : k ≥ 2) (heq : lcmN (k + 1) = lcmN k) :
    CT k = ⊤ → CT (k + 1) = ⊤ := by
  refine fun h ↦ le_antisymm ?_ ?_ <;> simp_all +decide [SetLike.le_def]
  intro g hg
  rintro ⟨S, rfl⟩
  simp_all +decide [upperBounds]
  contrapose! h
  refine' ne_of_lt (lt_of_le_of_lt (iSup_le _) _)
  exact
    Subgroup.comap
      (Equiv.permCongr (finCongr heq.symm) |> MonoidHom.mk' <| by
        intros
        rfl)
      S
  · intro i
    specialize h
    have :=
      h.1 (i : ℕ) (Finset.mem_Icc.mp i.2 |>.1)
        (Finset.mem_Icc.mp i.2 |>.2.trans (Nat.le_succ _)) rfl
    simp_all +decide [CT']
    split_ifs at * <;> simp_all +decide [Subgroup.closure_le, Set.range_subset_iff]
    · intro a b
      specialize this a b
      convert this using 1
    · linarith
  · simp_all +decide [lt_top_iff_ne_top, Subgroup.eq_top_iff']
    exact ⟨(finCongr heq.symm).symm.permCongr g, by simpa [Equiv.Perm.ext_iff] using h.2⟩

/-! ## Structural lemmas about `lcmN` growth -/

/-- `lcmN(k+1) = lcm(lcmN(k), k+1)` -/
lemma lcmN_succ (k : ℕ) : lcmN (k + 1) = Nat.lcm (lcmN k) (k + 1) := by
  unfold lcmN
  rw [show Finset.Ioc 0 (k + 1) = Finset.Ioc 0 k ∪ {k + 1} from ?_, Finset.lcm_union] <;> aesop
  grind

/-- `lcmN k ∣ lcmN (k+1)` -/
lemma lcmN_dvd_succ' (k : ℕ) : lcmN k ∣ lcmN (k + 1) :=
  lcmN_succ k ▸ Nat.dvd_lcm_left _ _

/-- If `lcmN(k+1) ≠ lcmN(k)`, then `k+1 ∤ lcmN(k)`. -/
lemma not_dvd_lcmN_of_ne {k : ℕ} (hne : lcmN (k + 1) ≠ lcmN k) : ¬(k + 1 ∣ lcmN k) := by
  contrapose! hne
  rw [lcmN_succ, Nat.lcm, Nat.gcd_eq_right hne, Nat.mul_div_cancel _ (Nat.succ_pos _)]

/-- If `k + 1` is not a prime power, then `k + 1 ∣ lcmN k` (for k ≥ 1). -/
lemma dvd_lcmN_of_not_isPrimePow {k : ℕ} (hk : k ≥ 1) (hnpp : ¬IsPrimePow (k + 1)) :
    (k + 1) ∣ lcmN k := by
  have h_factor : ∀ p ∈ Nat.primeFactors (k + 1), p ^ (Nat.factorization (k + 1) p) ∣ lcmN k := by
    intros p hp
    have h_lt : p ^ (Nat.factorization (k + 1) p) < k + 1 := by
      refine Nat.lt_of_le_of_ne ?_ ?_
      · exact Nat.le_of_dvd (Nat.succ_pos _) (Nat.ordProj_dvd _ _)
      · exact fun h ↦
          hnpp <|
            h.symm ▸
              (Nat.prime_of_mem_primeFactors hp |>.isPrimePow.pow
                (Nat.ne_of_gt <| Nat.pos_of_ne_zero <| Finsupp.mem_support_iff.mp hp))
    exact dvd_lcmN (Nat.le_of_lt_succ h_lt) (pow_pos (Nat.pos_of_mem_primeFactors hp) _)
  have h_factor_prod :
    (∏ p ∈ Nat.primeFactors (k + 1), p ^ (Nat.factorization (k + 1) p)) ∣ lcmN k := by
    convert Finset.lcm_dvd h_factor using 1
    have h_lcm_prod :
      ∀ {S : Finset ℕ} {f : ℕ → ℕ},
        (∀ p ∈ S, Nat.Prime p) →
          (∀ p q : ℕ, p ∈ S → q ∈ S → p ≠ q → Nat.gcd (p ^ f p) (q ^ f q) = 1) →
            Finset.lcm S (fun p ↦ p ^ f p) = Finset.prod S (fun p ↦ p ^ f p) := by
      intros S f hf_prime hf_coprime
      induction S using Finset.induction <;>
        simp_all +decide [Finset.prod_insert, Finset.lcm_insert]
      exact
        Nat.Coprime.lcm_eq_mul <|
          Nat.Coprime.prod_right fun p hp ↦ hf_coprime _ _ (Or.inl rfl) (Or.inr hp) (by aesop)
    rw [h_lcm_prod (fun p' hp' ↦ Nat.prime_of_mem_primeFactors hp')
        (fun p' q' hp' hq' hpq' ↦
          Nat.coprime_pow_primes _ _ (Nat.prime_of_mem_primeFactors hp')
            (Nat.prime_of_mem_primeFactors hq') hpq')]
  convert h_factor_prod using 1
  exact Eq.symm (Nat.factorization_prod_pow_eq_self (by positivity))

/-- When `lcmN(k+1) ≠ lcmN(k)` and `k ≥ 1`, `k+1` is a prime power. -/
lemma isPrimePow_of_lcmN_ne {k : ℕ} (hk : k ≥ 1) (hne : lcmN (k + 1) ≠ lcmN k) :
    IsPrimePow (k + 1) := by
  by_contra h
  exact
    hne (by
        rw [lcmN_succ]
        exact Nat.lcm_eq_left (dvd_lcmN_of_not_isPrimePow hk h))

/-- When `lcmN` grows, there exists a prime `p` with `lcmN(k+1) = p * lcmN(k)`. -/
lemma lcmN_growth {k : ℕ} (hk : k ≥ 1) (hne : lcmN (k + 1) ≠ lcmN k) :
    ∃ p : ℕ, Nat.Prime p ∧ p ∣ (k + 1) ∧ lcmN (k + 1) = p * lcmN k := by
  -- Since lcmN(k+1) ≠ lcmN(k), k+1 is a prime power by isPrimePow_of_lcmN_ne.
  obtain ⟨p, m, hp, hm⟩ : ∃ p m : ℕ, Nat.Prime p ∧ k + 1 = p ^ m := by
    have := isPrimePow_of_lcmN_ne hk hne
    rw [isPrimePow_nat_iff] at this
    grind
  have h_val : Nat.factorization (lcmN k) p < m := by
    have h_val : ¬(p ^ m ∣ lcmN k) := by
      contrapose! hne
      rw [lcmN_succ, hm, Nat.lcm]
      rw [Nat.gcd_eq_right hne, Nat.mul_div_cancel _ (pow_pos hp.pos _)]
    exact lt_of_not_ge fun h ↦ h_val <| Nat.dvd_trans (pow_dvd_pow _ h) <| Nat.ordProj_dvd _ _
  have h_val_cases : Nat.factorization (lcmN k) p = if m = 1 then 0 else m - 1 := by
    split_ifs with h
    · aesop
    · -- Since `m ≥ 2`, we have `p ^ (m - 1) ≤ k`.
      have h_p_m_minus_1_le_k : p ^ (m - 1) ≤ k := by
        rcases m with (_ | _ | m) <;> simp_all +decide [pow_succ']
        nlinarith [hp.two_le, pow_pos hp.pos m]
      have h_p_m_minus_1_div_lcmN : p ^ (m - 1) ∣ lcmN k := by
        exact
          Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨Nat.one_le_pow _ _ hp.pos, h_p_m_minus_1_le_k⟩)
      exact
        le_antisymm (Nat.le_sub_one_of_lt h_val)
          (Nat.le_of_not_lt fun h ↦
            absurd (dvd_trans (pow_dvd_pow _ h) h_p_m_minus_1_div_lcmN)
              (Nat.pow_succ_factorization_not_dvd (by linarith [show 0 < lcmN k from lcmN_pos])
                hp))
  have h_lcmN_succ : lcmN (k + 1) = Nat.lcm (lcmN k) (p ^ m) := by rw [← hm, lcmN_succ]
  rcases m with (_ | _ | m) <;> simp_all +decide [Nat.lcm]
  · simp_all +decide [Nat.factorization_eq_zero_iff]
    exact
      ⟨p, hp, dvd_rfl,
        Nat.div_eq_of_eq_mul_left (Nat.gcd_pos_of_pos_left _ (Nat.pos_of_ne_zero (by aesop))) (by
            rw [Nat.Coprime.gcd_eq_one
                (Nat.Coprime.symm <|
                  hp.coprime_iff_not_dvd.mpr <|
                    h_val_cases.resolve_right <| by
                      exact
                        ne_of_gt <|
                          Nat.pos_of_ne_zero <| by
                            exact mt Finset.lcm_eq_zero_iff.mp <| by aesop)]
            ring)⟩
  · -- Since `p ^ (m + 1) ∣ lcmN k`, we have `gcd(lcmN k, p ^ (m + 2)) = p ^ (m + 1)`.
    have h_gcd : Nat.gcd (lcmN k) (p ^ (m + 2)) = p ^ (m + 1) := by
      have h_gcd : Nat.factorization (Nat.gcd (lcmN k) (p ^ (m + 2))) p = m + 1 := by
        rw [Nat.factorization_gcd] <;> aesop
      have h_gcd : Nat.gcd (lcmN k) (p ^ (m + 2)) ∣ p ^ (m + 2) := by
        exact Nat.gcd_dvd_right _ _
      rw [Nat.dvd_prime_pow hp] at h_gcd
      aesop
    exact
      ⟨p, hp, dvd_pow_self _ (by linarith),
        Nat.div_eq_of_eq_mul_left (Nat.gcd_pos_of_pos_right _ (pow_pos hp.pos _)) (by
            rw [h_gcd]
            ring)⟩

/-- For `k ≥ 4`, `k + 1 ≤ lcmN k`. -/
lemma succ_le_lcmN' {k : ℕ} (hk : k ≥ 4) : k + 1 ≤ lcmN k := by
  -- For `k ≥ 7`, both `k` and `k - 1` divide `lcmN k`, and `gcd(k, k - 1) = 1` for
  -- consecutive integers, so `lcm(k - 1, k) = k(k - 1)` divides `lcmN k`.
  have h_lcm_div : k * (k - 1) ∣ lcmN k := by
    have h_div : k ∣ lcmN k ∧ (k - 1) ∣ lcmN k := by
      exact
        ⟨Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨by linarith, by linarith⟩),
          Finset.dvd_lcm
            (Finset.mem_Ioc.mpr
              ⟨Nat.sub_pos_of_lt (by linarith), Nat.sub_le_of_le_add (by linarith)⟩)⟩
    convert Nat.lcm_dvd h_div.1 h_div.2 using 1
    exact Eq.symm (Nat.Coprime.lcm_eq_mul <| by cases k <;> simp_all +decide)
  nlinarith [Nat.le_of_dvd
      (Nat.pos_of_ne_zero (by
          unfold lcmN
          aesop))
      h_lcm_div,
    Nat.sub_add_cancel (by linarith : 1 ≤ k)]

/-! ## Growth case infrastructure -/

/-- If all 3-cycles on `Fin M` are in `G`, then `alternatingGroup ≤ G`. -/
lemma alt_le_of_three_cycles_mem {M : ℕ} (G : Subgroup (Equiv.Perm (Fin M)))
    (h : ∀ c : Equiv.Perm (Fin M), c.IsThreeCycle → c ∈ G) : alternatingGroup (Fin M) ≤ G := by
  rw [← Equiv.Perm.closure_three_cycles_eq_alternating]
  exact (Subgroup.closure_le G).mpr (fun c hc ↦ h c hc)

/-- If `Alt(n) ≤ G` and `G` has an odd permutation, then `G = ⊤`. -/
lemma eq_top_of_alt_le_of_odd_perm {M : ℕ} (G : Subgroup (Equiv.Perm (Fin M)))
    (hAlt : alternatingGroup (Fin M) ≤ G) (hOdd : ∃ σ ∈ G, Equiv.Perm.sign σ = -1) : G = ⊤ := by
  rw [eq_top_iff]
  intro σ _
  by_cases hs : Equiv.Perm.sign σ = 1
  · exact hAlt (Equiv.Perm.mem_alternatingGroup.mpr hs)
  · obtain ⟨τ, hτG, hτsign⟩ := hOdd
    have hsig : Equiv.Perm.sign σ = -1 := by
      rcases Int.units_eq_one_or σ.sign with h | h <;> simp_all
    have hprod : Equiv.Perm.sign (σ * τ⁻¹) = 1 := by simp [map_mul, map_inv, hτsign, hsig]
    rw [show σ = (σ * τ⁻¹) * τ from by group]
    exact G.mul_mem (hAlt (Equiv.Perm.mem_alternatingGroup.mpr hprod)) hτG

/-- The sign of `classRepeat` of a swap is `(-1)^l`. -/
lemma sign_classRepeat_swap {d : ℕ} (hd : 0 < d) (r₁ r₂ : Fin d) (hr : r₁ ≠ r₂) (l : ℕ) :
    Equiv.Perm.sign ((Equiv.swap r₁ r₂).classRepeat hd l) = (-1) ^ l := by
  norm_num [Equiv.Perm.classRepeat]
  have h_prod_sign :
    Equiv.Perm.sign (Equiv.prodCongrRight (fun i : Fin l ↦ Equiv.swap r₁ r₂)) = (-1) ^ l := by
    erw [Equiv.Perm.sign_prodCongrRight]
    aesop
  convert h_prod_sign using 1

/-- The sign of `lcmRepeat` of a swap is `(-1)^(lcmN k / d)`. -/
lemma sign_lcmRepeat_swap {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (r₁ r₂ : Fin d) (hr : r₁ ≠ r₂) :
    Equiv.Perm.sign ((Equiv.swap r₁ r₂).lcmRepeat hd hd') = (-1) ^ (lcmN k / d) := by
  unfold Equiv.Perm.lcmRepeat
  rw [Equiv.Perm.sign_permCongr]
  exact sign_classRepeat_swap hd' r₁ r₂ hr _

/-- For `k ≥ 4`, there exists `d` with `2 ≤ d ≤ k+1` and `lcmN(k+1)/d` odd. -/
lemma exists_odd_divisor (k : ℕ) (hk : k ≥ 4) :
    ∃ d : ℕ, 2 ≤ d ∧ d ≤ k + 1 ∧ 0 < d ∧ Odd (lcmN (k + 1) / d) := by
  set d := 2 ^ (Nat.log 2 (k + 1)) with hd_def
  refine'
    ⟨d, Nat.le_self_pow (Nat.ne_of_gt (Nat.log_pos one_lt_two (by linarith))) _,
      Nat.pow_log_le_self 2 (by linarith), pow_pos (by decide) _, _⟩
  have hv₂ : Nat.factorization (lcmN (k + 1)) 2 = Nat.log 2 (k + 1) := by
    have hv₂_lcmN :
      ∀ {S : Finset ℕ},
        (∀ s ∈ S, 0 < s) →
          Nat.factorization (Finset.lcm S id) 2 =
            Finset.sup S (fun s ↦ Nat.factorization s 2) := by
      intros S hS_pos
      induction' S using Finset.induction with s S ih
      · native_decide +revert
      · have h_lcm_factorization :
          ∀ {a b : ℕ}, 0 < a → 0 < b → Nat.factorization (Nat.lcm a b) 2 =
            max (Nat.factorization a 2) (Nat.factorization b 2) := by
          intros a b ha hb
          rw [Nat.factorization_lcm] <;> aesop
        simp_all +decide [Finset.lcm_insert]
        convert h_lcm_factorization hS_pos.1 (Nat.pos_of_ne_zero _) using 1
        · grind
        · simp_all +decide [Finset.lcm_eq_zero_iff]
          exact fun h ↦ by simpa using hS_pos.2 0 h
    convert hv₂_lcmN _ using 1
    · refine' le_antisymm _ _ <;> norm_num
      · refine'
          le_trans _
            (Finset.le_sup <|
              Finset.mem_Ioc.mpr
                ⟨Nat.one_le_pow _ _ zero_lt_two, Nat.pow_log_le_self 2 <| by linarith⟩)
        norm_num
      · exact fun b hb hb' ↦
          Nat.le_log_of_pow_le (by decide)
            (Nat.le_trans (Nat.le_of_dvd hb (Nat.ordProj_dvd _ _)) hb')
    · exact fun s hs ↦ Finset.mem_Ioc.mp hs |>.1
  obtain ⟨m, hm⟩ : ∃ m, lcmN (k + 1) = 2 ^ (Nat.log 2 (k + 1)) * m ∧ Odd m := by
    rw [← hv₂]
    exact
      ⟨_, Eq.symm (Nat.mul_div_cancel' (Nat.ordProj_dvd _ _)), by
        exact
          Nat.odd_iff.mpr
            (Nat.mod_two_ne_zero.mp fun h ↦
              absurd (Nat.dvd_of_mod_eq_zero h)
                (Nat.not_dvd_ordCompl (by norm_num) (by
                    exact
                      Nat.ne_of_gt
                        (Nat.pos_of_ne_zero (mt Finset.lcm_eq_zero_iff.mp (by aesop))))))⟩
  aesop

/-- In the growth case, CT(k+1) contains an odd permutation. -/
lemma CT_growth_odd_perm {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) :
    ∃ σ ∈ CT (k + 1), Equiv.Perm.sign σ = -1 := by
  obtain ⟨d, hd2, hdle, hdpos, hodd⟩ := exists_odd_divisor k hk
  refine
    ⟨(Equiv.swap (⟨0, by omega⟩ : Fin d) ⟨1, by omega⟩).lcmRepeat hdle hdpos,
      lcmRepeat_mem_CT hdle hdpos hd2 _ _, ?_⟩
  rw [sign_lcmRepeat_swap hdle hdpos _ _ (by simp [Fin.ext_iff])]
  exact Odd.neg_one_pow hodd

/-! ### Synchronized permutations -/

/-- `classRepeat` is a monoid homomorphism. -/
lemma classRepeat_mul {d : ℕ} (hd : 0 < d) (σ τ : Equiv.Perm (Fin d)) (l : ℕ) :
    (σ * τ).classRepeat hd l = σ.classRepeat hd l * τ.classRepeat hd l := by
  unfold Equiv.Perm.classRepeat
  simp [Equiv.Perm.ext_iff, Equiv.Perm.mul_def]

/-- `classRepeat` maps `1` to `1`. -/
lemma classRepeat_one {d : ℕ} (hd : 0 < d) (l : ℕ) :
    (1 : Equiv.Perm (Fin d)).classRepeat hd l = 1 := by
  ext ⟨j, i⟩
  simp [Equiv.Perm.classRepeat]

/-- `lcmRepeat` preserves multiplication. -/
lemma lcmRepeat_mul {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (σ τ : Equiv.Perm (Fin d)) :
    (σ * τ).lcmRepeat hd hd' = σ.lcmRepeat hd hd' * τ.lcmRepeat hd hd' := by
  unfold Equiv.Perm.lcmRepeat
  simp [Equiv.permCongr_mul, classRepeat_mul]

/-- Conjugation preserves subgroup membership. -/
lemma conj_three_cycle_mem {n : ℕ} (G : Subgroup (Equiv.Perm (Fin n))) (c : Equiv.Perm (Fin n))
    (hc : c ∈ G) (g : Equiv.Perm (Fin n)) (hg : g ∈ G) : g * c * g⁻¹ ∈ G :=
  G.mul_mem (G.mul_mem hg hc) (G.inv_mem hg)

set_option maxHeartbeats 800000 in

/-- If `G` acts 3-transitively and contains a 3-cycle, then `G` contains all 3-cycles. -/
lemma all_three_cycles_of_three_transitive {n : ℕ} (G : Subgroup (Equiv.Perm (Fin n)))
    (h_three_cycle : ∃ c ∈ G, Equiv.Perm.IsThreeCycle c)
    (h_three_trans :
      ∀ (a b c a' b' c' : Fin n),
        a ≠ b →
          b ≠ c →
            a ≠ c → a' ≠ b' → b' ≠ c' → a' ≠ c' → ∃ g ∈ G, g a = a' ∧ g b = b' ∧ g c = c') :
    ∀ c : Equiv.Perm (Fin n), c.IsThreeCycle → c ∈ G := by
  obtain ⟨c, hc, hc'⟩ := h_three_cycle
  intro c' hc'
  obtain ⟨a, b, d, habd⟩ :
    ∃ a b d : Fin n, a ≠ b ∧ b ≠ d ∧ a ≠ d ∧ c a = b ∧ c b = d ∧ c d = a := by
    simp_all +decide [Equiv.Perm.IsThreeCycle]
    have := Equiv.Perm.sum_cycleType c
    simp_all +decide
    rw [eq_comm, Finset.card_eq_three] at this
    obtain ⟨x, y, z, hxy, hxz, hyz, h⟩ := this
    simp_all +decide [Finset.ext_iff]
    have := Equiv.Perm.ext_iff.mp (show c ^ 3 = 1 from ?_) x
    simp_all +decide [pow_succ]
    · grind
    · have := Equiv.Perm.lcm_cycleType c
      aesop
  obtain ⟨x, y, z, hxyz⟩ :
    ∃ x y z : Fin n, x ≠ y ∧ y ≠ z ∧ x ≠ z ∧ c' x = y ∧ c' y = z ∧ c' z = x := by
    have := hc'.orderOf
    simp_all +decide [Equiv.Perm.IsThreeCycle]
    obtain ⟨x, hx⟩ : ∃ x : Fin n, c' x ≠ x := by
      exact not_forall.mp fun h ↦ by simp_all +decide [show c' = 1 from Equiv.Perm.ext h]
    have := pow_orderOf_eq_one c'
    simp_all +decide [pow_succ]
    replace this := congr_arg (fun f ↦ f x) this
    simp_all +decide
    grind
  obtain ⟨g, hg, hg'⟩ :=
    h_three_trans a b d x y z habd.1 habd.2.1 habd.2.2.1 hxyz.1 hxyz.2.1 hxyz.2.2.1
  convert G.mul_mem (G.mul_mem hg hc) (G.inv_mem hg) using 1
  ext w
  by_cases hw : w = x ∨ w = y ∨ w = z <;> simp_all +decide
  · grind +splitImp
  · have h_support : ∀ w : Fin n, w ∉ ({ x, y, z } : Finset (Fin n)) → c' w = w := by
      intro w hw
      have := hc'
      simp_all +decide [Equiv.Perm.IsThreeCycle]
      have := Equiv.Perm.sum_cycleType c'
      simp_all +decide
      rw [eq_comm, Finset.card_eq_three] at this
      obtain ⟨x, y, z, hxy, hxz, hyz, h⟩ := this
      simp_all +decide [Finset.ext_iff]
      grind
    have h_support : ∀ w : Fin n, w ∉ ({ a, b, d } : Finset (Fin n)) → c w = w := by
      have h_support : Finset.card (Finset.filter (fun w ↦ c w ≠ w) Finset.univ) = 3 := by
        convert ‹c.IsThreeCycle›.card_support using 1
      have h_support : Finset.filter (fun w ↦ c w ≠ w) Finset.univ = { a, b, d } := by
        rw [Finset.eq_of_subset_of_card_le
            (show { a, b, d } ⊆ Finset.filter (fun w ↦ c w ≠ w) Finset.univ from by aesop_cat)]
        aesop
      grind +revert
    grind

/-! ### Evaluation lemmas -/

set_option maxHeartbeats 6400000 in

/-- The value of `classRepeat σ l` at position `n`. -/
lemma classRepeat_val {d : ℕ} (hd : 0 < d) (σ : Equiv.Perm (Fin d)) (l : ℕ) (n : Fin (d * l)) :
    (σ.classRepeat hd l n : ℕ) = (n : ℕ) / d * d + (σ ⟨(n : ℕ) % d, Nat.mod_lt _ hd⟩ : ℕ) := by
  unfold Equiv.Perm.classRepeat
  simp [Equiv.finProdFinEquivCol]
  simp [mul_comm, Fin.modNat]
  ring

/-- The value of `lcmRepeat` at position `n`. -/
lemma lcmRepeat_val {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (σ : Equiv.Perm (Fin d))
    (n : Fin (lcmN k)) :
    ((σ.lcmRepeat hd hd' n : ℕ)) = (n : ℕ) / d * d + (σ ⟨(n : ℕ) % d, Nat.mod_lt _ hd'⟩ : ℕ) := by
  convert classRepeat_val hd' σ (lcmN k / d) (finCongr _ n) using 1
  rw [Nat.mul_div_cancel' (dvd_lcmN hd hd')]

/-- Compatibility of `lcmRepeat` across `lcmN k` and `lcmN (k+1)`. -/
lemma lcmRepeat_succ_val_eq {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (σ : Equiv.Perm (Fin d))
    (n : Fin (lcmN (k + 1))) (hn : (n : ℕ) < lcmN k) :
    (σ.lcmRepeat (Nat.le_succ_of_le hd) hd' n : ℕ) = (σ.lcmRepeat hd hd' ⟨(n : ℕ), hn⟩ : ℕ) :=
  by rw [lcmRepeat_val, lcmRepeat_val]

/-- Any synchronized permutation is in `CT(k+1)` when `CT(k) = ⊤`. -/
lemma syncPerm_mem_CT {k : ℕ} (hk : k ≥ 2) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (σ : Equiv.Perm (Fin (lcmN k))) :
    ∃ τ ∈ CT (k + 1),
      ∀ n : Fin (lcmN (k + 1)),
        (τ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k + (σ ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ) := by
  have h_gen :
    ∀ σ : Equiv.Perm (Fin (lcmN k)),
      σ ∈ CT k →
        ∃ (τ : Equiv.Perm (Fin (lcmN (k + 1)))),
          τ ∈ CT (k + 1) ∧
            ∀ n : Fin (lcmN (k + 1)),
              τ n = (n / lcmN k) * lcmN k + σ ⟨n % lcmN k, Nat.mod_lt _ (lcmN_pos)⟩ := by
    intro σ hσ
    have h_ind :
      ∀ (d : ℕ) (hd : d ≤ k) (hd' : 0 < d) (r₁ r₂ : Fin d),
        ∃ τ ∈ CT (k + 1),
          ∀ n : Fin (lcmN (k + 1)),
            τ n =
              (n / lcmN k) * lcmN k +
                ((Equiv.swap r₁ r₂).lcmRepeat hd hd' ⟨n % lcmN k, Nat.mod_lt _ (lcmN_pos)⟩ :
                  ℕ) := by
      intros d hd hd' r₁ r₂
      use (Equiv.swap r₁ r₂).lcmRepeat (Nat.le_succ_of_le hd) hd'
      refine' ⟨_, _⟩
      · by_cases hd2 : 2 ≤ d
        · exact lcmRepeat_mem_CT (Nat.le_succ_of_le hd) hd' hd2 r₁ r₂
        · interval_cases d
          simp_all +decide [Fin.eq_zero]
          convert Subgroup.one_mem _
          ext
          simp [Equiv.Perm.lcmRepeat]
          simp [Equiv.Perm.classRepeat]
      · intro n
        simp [lcmRepeat_val]
        have h_div : (n : ℕ) / d = (n : ℕ) / lcmN k * (lcmN k / d) + ((n : ℕ) % lcmN k) / d := by
          rw [← Nat.mul_div_assoc]
          · rw [← Nat.mod_add_div n (lcmN k)]
            norm_num [Nat.add_mul_div_left _ _
                  (Nat.pos_of_ne_zero (show lcmN k ≠ 0 from Nat.ne_of_gt (lcmN_pos)))]
            rw [Nat.add_div] <;> norm_num [Nat.mul_div_assoc, Nat.mul_comm, hd']
            rw [Nat.mod_eq_zero_of_dvd
                (dvd_mul_of_dvd_left (show d ∣ lcmN k from dvd_lcmN hd hd') _)]
            norm_num
            ring_nf
            rw [if_neg (Nat.not_le_of_gt (Nat.mod_lt _ hd'))]
            ring
          · exact dvd_lcmN hd hd'
        simp [h_div, Nat.add_mul, Nat.mul_assoc]
        rw [Nat.div_mul_cancel (show d ∣ lcmN k from dvd_lcmN hd hd')]
        simp [Nat.mod_mod_of_dvd _ (show d ∣ lcmN k from dvd_lcmN hd hd'), add_assoc]
    have h_prod :
      ∀ (s : List (Equiv.Perm (Fin (lcmN k)))),
        (∀ σ ∈ s,
            ∃ τ ∈ CT (k + 1),
              ∀ n : Fin (lcmN (k + 1)),
                τ n = (n / lcmN k) * lcmN k + σ ⟨n % lcmN k, Nat.mod_lt _ (lcmN_pos)⟩) →
          ∃ τ ∈ CT (k + 1),
            ∀ n : Fin (lcmN (k + 1)),
              τ n =
                (n / lcmN k) * lcmN k + (List.prod s) ⟨n % lcmN k, Nat.mod_lt _ (lcmN_pos)⟩ := by
      intro s hs
      induction' s with σ s ih
      · use 1
        simp
        exact fun n ↦ by rw [Nat.div_add_mod']
      · obtain ⟨τ₁, hτ₁, hτ₁'⟩ := hs σ (by simp)
        obtain ⟨τ₂, hτ₂, hτ₂'⟩ := ih fun σ hσ ↦ hs σ (by simp [hσ])
        use τ₁ * τ₂
        simp_all +decide
        refine' ⟨Subgroup.mul_mem _ hτ₁ hτ₂, _⟩
        intro n
        rw [Nat.add_div] <;> norm_num [Nat.mod_eq_of_lt, lcmN_pos]
        split_ifs <;> norm_num [Nat.div_eq_of_lt, Nat.mod_lt, lcmN_pos]
        exact absurd ‹_› (not_le_of_gt (Fin.is_lt _))
    have h_prod :
      ∃ s : List (Equiv.Perm (Fin (lcmN k))), σ = List.prod s ∧
        ∀ σ ∈ s, ∃ d : ℕ, ∃ hd : d ≤ k, ∃ hd' : 0 < d, ∃ r₁ r₂ : Fin d, σ = (Equiv.swap r₁ r₂).lcmRepeat hd hd' := by
      have h_prod :
        ∀ (σ : Equiv.Perm (Fin (lcmN k))),
          σ ∈
            Subgroup.closure
              (⋃ d ∈ Finset.Icc 2 k,
                Set.range
                  (fun (⟨r₁, r₂⟩ : Fin d × Fin d) ↦
                    (Equiv.swap r₁ r₂).lcmRepeat (by linarith [Finset.mem_Icc.mp ‹_›])
                      (by linarith [Finset.mem_Icc.mp ‹_›]))) := by
        intro σ
        rw [Subgroup.eq_top_iff'] at ih
        convert ih σ using 1
        refine' le_antisymm _ _
        · simp [CT]
          intro i hi₁ hi₂ x hx
          obtain ⟨y, rfl⟩ := hx
          exact
            Subgroup.mem_iSup_of_mem ⟨i, Finset.mem_Icc.mpr ⟨hi₁, hi₂⟩⟩
              (lcmRepeat_mem_CT' hi₂ (by linarith) _ _)
        · simp [CT]
          intro d hd₁ hd₂
          unfold CT'
          simp [hd₂]
          split_ifs <;> simp [*, Subgroup.closure_le]
          exact
            Set.range_subset_iff.mpr fun x ↦
              Subgroup.subset_closure <|
                Set.mem_iUnion₂.mpr ⟨d, ⟨hd₁, hd₂⟩, Set.mem_range_self x⟩
      have := h_prod σ
      refine' Subgroup.closure_induction _ _ _ _ this
      · simp +zetaDelta at *
        rintro σ d hd₁ hd₂ r₁ r₂ rfl
        exact
          ⟨[Equiv.Perm.lcmRepeat (by linarith) (by linarith) (Equiv.swap r₁ r₂)], by simp,
            fun σ hσ ↦ by
            rw [List.mem_singleton.mp hσ]
            exact ⟨d, hd₂, by linarith, r₁, r₂, rfl⟩⟩
      · exact
          ⟨[], rfl, by
            intros
            contradiction⟩
      · rintro x y hx hy ⟨s, rfl, hs⟩ ⟨t, rfl, ht⟩
        exact
          ⟨s ++ t, by simp, fun σ hσ ↦ by
            cases List.mem_append.mp hσ <;> [exact hs _ ‹_›; exact ht _ ‹_›]⟩
      · rintro x hx ⟨s, rfl, hs⟩
        refine' ⟨s.reverse.map fun σ ↦ σ⁻¹, _, _⟩ <;> simp [List.prod_inv_reverse]
        intro σ hσ
        obtain ⟨d, hd, hd', r₁, r₂, h⟩ := hs _ hσ
        use d, hd, hd', r₁, r₂
        rw [inv_eq_iff_eq_inv] at h
        rw [h, inv_eq_iff_mul_eq_one]
        ext n
        simp [Equiv.Perm.lcmRepeat]
        simp [Equiv.Perm.classRepeat]
    obtain ⟨s, rfl, hs⟩ := h_prod
    exact
      h_prod s fun σ hσ ↦ by
        obtain ⟨d, hd, hd', r₁, r₂, rfl⟩ := hs σ hσ
        exact h_ind d hd hd' r₁ r₂
  aesop

/-! ### Primitivity as `IsPreprimitive` -/

/-! ### From raw primitivity/transitivity to Mathlib's `IsPreprimitive` -/

/-- Translate raw transitivity (`htrans`) and primitivity (`hprim`, expressed as preservation
of trivial setoids) of a subgroup `G ≤ Perm (Fin n)` into Mathlib's `IsPreprimitive`. -/
lemma isPreprimitive_of_transitive_primitive {n : ℕ} (G : Subgroup (Equiv.Perm (Fin n)))
    (htrans : ∀ a b : Fin n, ∃ g ∈ G, g a = b)
    (hprim :
      ∀ (r : Setoid (Fin n)),
        (∀ (g : ↥G) (x y : Fin n), r.r x y → r.r (g.1 x) (g.1 y)) →
          (∀ x y, r.r x y) ∨ (∀ x y, r.r x y → x = y)) :
    MulAction.IsPreprimitive (↥G) (Fin n) := by
  refine' { .. }
  · exact fun x y ↦ by
      obtain ⟨g, hg₁, hg₂⟩ := htrans x y
      exact ⟨⟨g, hg₁⟩, hg₂⟩
  · intro B hB
    contrapose! hprim
    refine' ⟨_, _, _, _⟩
    refine'
      {
        r := fun x y ↦
          ∀ g : ↥G, x ∈ (g : Equiv.Perm (Fin n)) '' B ↔ y ∈ (g : Equiv.Perm (Fin n)) '' B,
        iseqv := ⟨fun x g ↦ Iff.rfl, fun h g ↦ (h g).symm, fun h1 h2 g ↦ (h1 g).trans (h2 g)⟩ }
    · simp
      intro g hg x y hxy h hg'
      specialize hxy (g⁻¹ * h) (G.mul_mem (G.inv_mem hg) hg')
      aesop
    · simp_all +decide [MulAction.IsTrivialBlock]
      obtain ⟨x, hx, y, hy, hxy⟩ := hprim.1
      obtain ⟨g, hg, hg'⟩ := htrans x y
      use y, g (Classical.choose (Set.nonempty_compl.2 hprim.2)), g
      have := Classical.choose_spec (Set.nonempty_compl.2 hprim.2)
      aesop
    · simp_all +decide [MulAction.IsTrivialBlock]
      obtain ⟨x, hx, y, hy, hxy⟩ := hprim.1
      use x, y
      simp_all +decide [MulAction.IsBlock, Set.ext_iff]
      intro g hg
      specialize hB g hg 1 (G.one_mem)
      simp_all +decide [Set.disjoint_left]
      simp_all +decide [Set.mem_smul_set, Equiv.Perm.smul_def]
      grind

/-- Transitivity within a synchronized row. -/
lemma CT_growth_same_row {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (a b : Fin (lcmN (k + 1))) (hab : (a : ℕ) / lcmN k = (b : ℕ) / lcmN k) :
    ∃ g ∈ CT (k + 1), g a = b := by
  -- Let `pos_a = a % lcmN k` and `pos_b = b % lcmN k` be the column indices in the synchronized row.
  set pos_a : Fin (lcmN k) := ⟨a.val % lcmN k, Nat.mod_lt _ lcmN_pos⟩
  set pos_b : Fin (lcmN k) := ⟨b.val % lcmN k, Nat.mod_lt _ lcmN_pos⟩
  obtain ⟨τ, hτ⟩ :
    ∃ τ ∈ CT (k + 1),
      ∀ n : Fin (lcmN (k + 1)),
        (τ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap pos_a pos_b ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ) := by
    have := syncPerm_mem_CT (show 2 ≤ k from by linarith) hne ih (Equiv.swap pos_a pos_b)
    aesop
  refine' ⟨τ, hτ.1, Fin.ext _⟩
  simp_all +decide [Equiv.swap_apply_def]
  simp +zetaDelta at *
  rw [Nat.div_add_mod']

/-- `(k+1)` does not divide `r * lcmN k` for `0 < r < p`. -/
lemma not_dvd_mul_lcmN_of_lt {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (r : ℕ)
    (hr_pos : 0 < r) (hr : r * lcmN k < lcmN (k + 1)) : ¬(k + 1 ∣ r * lcmN k) := by
  contrapose! hr
  rw [lcmN_succ]
  refine' Nat.le_of_dvd (Nat.mul_pos hr_pos (Nat.pos_of_ne_zero _)) (Nat.lcm_dvd _ _)
  · exact Nat.ne_of_gt (lcmN_pos)
  · exact dvd_mul_left _ _
  · assumption

/-- Consecutive positions at a row boundary share a `(k+1)`-block. -/
lemma same_block_at_boundary {k : ℕ} (r : ℕ) (hr_pos : 0 < r)
    (h_not_dvd : ¬(k + 1 ∣ r * lcmN k)) : (r * lcmN k - 1) / (k + 1) = (r * lcmN k) / (k + 1) := by
  rcases n : r * lcmN k with (_ | _ | n) <;> simp_all +decide
  · rcases k with (_ | _ | k) <;> simp_all +arith +decide [Nat.div_eq_of_lt]
  · exact Eq.symm (Nat.succ_div_of_not_dvd h_not_dvd)

/-- For any row `r`, there exists `g ∈ CT(k+1)` with `(g 0) / lcmN k = r`. -/
lemma CT_growth_reach_row {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : ℕ) (hr : r * lcmN k < lcmN (k + 1)) : ∃ g ∈ CT (k + 1), (g 0 : ℕ) / lcmN k = r := by
  induction' r with r ih
  · exact ⟨1, Subgroup.one_mem _, by simp [Nat.div_eq_of_lt, lcmN_pos]⟩
  · obtain ⟨g₁, hg₁⟩ := ih (by linarith)
    set L := lcmN k with hL_def
    obtain ⟨a, ha⟩ : ∃ a : Fin (lcmN (k + 1)), (a : ℕ) = (r + 1) * L - 1 := by
      exact
        ⟨⟨(r + 1) * L - 1,
            Nat.lt_of_lt_of_le
              (Nat.sub_lt (Nat.mul_pos (Nat.succ_pos _) (lcmN_pos)) zero_lt_one) hr.le⟩,
          rfl⟩
    obtain ⟨b, hb⟩ : ∃ b : Fin (lcmN (k + 1)), (b : ℕ) = (r + 1) * L := by
      exact ⟨⟨(r + 1) * L, hr⟩, rfl⟩
    obtain ⟨g₂, hg₂⟩ : ∃ g₂ ∈ CT (k + 1), g₂ (g₁ 0) = a := by
      apply CT_growth_same_row hk hne ‹_›
      rw [ha, hg₁.2]
      rw [Nat.add_mul, one_mul, Nat.add_sub_assoc] <;>
        norm_num [Nat.add_div, Nat.mul_div_assoc, lcmN_pos]
      · rcases L with (_ | _ | L) <;> simp_all +decide
        · exact absurd hL_def (ne_of_lt (lcmN_pos))
        · norm_num [← hL_def] at *
        · norm_num [Nat.div_eq_of_lt, Nat.sub_lt, show lcmN k > 0 from lcmN_pos]
      · exact Nat.pos_of_ne_zero (mt Finset.lcm_eq_zero_iff.mp (by aesop))
    obtain ⟨g₃, hg₃⟩ : ∃ g₃ ∈ CT (k + 1), g₃ a = b := by
      obtain ⟨r1, r2, hr1, hr2, hr⟩ :
        ∃ r1 r2 : Fin (k + 1),
          r1 ≠ r2 ∧
            (a : ℕ) % (k + 1) = r1 ∧
              (b : ℕ) % (k + 1) = r2 ∧ (a : ℕ) / (k + 1) = (b : ℕ) / (k + 1) := by
        have h_block : (a : ℕ) / (k + 1) = (b : ℕ) / (k + 1) := by
          rw [ha, hb]
          apply same_block_at_boundary
          · positivity
          · apply not_dvd_mul_lcmN_of_lt
            · linarith
            · assumption
            · positivity
            · linarith
        refine'
          ⟨⟨a % (k + 1), Nat.mod_lt _ (Nat.succ_pos _)⟩,
            ⟨b % (k + 1), Nat.mod_lt _ (Nat.succ_pos _)⟩, _, rfl, rfl, h_block⟩
        simp [Fin.ext_iff, ha, hb]
        intro h
        have := Nat.modEq_iff_dvd.mp h.symm
        norm_num at this
        rw [Nat.cast_sub
            (Nat.one_le_iff_ne_zero.mpr <|
              mul_ne_zero (Nat.succ_ne_zero _) <| ne_of_gt <| lcmN_pos)] at this
        norm_num at this
        norm_num [hL_def] at this
        norm_cast at this
        aesop
      use (Equiv.swap r1 r2).lcmRepeat (by norm_num) (by grind +qlia)
      refine' ⟨_, _⟩
      · apply lcmRepeat_mem_CT
        linarith
      · refine' Fin.ext _
        rw [lcmRepeat_val]
        simp_all +decide
        rw [← hr.1, Nat.div_add_mod']
    use g₃ * g₂ * g₁
    simp_all +decide
    exact
      ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hg₃.1 hg₂.1) hg₁.1,
        Nat.mul_div_cancel _ (lcmN_pos)⟩

/-- The orbit of 0 under CT(k+1) includes every element. -/
lemma CT_growth_orbit_zero {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤) :
    ∀ b : Fin (lcmN (k + 1)), ∃ g ∈ CT (k + 1), g 0 = b := by
  intro b
  have hb_row : (b : ℕ) / lcmN k * lcmN k < lcmN (k + 1) :=
    Nat.lt_of_le_of_lt (Nat.div_mul_le_self _ _) b.is_lt
  obtain ⟨g₁, hg₁_mem, hg₁⟩ := CT_growth_reach_row hk hne ih ((b : ℕ) / lcmN k) hb_row
  obtain ⟨g₂, hg₂_mem, hg₂⟩ := CT_growth_same_row hk hne ih (g₁ 0) b (by rw [hg₁])
  exact ⟨g₂ * g₁, (CT (k + 1)).mul_mem hg₂_mem hg₁_mem, by simp [Equiv.Perm.mul_apply, hg₂]⟩

/-- CT(k+1) acts transitively on `Fin(lcmN(k+1))` in the growth case. -/
lemma CT_growth_transitive {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤) :
    ∀ a b : Fin (lcmN (k + 1)), ∃ g ∈ CT (k + 1), g a = b := by
  intro a b
  obtain ⟨g₁, hg₁_mem, hg₁⟩ := CT_growth_orbit_zero hk hne ih a
  obtain ⟨g₂, hg₂_mem, hg₂⟩ := CT_growth_orbit_zero hk hne ih b
  exact
    ⟨g₂ * g₁⁻¹, (CT (k + 1)).mul_mem hg₂_mem ((CT (k + 1)).inv_mem hg₁_mem), by
      simp [Equiv.Perm.mul_apply, ← hg₁, hg₂]⟩

/-- If a `CT(k+1)`-invariant relation identifies `0` with another element in row 0,
then all of row 0 is in `[0]`. -/
lemma prim_row0_class {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin (lcmN (k + 1))) (hc0 : c ≠ 0) (hc_row0 : (c : ℕ) < lcmN k) (hrel : r.r 0 c) :
    ∀ x : Fin (lcmN (k + 1)), (x : ℕ) < lcmN k → r.r 0 x := by
  intros x hx_row0
  by_cases hx0 : x = 0
  · exact hx0.symm ▸ r.refl _
  · -- Since `x ≠ 0` and `c ≠ 0`, we can find a permutation `σ ∈ Sym (Fin (lcmN k))`
    -- such that `σ 0 = 0` and `σ c = x`.
    obtain ⟨σ, hσ⟩ :
      ∃ σ : Equiv.Perm (Fin (lcmN k)),
        σ ⟨0, by linarith⟩ = ⟨0, by linarith⟩ ∧
          σ ⟨c.val % lcmN k, Nat.mod_lt _ lcmN_pos⟩ = ⟨x.val % lcmN k, Nat.mod_lt _ lcmN_pos⟩ := by
      simp_all +decide [Nat.mod_eq_of_lt]
      exact ⟨Equiv.swap ⟨c, hc_row0⟩ ⟨x, hx_row0⟩, by aesop⟩
    obtain ⟨τ, hτ⟩ := syncPerm_mem_CT (by linarith) hne ih σ
    have hτ0 : τ 0 = 0 := by
      refine' Fin.ext _
      simp [hτ.2]
      exact hσ.1
    have hτc : τ c = x := by
      simp_all +decide [Nat.mod_eq_of_lt]
      rw [Fin.ext_iff]
      simp [*, Nat.div_eq_of_lt, Nat.mod_eq_of_lt]
    simpa [hτ0, hτc] using hinv ⟨τ, hτ.1⟩ 0 c hrel

/-- The cross-row generator extends the equivalence class from row 0 to row 1. -/
lemma prim_cross_row {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin (lcmN (k + 1)), (x : ℕ) < lcmN k → r.r 0 x) :
    r.r 0
      ⟨lcmN k, Nat.lt_of_le_of_ne (Nat.le_of_dvd lcmN_pos (lcmN_dvd_succ' k)) (Ne.symm hne)⟩ := by
  have h0_lcmN_k_minus_1 :
    r 0
      ⟨lcmN k - 1, by
        exact
          lt_trans (Nat.pred_lt (ne_bot_of_gt lcmN_pos))
            (Nat.lt_of_le_of_ne (Nat.le_of_dvd lcmN_pos (lcmN_dvd_succ' _)) (Ne.symm hne))⟩ :=
    by exact hrow0 _ (Nat.pred_lt (ne_bot_of_gt (lcmN_pos)))
  set r1 : Fin (k + 1) := ⟨(lcmN k - 1) % (k + 1), Nat.mod_lt _ (Nat.succ_pos _)⟩
  set r2 : Fin (k + 1) := ⟨lcmN k % (k + 1), Nat.mod_lt _ (Nat.succ_pos _)⟩
  set g : Equiv.Perm (Fin (lcmN (k + 1))) :=
    (Equiv.swap r1 r2).lcmRepeat (by norm_num) (by linarith)
  generalize_proofs at *
  have hg0 : g ⟨lcmN k - 1, by assumption⟩ = ⟨lcmN k, by linarith⟩ := by
    all_goals generalize_proofs at *
    refine' Fin.ext _
    rw [lcmRepeat_val]
    simp +zetaDelta at *
    rw [← Nat.mod_add_div (lcmN k) (k + 1)]
    rcases n : lcmN k % (k + 1) with (_ | _ | n) <;> simp_all +decide [Nat.add_mul_div_left]
    · exact
        False.elim <|
          hne <| by
            rw [lcmN_succ]
            exact Nat.lcm_eq_left <| Nat.dvd_of_mod_eq_zero n
    · rw [Nat.mod_eq_of_lt (by linarith : 1 < k + 1)]
      ring
    · rw [Nat.div_eq_of_lt, Nat.mod_eq_of_lt] <;> linarith
  generalize_proofs at *
  have hg0_r : r (g ⟨0, by grind⟩) (g ⟨lcmN k - 1, by assumption⟩) := by
    convert hinv ⟨g, _⟩ _ _ h0_lcmN_k_minus_1 using 1
    apply lcmRepeat_mem_CT
    linarith
  generalize_proofs at *
  have hg0_r : r 0 (g ⟨0, by positivity⟩) := by
    apply hrow0
    rw [lcmRepeat_val]
    simp [Equiv.swap_apply_def]
    split_ifs <;> norm_num [Fin.ext_iff] at *
    · exact
        Nat.mod_lt _ (Nat.succ_pos _) |> lt_of_lt_of_le <|
          Nat.succ_le_of_lt <| by
            linarith [show lcmN k > k from by
                exact lt_of_lt_of_le (Nat.lt_succ_self _) (succ_le_lcmN' hk)]
    · exact
        lt_of_lt_of_le (Nat.mod_lt _ (Nat.succ_pos _))
          (Nat.succ_le_of_lt (Nat.lt_of_lt_of_le (Nat.lt_succ_self _) (succ_le_lcmN' hk)))
    · exact Nat.pos_of_ne_zero (by aesop_cat)
  exact r.trans hg0_r (by aesop)

/-! ### Transitivity and primitivity helpers -/

/-- There exists a permutation sending one pair of distinct elements to another. -/
lemma exists_perm_two_points {n : ℕ} (hn : 2 ≤ n) (a b : Fin n) (hab : a ≠ b) (c d : Fin n)
    (hcd : c ≠ d) : ∃ σ : Equiv.Perm (Fin n), σ a = c ∧ σ b = d := by
  obtain ⟨σ, hσ⟩ : ∃ σ : Equiv.Perm (Fin n), σ a = c := by exact ⟨Equiv.swap a c, by simp⟩
  use σ * Equiv.swap b (σ⁻¹ d)
  simp [*, Equiv.swap_apply_def]
  grind

/-- `(k+1)` does not divide `m * lcmN k` at non-trivial row boundaries. -/
lemma row_boundary_not_div {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (m : ℕ)
    (hm : 1 ≤ m) (hm' : m * lcmN k < lcmN (k + 1)) : ¬((k + 1) ∣ (m * lcmN k)) := by
  -- By definition of lcmN, we know that lcmN(k+1) = lcm(lcmN(k), k+1).
  have h_lcmN_succ : lcmN (k + 1) = Nat.lcm (lcmN k) (k + 1) := by exact lcmN_succ k
  contrapose! hm'
  exact
    h_lcmN_succ ▸
      Nat.le_of_dvd (Nat.mul_pos hm (Nat.pos_of_ne_zero (by aesop_cat)))
        (Nat.lcm_dvd (dvd_mul_left _ _) hm')

set_option maxHeartbeats 400000 in

/-- When columns differ, two synchronized permutations yield `r.r 0 1`. -/
lemma prim_reduce_col_ne_zero {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (a b : Fin (lcmN (k + 1))) (ha_row0 : (a : ℕ) < lcmN k) (hb_not_row0 : lcmN k ≤ (b : ℕ))
    (hcol_ne : (a : ℕ) % lcmN k ≠ (b : ℕ) % lcmN k) (hrel : r.r a b) :
    r.r 0 ⟨1, by linarith [succ_le_lcmN' hk, Nat.le_of_dvd lcmN_pos (lcmN_dvd_succ' k)]⟩ := by
  -- Let col_a = a.val % L and col_b = b.val % L (where L = lcmN k). These are distinct.
  set col_a := a.val % lcmN k
  set col_b := b.val % lcmN k
  have hcol_ne' : col_a ≠ col_b := by assumption
  set row_b := b.val / lcmN k
  have hrow_b_ge_1 : 1 ≤ row_b := by
    exact Nat.div_pos hb_not_row0 (Nat.pos_of_ne_zero (by aesop))
  obtain ⟨v, hv⟩ :
    ∃ v : Fin (lcmN k),
      v ≠ ⟨0, lcmN_pos⟩ ∧
        v ≠
            ⟨1, by
              exact
                lt_of_lt_of_le (by decide)
                  (Nat.le_of_dvd (lcmN_pos)
                    (Finset.dvd_lcm
                      (show 2 ∈ Finset.Ioc 0 k from
                        Finset.mem_Ioc.mpr ⟨by decide, by linarith⟩)))⟩ ∧
          v ≠ ⟨col_a, Nat.mod_lt _ lcmN_pos⟩ := by
    by_contra! h_contra
    have h_card : Finset.card (Finset.univ : Finset (Fin (lcmN k))) ≤ 3 := by
      have h_card :
        Finset.card (Finset.univ : Finset (Fin (lcmN k))) ≤
          Finset.card
            ({⟨0, lcmN_pos⟩, ⟨1, by linarith [succ_le_lcmN' hk]⟩,
                ⟨col_a, Nat.mod_lt _ lcmN_pos⟩} :
              Finset (Fin (lcmN k))) := by
        generalize_proofs at *
        exact
          Finset.card_le_card fun x hx ↦ by
            by_cases hx0 : x = ⟨0, by linarith⟩ <;> by_cases hx1 : x = ⟨1, by linarith⟩ <;>
                specialize h_contra x <;>
              aesop
      grind
    generalize_proofs at *
    norm_num at *
    exact
      absurd h_card (by
          linarith [show lcmN k ≥ 4 by
              exact
                le_trans (by decide) (Nat.le_trans (Nat.le_succ_of_le hk) (succ_le_lcmN' hk))])
  generalize_proofs at *
  obtain ⟨σ₁, hσ₁⟩ :
    ∃ σ₁ : Equiv.Perm (Fin (lcmN k)),
      σ₁ ⟨col_a, Nat.mod_lt _ lcmN_pos⟩ = ⟨0, lcmN_pos⟩ ∧
        σ₁ ⟨col_b, Nat.mod_lt _ lcmN_pos⟩ = v := by
    have h_exists_perm :
      ∃ σ₁ : Equiv.Perm (Fin (lcmN k)), σ₁ ⟨col_a, Nat.mod_lt _ lcmN_pos⟩ = ⟨0, lcmN_pos⟩ := by
      exact ⟨Equiv.swap ⟨col_a, by assumption⟩ ⟨0, by assumption⟩, by simp⟩
    generalize_proofs at *
    obtain ⟨σ₁, hσ₁⟩ := h_exists_perm
    use σ₁ * Equiv.swap ⟨col_b, by solve_by_elim⟩ (σ₁⁻¹ v)
    aesop
  generalize_proofs at *
  obtain ⟨σ₂, hσ₂⟩ :
    ∃ σ₂ : Equiv.Perm (Fin (lcmN k)),
      σ₂ ⟨col_a, Nat.mod_lt _ lcmN_pos⟩ = ⟨1, by linarith⟩ ∧
        σ₂ ⟨col_b, Nat.mod_lt _ lcmN_pos⟩ = v := by
    have :=
      exists_perm_two_points (show 2 ≤ lcmN k from by linarith) ⟨col_a, by linarith⟩
        ⟨col_b, by linarith⟩ (by aesop) ⟨1, by linarith⟩ v (by aesop)
    aesop
  generalize_proofs at *
  obtain ⟨τ₁, hτ₁⟩ := syncPerm_mem_CT (by linarith) hne ih σ₁
  obtain ⟨τ₂, hτ₂⟩ := syncPerm_mem_CT (by linarith) hne ih σ₂
  generalize_proofs at *
  have hτ₁_a : τ₁ a = ⟨0, by grind⟩ := by
    ext
    simp [hτ₁]
    exact ⟨Or.inl <| Or.inr ha_row0, hσ₁.1⟩
  have hτ₁_b : τ₁ b = ⟨row_b * lcmN k + v.val, by grind +locals⟩ := by exact Fin.ext (by aesop)
  generalize_proofs at *
  have hτ₂_a : τ₂ a = ⟨1, by linarith⟩ := by grind
  have hτ₂_b : τ₂ b = ⟨row_b * lcmN k + v.val, by linarith⟩ := by exact Fin.ext (by aesop)
  generalize_proofs at *
  have h_trans :
    r ⟨0, by finiteness⟩ ⟨row_b * lcmN k + v, by linarith⟩ ∧
      r ⟨1, by linarith⟩ ⟨row_b * lcmN k + v, by linarith⟩ := by
    exact
      ⟨by simpa only [hτ₁_a, hτ₁_b] using hinv ⟨τ₁, hτ₁.1⟩ a b hrel, by
        simpa only [hτ₂_a, hτ₂_b] using hinv ⟨τ₂, hτ₂.1⟩ a b hrel⟩
  generalize_proofs at *
  exact r.trans h_trans.1 (r.symm h_trans.2)

/-- When `c` has column 0, use a `CT'(k+1)` generator to create distinct columns. -/
lemma prim_reduce_col_zero {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin (lcmN (k + 1))) (hc0 : c ≠ 0) (hrel : r.r 0 c) (hc_ge : lcmN k ≤ (c : ℕ))
    (hcol_zero : (c : ℕ) % lcmN k = 0) :
    ∃ x : Fin (lcmN (k + 1)), x ≠ 0 ∧ (x : ℕ) < lcmN k ∧ r.r 0 x := by
  -- By row_boundary_not_div: (k+1) ∤ c, so r_mod := c % (k+1) ≠ 0, r_mod ∈ {1, ..., k}.
  have h_r_mod_ne_zero : (c : ℕ) % (k + 1) ≠ 0 := by
    have h_r_mod_ne_zero : ¬((k + 1) ∣ (c : ℕ)) := by
      have h_row_boundary_not_div :
        ∀ m : ℕ, 1 ≤ m → m * lcmN k < lcmN (k + 1) → ¬((k + 1) ∣ (m * lcmN k)) := by
        exact fun m a a_1 ↦ not_dvd_mul_lcmN_of_lt hk hne m a a_1
      convert
        h_row_boundary_not_div (c / lcmN k) (Nat.div_pos hc_ge (Nat.pos_of_ne_zero (by aesop)))
          (by nlinarith [Nat.mod_add_div c (lcmN k), Fin.is_lt c]) using 1
      rw [Nat.div_mul_cancel (Nat.dvd_of_mod_eq_zero hcol_zero)]
    exact fun h ↦ h_r_mod_ne_zero <| Nat.dvd_of_mod_eq_zero h
  obtain ⟨m, hm⟩ : ∃ m ∈ ({ 1, 2 } : Finset ℕ), m ≠ (c : ℕ) % (k + 1) := by
    by_cases h₂ : (c : ℕ) % (k + 1) = 1
    · aesop
    · exact ⟨1, by norm_num, by tauto⟩
  obtain ⟨g, hg⟩ :
    ∃ g ∈ CT (k + 1),
      g 0 =
          ⟨m, by
            simp +zetaDelta at *
            exact
              lt_of_le_of_lt (show m ≤ 2 by omega)
                (show 2 < lcmN (k + 1) from
                  lt_of_lt_of_le (by linarith)
                    (succ_le_lcmN' (show 4 ≤ k + 1 from by linarith)))⟩ ∧
        g c = c := by
    all_goals generalize_proofs at *
    refine'
      ⟨_,
        lcmRepeat_mem_CT (show k + 1 ≤ k + 1 from le_rfl) (show 0 < k + 1 from Nat.succ_pos _)
          (show 2 ≤ k + 1 from by linarith) ⟨0, by linarith⟩
          ⟨m, by
            norm_num +zetaDelta at *
            omega⟩,
        _, _⟩
    all_goals generalize_proofs at *
    · erw [Fin.ext_iff]
      simp [lcmRepeat_val]
    · rw [Equiv.Perm.lcmRepeat]
      simp [Equiv.Perm.classRepeat, Fin.ext_iff]
      simp [Equiv.finProdFinEquivCol, Equiv.swap_apply_def]
      split_ifs <;> simp_all +decide [Fin.modNat]
      rw [Nat.mod_add_div]
  generalize_proofs at *
  have := hinv ⟨g, hg.1⟩ 0 c hrel
  simp_all +decide
  use ⟨m, by linarith⟩
  generalize_proofs at *
  refine' ⟨_, _, _⟩
  · cases m <;> aesop
  · rcases hm.1 with (rfl | rfl) <;> norm_num at *
    · exact lt_of_lt_of_le (by linarith) (succ_le_lcmN' hk)
    · exact
        lt_of_lt_of_le (by decide)
          (Nat.le_of_dvd (lcmN_pos)
            (Finset.dvd_lcm
              (show 3 ∈ Finset.Ioc 0 (k) from Finset.mem_Ioc.mpr ⟨by decide, by linarith⟩)))
  · exact Setoid.symm' r (Setoid.trans' r this (id (Setoid.symm' r hrel)))

/-- Reduce a non-trivial equivalence to a pair within row 0. -/
lemma prim_reduce_to_row0 {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin (lcmN (k + 1))) (hc0 : c ≠ 0) (hrel : r.r 0 c) :
    ∃ x : Fin (lcmN (k + 1)), x ≠ 0 ∧ (x : ℕ) < lcmN k ∧ r.r 0 x := by
  by_cases hc_row0 : (c : ℕ) < lcmN k
  · use c
  · by_cases hcol_zero : (c : ℕ) % lcmN k = 0
    · apply
        prim_reduce_col_zero hk hne ih r hinv c hc0 hrel (by exact le_of_not_gt hc_row0)
          hcol_zero
    · have hreduce :
        r 0 ⟨1, by linarith [succ_le_lcmN' hk, Nat.le_of_dvd lcmN_pos (lcmN_dvd_succ' k)]⟩ := by
        apply
          prim_reduce_col_ne_zero hk hne ih r hinv 0 c (by exact lcmN_pos)
            (by exact le_of_not_gt hc_row0) (by aesop) hrel
      exact
        ⟨_, by aesop_cat, by exact Nat.lt_of_succ_le (by linarith [succ_le_lcmN' hk]), hreduce⟩

/-- Cross a row boundary using a `CT'(k+1)` generator. -/
lemma prim_cross_row_m {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (_ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin (lcmN (k + 1)), (x : ℕ) < lcmN k → r.r 0 x) (m : ℕ) (hm : 1 ≤ m)
    (hm_lt : m * lcmN k < lcmN (k + 1)) (hprev : r.r 0 ⟨m * lcmN k - 1, by omega⟩) :
    r.r 0 ⟨m * lcmN k, hm_lt⟩ := by
  set r₁ := (m * lcmN k - 1) % (k + 1)
  set r₂ := (m * lcmN k) % (k + 1)
  have hr₂ : r₂ = r₁ + 1 := by
    have h_mod : (m * lcmN k) % (k + 1) = ((m * lcmN k - 1) % (k + 1) + 1) % (k + 1) := by
      simp [← ZMod.natCast_eq_natCast_iff',
        Nat.cast_sub (show 1 ≤ m * lcmN k from Nat.mul_pos hm (lcmN_pos))]
    refine' h_mod.trans (Nat.mod_eq_of_lt _)
    have h_mod_lt : (m * lcmN k) % (k + 1) ≠ 0 := by
      exact fun h ↦ row_boundary_not_div hk hne m hm hm_lt <| Nat.dvd_of_mod_eq_zero h
    exact
      Nat.lt_of_le_of_ne (Nat.succ_le_of_lt (Nat.mod_lt _ (Nat.succ_pos _))) fun h ↦
        h_mod_lt <| h_mod.trans <| Nat.mod_eq_zero_of_dvd <| by aesop
  obtain ⟨g, hg⟩ :
    ∃ g ∈ CT (k + 1),
      g ⟨m * lcmN k - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) hm_lt⟩ = ⟨m * lcmN k, hm_lt⟩ ∧
        g 0 < lcmN k := by
    refine'
        ⟨Equiv.swap ⟨r₁, _⟩ ⟨r₂, _⟩ |> Equiv.Perm.lcmRepeat (Nat.le_refl _) (Nat.succ_pos _), _,
          _, _⟩ <;>
      norm_num
    any_goals exact Nat.le_of_lt_succ (Nat.mod_lt _ (Nat.succ_pos _))
    · apply lcmRepeat_mem_CT
      linarith
    · refine' Fin.ext _
      rw [lcmRepeat_val]
      simp +zetaDelta at *
      linarith [Nat.mod_add_div (m * lcmN k - 1) (k + 1),
        Nat.sub_add_cancel (show 1 ≤ m * lcmN k from Nat.mul_pos hm (lcmN_pos))]
    · rw [lcmRepeat_val]
      rcases k with (_ | _ | k) <;> simp_all +decide [Nat.mod_eq_of_lt]
      rw [Equiv.swap_apply_def]
      norm_num
      split_ifs <;> norm_num
      · linarith [show lcmN (k + 1 + 1) > 1 from
            lt_of_lt_of_le (by linarith) (succ_le_lcmN' (by linarith))]
      · exact Nat.pos_of_ne_zero (by aesop)
  have := hinv ⟨g, hg.1⟩ 0 ⟨m * lcmN k - 1, Nat.lt_of_le_of_lt (Nat.sub_le _ _) hm_lt⟩
  simp_all +decide
  exact r.trans (hrow0 _ hg.2.2) this

/-- Fill a row using synchronized permutations. -/
lemma prim_fill_row {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin (lcmN (k + 1)), (x : ℕ) < lcmN k → r.r 0 x) (m : ℕ)
    (hm_lt : m * lcmN k < lcmN (k + 1)) (hbase : r.r 0 ⟨m * lcmN k, hm_lt⟩) (j : ℕ)
    (hj : j < lcmN k) (hj_lt : m * lcmN k + j < lcmN (k + 1)) : r.r 0 ⟨m * lcmN k + j, hj_lt⟩ := by
  have h_trans : r 0 ⟨j, by grind⟩ := by exact hrow0 _ hj
  all_goals generalize_proofs at *
  obtain ⟨τ, hτ⟩ :=
    syncPerm_mem_CT (by linarith) hne ih (Equiv.swap ⟨0, by lia⟩ ⟨j, by linarith⟩)
  generalize_proofs at *
  have h_trans : r ⟨j, by linarith⟩ ⟨m * lcmN k + j, hj_lt⟩ := by
    all_goals generalize_proofs at *
    convert hinv ⟨τ, hτ.1⟩ _ _ hbase using 1
    · rw [Fin.ext_iff]
      aesop
    · simp [Fin.ext_iff, hτ.2]
      exact Or.inl (Eq.symm (Nat.mul_div_cancel _ (Nat.pos_of_ne_zero (by aesop_cat))))
  generalize_proofs at *
  exact Setoid.trans ‹_› h_trans

/-- Primitivity step: if a `CT (k + 1)`-invariant equivalence relation `r` already relates `0`
to every element of row `0` and to the first element of row `1`, then `r` is the universal
relation on the entire grid `Fin (lcmN (k + 1))`. -/
lemma prim_extend_all_rows {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤)
    (r : Setoid (Fin (lcmN (k + 1))))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin (lcmN (k + 1)), (x : ℕ) < lcmN k → r.r 0 x)
    (hL :
      r.r 0
        ⟨lcmN k,
          Nat.lt_of_le_of_ne (Nat.le_of_dvd lcmN_pos (lcmN_dvd_succ' k)) (Ne.symm hne)⟩) :
    ∀ x : Fin (lcmN (k + 1)), r.r 0 x := by
  intro x
  have h_ind :
    ∀ m : ℕ,
      m * lcmN k < lcmN (k + 1) →
        ∀ j : ℕ, j < lcmN k → (h : m * lcmN k + j < lcmN (k + 1)) → r 0 ⟨m * lcmN k + j, h⟩ := by
    intro m hm j hj h
    induction' m with m ih generalizing j
    · simpa using hrow0 ⟨j, by simpa using h⟩ hj
    · -- By the induction hypothesis, we know that `r 0 ⟨m * lcmN k + (lcmN k - 1), _⟩`.
      have h_ind_step :
        r 0
          ⟨m * lcmN k + (lcmN k - 1), by
            linarith [Nat.sub_add_cancel
                (show 1 ≤ lcmN k from Nat.pos_of_ne_zero (by aesop))]⟩ := by
        all_goals generalize_proofs at *
        exact
          ih (by nlinarith) _ (Nat.sub_lt (Nat.pos_of_ne_zero (by aesop_cat)) zero_lt_one)
            (by linarith)
      generalize_proofs at *
      convert
        prim_fill_row hk hne ‹_› r hinv (fun x hx ↦ hrow0 x hx) (m + 1) (by linarith) _ j hj
          (by linarith) using 1
      convert
        prim_cross_row_m hk hne ‹_› r hinv (fun x hx ↦ hrow0 x hx) (m + 1) (by linarith)
          (by linarith) _ using 1
      convert h_ind_step using 2
      rw [Nat.succ_mul]
      rw [Nat.add_sub_assoc (Nat.one_le_iff_ne_zero.mpr <| ne_of_gt <| lcmN_pos)]
  convert
    h_ind (x / lcmN k) (by nlinarith [Nat.div_mul_le_self x (lcmN k), Fin.is_lt x]) (x % lcmN k)
      (Nat.mod_lt _ lcmN_pos) (by nlinarith [Nat.div_add_mod x (lcmN k), Fin.is_lt x]) using 1
  exact Eq.symm (Fin.ext <| by simp [Nat.div_add_mod'])

/-- CT(k+1) is primitive in the growth case: it preserves no non-trivial
equivalence relation on `Fin(lcmN(k+1))`.
The proof uses synchronized permutations (which force any non-trivial
invariant block to contain an entire row of size `lcmN k`) and CT'(k+1)
generators (which break the row-based block system). -/
lemma CT_growth_primitive {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) (ih : CT k = ⊤) :
    ∀ (r : Setoid (Fin (lcmN (k + 1)))),
      (∀ (g : ↥(CT (k + 1))) (x y : Fin (lcmN (k + 1))), r.r x y → r.r (g.1 x) (g.1 y)) →
        (∀ x y, r.r x y) ∨ (∀ x y, r.r x y → x = y) := by
  intro r hinv
  by_cases h : ∀ x y, r.r x y → x = y
  · right
    exact h
  · left
    push_neg at h
    obtain ⟨a, b, hab, hne_ab⟩ := h
    obtain ⟨g, hg_mem, hg_eq⟩ := CT_growth_transitive hk hne ih a 0
    have h0c : r.r 0 (g b) := by
      have := hinv ⟨g, hg_mem⟩ a b hab
      rwa [hg_eq] at this
    have hc_ne : g b ≠ 0 := by
      intro heq
      apply hne_ab
      have := hinv ⟨g, hg_mem⟩ b a (r.iseqv.symm hab)
      rw [hg_eq] at this
      rw [← heq] at this
      exact
        g.injective
          (by rw [hg_eq, heq])
            -- Reduce to a pair within row 0
    obtain ⟨x, hx_ne, hx_row0, hx_rel⟩ := prim_reduce_to_row0 hk hne ih r hinv (g b) hc_ne h0c
    have hrow0 := prim_row0_class hk hne ih r hinv x hx_ne hx_row0 hx_rel
    have hL := prim_cross_row hk hne ih r hinv hrow0
    have hall := prim_extend_all_rows hk hne ih r hinv hrow0 hL
    intro x y
    exact r.iseqv.trans (r.iseqv.symm (hall x)) (hall y)

/-- CT(k+1) contains a `p`-cycle for some prime `p` dividing `k+1`,
with `lcmN(k+1) ≥ p + 3`.

The prime `p` comes from the prime power factorization of `k+1`
(which is a prime power since `lcmN` grows).
The `p`-cycle is constructed from CT generators and synchronized
permutations. The size bound follows from `lcmN(k+1) ≥ k(k-1) ≥ p+3`. -/
lemma lcmN_succ_ge_six {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k) :
    lcmN (k + 1) ≥ 6 := by
  obtain ⟨p, hp, hp', h⟩ := lcmN_growth (by linarith) hne
  nlinarith [hp.two_le,
    show lcmN k ≥ 3 by
      exact
        le_trans (by decide)
          (Nat.le_of_dvd (lcmN_pos)
            (show 3 ∣ lcmN k from
              dvd_trans (by decide)
                (Finset.dvd_lcm
                  (show 3 ∈ Finset.Ioc 0 k from Finset.mem_Ioc.mpr ⟨by decide, by linarith⟩))))]

/-- The commutator `σ * τ * σ * τ` fixes `n` when `σ` and `τ` locally commute at `n`. -/
lemma invol_comm_fix {α : Type*} [DecidableEq α] {σ τ : Equiv.Perm α} (hσ : σ * σ = 1)
    (hτ : τ * τ = 1) {n : α} (h : (τ n = n ∧ τ (σ n) = σ n) ∨ (σ n = n ∧ σ (τ n) = τ n)) :
    (σ * τ * σ * τ) n = n := by
  simp only [Equiv.Perm.mul_apply]
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · rw [h1, h2]
    have : σ (σ n) = n := by
      have := congr_fun (congr_arg (↑·) hσ) n
      simpa [Equiv.Perm.mul_apply] using this
    exact this
  · rw [h2]
    have : τ (τ n) = n := by
      have := congr_fun (congr_arg (↑·) hτ) n
      simpa [Equiv.Perm.mul_apply] using this
    rw [this, h1]

/-- lcmN k ≥ 12 for k ≥ 4. -/
lemma lcmN_ge_12 {k : ℕ} (hk : k ≥ 4) : lcmN k ≥ 12 := by
  have h4 : 4 ∣ lcmN k := dvd_lcmN (by omega) (by omega)
  have h3 : 3 ∣ lcmN k := dvd_lcmN (by omega) (by omega)
  exact Nat.le_of_dvd lcmN_pos (Nat.lcm_dvd h4 h3 |>.trans (by norm_num))

/-- In the composite prime-power case, elements with small column in rows ≥ 1
have `n % (k+1) ≥ 2`. -/
lemma mod_ge_two_of_composite_prime_power {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_not_prime : ¬Nat.Prime (k + 1)) (n : ℕ) (hn_ge : n ≥ lcmN k) (hn_lt : n < lcmN (k + 1))
    (h_col : n % lcmN k ≤ 2) : n % (k + 1) ≥ 2 := by
  obtain ⟨p, m, hp, hm⟩ : ∃ p m : ℕ, Nat.Prime p ∧ m ≥ 2 ∧ k + 1 = p ^ m := by
    have := isPrimePow_of_lcmN_ne (by linarith) hne
    rw [isPrimePow_nat_iff] at this
    obtain ⟨p, m, hp, hm, h⟩ := this
    exact ⟨p, m, hp, Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨hm.ne', by aesop_cat⟩, h.symm⟩
  obtain ⟨q, hq⟩ : ∃ q : ℕ, lcmN k = p ^ (m - 1) * q ∧ Nat.gcd q p = 1 := by
    have h_div : p ^ (m - 1) ∣ lcmN k := by
      have h_div_lcmN : p ^ (m - 1) ≤ k := by
        rcases m with (_ | _ | m) <;> simp_all +decide [pow_succ']
        nlinarith [hp.two_le]
      exact Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨Nat.one_le_pow _ _ hp.pos, h_div_lcmN⟩)
    obtain ⟨q, hq⟩ := h_div
    refine' ⟨q, hq, Nat.Coprime.symm <| hp.coprime_iff_not_dvd.mpr _⟩
    intro hq_div
    have h_contra : p ^ m ∣ lcmN k := by
      exact
        hq.symm ▸ mul_dvd_mul_left _ hq_div |> fun x ↦
          dvd_trans (by cases m <;> simp_all +decide [pow_succ]) x
    exact
      hne (by
          rw [lcmN_succ]
          exact Nat.lcm_eq_left h_contra |> fun h ↦ by aesop)
  obtain ⟨r, c, hr, hc⟩ : ∃ r c : ℕ, n = r * lcmN k + c ∧ 1 ≤ r ∧ r < p ∧ c ≤ 2 := by
    refine' ⟨n / lcmN k, n % lcmN k, _, _, _, h_col⟩
    · rw [Nat.div_add_mod']
    · exact Nat.div_pos hn_ge (Nat.pos_of_ne_zero (by aesop_cat))
    · have h_lcmN_succ : lcmN (k + 1) = p * lcmN k := by
        have := lcmN_growth (by linarith) hne
        obtain ⟨p', hp', hp'_div, hp'_eq⟩ := this
        simp_all +decide
        exact Or.inl (Nat.prime_dvd_prime_iff_eq hp' hp |>.1 (hp'.dvd_of_dvd_pow hp'_div))
      exact Nat.div_lt_of_lt_mul <| by linarith
  have h_mod : r * lcmN k % p ^ m = p ^ (m - 1) * ((r * q) % p) := by
    rcases m with (_ | m) <;> simp_all +decide [pow_succ]
    rw [← Nat.mul_mod_mul_left]
    ring_nf
  have h_mod_ge_one : (r * q) % p ≥ 1 := by
    contrapose! hq
    simp_all +decide
    exact fun h ↦ fun h' ↦
      hp.not_dvd_one <|
        h'.symm ▸
          Nat.dvd_gcd
            (Nat.dvd_of_mod_eq_zero <|
              show q % p = 0 from
                Nat.mod_eq_zero_of_dvd <| by
                  exact
                    Or.resolve_left (hp.dvd_mul.mp <| Nat.dvd_of_mod_eq_zero hq) <|
                      Nat.not_dvd_of_pos_of_lt hc.1 hc.2.1)
            (dvd_refl p)
  rcases m with (_ | _ | m) <;> simp_all +decide [pow_succ']
  rw [Nat.add_mod, h_mod]
  rw [Nat.mod_eq_of_lt]
  · exact
      le_add_of_le_of_nonneg (by
          nlinarith only [h_mod_ge_one, hp.two_le, pow_pos hp.pos m,
            mul_pos hp.pos (pow_pos hp.pos m)])
        (Nat.zero_le _)
  · refine' lt_of_le_of_lt (Nat.add_le_add_left (Nat.mod_le _ _) _) _
    nlinarith [Nat.mul_le_mul_left p (Nat.one_le_pow m p hp.pos), Nat.mod_lt (r * q) hp.pos]

/-- A synchronized swap permutation is an involution. -/
lemma syncPerm_invol_of_swap (N : ℕ) (hN : 0 < N) (M : ℕ) (τ : Equiv.Perm (Fin M)) (a b : Fin N)
    (hτ :
      ∀ n : Fin M,
        (τ n : ℕ) = (n : ℕ) / N * N + (Equiv.swap a b ⟨(n : ℕ) % N, Nat.mod_lt _ hN⟩ : ℕ)) :
    τ * τ = 1 := by
  ext n
  simp [hτ]
  simp [Nat.add_div, hN]
  split_ifs <;> simp_all +decide [Nat.div_eq_of_lt, Nat.mod_eq_of_lt]
  · exact absurd ‹_› (not_le_of_gt (Fin.is_lt _))
  · rw [Nat.div_add_mod']

/-- A permutation mapping `a→b→c→a` and fixing everything else is a 3-cycle. -/
lemma is_three_cycle_of_vals {N : ℕ} {f : Equiv.Perm (Fin N)} {a b c : Fin N} (hab : a ≠ b)
    (hbc : b ≠ c) (hac : a ≠ c) (ha : f a = b) (hb : f b = c) (hc : f c = a)
    (hfix : ∀ n : Fin N, n ≠ a → n ≠ b → n ≠ c → f n = n) : f.IsCycle ∧ f.support.card = 3 := by
  refine' ⟨⟨a, _⟩, _⟩
  · refine' ⟨by aesop, _⟩
    intro y hy
    use if y = a then 0 else if y = b then 1 else if y = c then 2 else 0
    aesop
  · rw [Finset.card_eq_three]
    use a, b, c
    simp_all +decide [Finset.ext_iff, Equiv.Perm.support]
    grind

/-- `lcmRepeat` of a swap is an involution. -/
lemma lcmRepeat_swap_sq {k d : ℕ} (hd : d ≤ k) (hd' : 0 < d) (a b : Fin d) :
    (Equiv.swap a b).lcmRepeat hd hd' * (Equiv.swap a b).lcmRepeat hd hd' = 1 := by
  ext n
  simp [Equiv.Perm.lcmRepeat, Equiv.Perm.classRepeat]

/-- Synchronized swap fixes `n` when `n % L ∉ {a, b}`. -/
lemma sync_swap_fix {M L : ℕ} (hL : 0 < L) (τ : Equiv.Perm (Fin M)) (a b : Fin L)
    (hτ :
      ∀ n : Fin M,
        (τ n : ℕ) = (n : ℕ) / L * L + (Equiv.swap a b ⟨(n : ℕ) % L, Nat.mod_lt _ hL⟩ : ℕ))
    (n : Fin M) (ha : (n : ℕ) % L ≠ (a : ℕ)) (hb : (n : ℕ) % L ≠ (b : ℕ)) : τ n = n := by
  refine' Fin.ext _
  simp_all +decide [Equiv.swap_apply_def]
  split_ifs <;> simp_all +decide [Fin.ext_iff]
  linarith [Nat.mod_add_div n L]

/-- `lcmRepeat` swap fixes `n` when `n % d ∉ {a, b}`. -/
lemma lcmRepeat_swap_fix {M d : ℕ} (hd : 0 < d) (σ : Equiv.Perm (Fin M)) (a b : Fin d)
    (hσ :
      ∀ n : Fin M,
        (σ n : ℕ) = (n : ℕ) / d * d + (Equiv.swap a b ⟨(n : ℕ) % d, Nat.mod_lt _ hd⟩ : ℕ))
    (n : Fin M) (ha : (n : ℕ) % d ≠ (a : ℕ)) (hb : (n : ℕ) % d ≠ (b : ℕ)) : σ n = n := by
  rw [← Fin.val_eq_val, hσ]
  erw [Equiv.swap_apply_def]
  simp [Fin.ext_iff, ha, hb]
  rw [Nat.div_add_mod']

/-- In the composite case, if `col ≥ 3` and `n % (k+1) = 0`, then `(n+1) % L ∉ {0, 2}`. -/
lemma composite_col_plus1 {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_not_prime : ¬Nat.Prime (k + 1)) (n : ℕ) (h_col : n % lcmN k ≥ 3)
    (h_mod : n % (k + 1) = 0) : (n + 1) % lcmN k ≠ 0 ∧ (n + 1) % lcmN k ≠ 2 := by
  -- Since k+1 is a prime power p^m with m≥2, lcmN k is divisible by p^(m-1).
  obtain ⟨p, m, hp, hm⟩ : ∃ p m, Nat.Prime p ∧ m ≥ 2 ∧ k + 1 = p ^ m := by
    have := isPrimePow_of_lcmN_ne (by linarith) hne
    rw [isPrimePow_nat_iff] at this
    rcases this with ⟨p, m, hp, hm, h⟩
    exact ⟨p, m, hp, Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨hm.ne', by aesop_cat⟩, h.symm⟩
  have h_div_lcm : p ^ (m - 1) ∣ lcmN k := by
    refine' Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨_, _⟩)
    · exact pow_pos hp.pos _
    · rcases m with (_ | _ | m) <;> simp_all +decide [pow_succ']
      nlinarith [hp.two_le]
  have h_div_k1 : p ^ (m - 1) ∣ (k + 1) := by exact hm.2.symm ▸ pow_dvd_pow _ (Nat.pred_le _)
  have h_mod_eq : (n % lcmN k) % p ^ (m - 1) = 0 := by
    rw [Nat.mod_mod_of_dvd _ h_div_lcm,
      Nat.mod_eq_zero_of_dvd (dvd_trans h_div_k1 (Nat.dvd_of_mod_eq_zero h_mod))]
  constructor <;> intro h <;> have := Nat.dvd_of_mod_eq_zero h_mod_eq <;>
    simp_all +decide [Nat.dvd_iff_mod_eq_zero]
  · have := Nat.dvd_of_mod_eq_zero h
    obtain ⟨q, hq⟩ := this
    replace hq := congr_arg (· % p ^ (m - 1)) hq
    simp_all +decide [Nat.add_mod, Nat.mul_mod]
    exact absurd (hq.resolve_left hp.ne_one) (Nat.sub_ne_zero_of_lt hm.1)
  · have := Nat.mod_mod_of_dvd (n + 1) (Nat.dvd_of_mod_eq_zero h_div_lcm)
    simp_all +decide [Nat.add_mod]
    rcases m with (_ | _ | m) <;> simp_all +decide [Nat.pow_succ']
    rw [Nat.mod_eq_of_lt, Nat.mod_eq_of_lt] at this <;> nlinarith [hp.two_le, pow_pos hp.pos m]

/-- In the composite case, if `col ≥ 3` and `n % (k+1) = 1`, then `(n-1) % L ∉ {0, 2}`. -/
lemma composite_col_minus1 {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_not_prime : ¬Nat.Prime (k + 1)) (n : ℕ) (h_col : n % lcmN k ≥ 3)
    (h_mod : n % (k + 1) = 1) : (n - 1) % lcmN k ≠ 0 ∧ (n - 1) % lcmN k ≠ 2 := by
  have h_d :
    ∃ p m, k + 1 = p ^ m ∧ m ≥ 2 ∧ p.Prime ∧ p ^ (m - 1) ∣ lcmN k ∧ p ^ (m - 1) ∣ (k + 1) := by
    obtain ⟨p, m, hp, hm, h_prime⟩ : ∃ p m, k + 1 = p ^ m ∧ m ≥ 2 ∧ p.Prime := by
      have h_prime_power : IsPrimePow (k + 1) := by
        exact isPrimePow_of_lcmN_ne (by linarith) hne
      rw [isPrimePow_nat_iff] at h_prime_power
      obtain ⟨p, m, hp, hm, h⟩ := h_prime_power
      exact ⟨p, m, h.symm, Nat.one_lt_iff_ne_zero_and_ne_one.mpr ⟨hm.ne', by aesop_cat⟩, hp⟩
    refine' ⟨p, m, hp, hm, h_prime, _, _⟩
    · refine' Finset.dvd_lcm (Finset.mem_Ioc.mpr ⟨Nat.one_le_pow _ _ h_prime.pos, _⟩)
      rcases m with (_ | _ | m) <;> simp_all +decide [pow_succ']
      nlinarith [h_prime.two_le]
    · exact hp.symm ▸ pow_dvd_pow _ (Nat.pred_le _)
  obtain ⟨p, m, hpm, hm, hp, hplcm, hpk⟩ := h_d
  have h_col_mod : (n % lcmN k) % p ^ (m - 1) = 1 := by
    rw [Nat.mod_mod_of_dvd _ hplcm, ← Nat.mod_mod_of_dvd _ hpk, h_mod]
    rw [Nat.mod_eq_of_lt (one_lt_pow₀ hp.one_lt (Nat.sub_ne_zero_of_lt hm))]
  have h_col_mod_n_minus_1 : ((n - 1) % lcmN k) % p ^ (m - 1) = 0 := by
    rw [← Nat.mod_add_div n (lcmN k), ← Nat.mod_add_div (n % lcmN k) (p ^ (m - 1))] at *
    simp_all +decide
    norm_num [add_assoc, Nat.add_mod, Nat.mul_mod, Nat.mod_eq_zero_of_dvd hplcm]
  constructor <;> intro con <;> simp_all +decide only [Nat.dvd_iff_mod_eq_zero]
  · rcases n <;> simp_all +decide
    simp_all +decide [Nat.add_mod]
    rw [Nat.mod_eq_of_lt] at h_col <;>
      linarith [show lcmN k > 1 from lt_of_lt_of_le (by decide) (lcmN_ge_12 hk)]
  · rcases m with (_ | _ | m) <;> simp_all +decide [Nat.pow_succ']
    rw [Nat.mod_eq_of_lt] at h_col_mod_n_minus_1 <;>
      nlinarith [hp.two_le, Nat.mul_le_mul_left p (Nat.one_le_pow m p hp.pos)]

/-- `CT(k+1)` contains a 3-cycle in the composite growth case. -/
lemma CT_growth_three_cycle_composite {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (ih : CT k = ⊤) (h_not_prime : ¬Nat.Prime (k + 1)) :
    ∃ σ ∈ CT (k + 1), σ.IsCycle ∧ σ.support.card = 3 := by
  have hd_pos : (0 : ℕ) < k + 1 := by omega
  set σ := (Equiv.swap (0 : Fin (k + 1)) 1).lcmRepeat (le_refl _) hd_pos
  have hσ_mem : σ ∈ CT (k + 1) := lcmRepeat_mem_CT (le_refl _) hd_pos (by omega) 0 1
  have hσ_val :
    ∀ n : Fin (lcmN (k + 1)),
      (σ n : ℕ) =
        (n : ℕ) / (k + 1) * (k + 1) +
          (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ hd_pos⟩ : ℕ) :=
    fun n ↦ lcmRepeat_val (le_refl _) hd_pos _ n
  obtain ⟨τ, hτ_mem, hτ_val⟩ :=
    syncPerm_mem_CT (show 2 ≤ k by omega) hne ih (Equiv.swap (0 : Fin (lcmN k)) 2)
  set g := σ * τ * σ * τ
  have hg_mem : g ∈ CT (k + 1) :=
    (CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem ((CT (k + 1)).mul_mem hσ_mem hτ_mem) hσ_mem)
      hτ_mem
  have hσ_sq : σ * σ = 1 := lcmRepeat_swap_sq (le_refl _) hd_pos 0 1
  have hτ_sq : τ * τ = 1 := syncPerm_invol_of_swap (lcmN k) lcmN_pos _ τ 0 2 hτ_val
  have hN_ge : lcmN (k + 1) ≥ 6 := lcmN_succ_ge_six hk hne
  set a : Fin (lcmN (k + 1)) := ⟨0, by omega⟩
  set b : Fin (lcmN (k + 1)) := ⟨1, by omega⟩
  set c : Fin (lcmN (k + 1)) := ⟨2, by omega⟩
  have ha : g a = b := by
    have h_tau_a : τ a = ⟨2, by linarith⟩ := by
      simp +zetaDelta at *
      ext
      simp [hτ_val]
      rw [Nat.mod_eq_of_lt (by linarith [lcmN_ge_12 hk])]
    have h_sigma_tau_a : σ (τ a) = τ a := by
      rw [← Fin.val_eq_val]
      simp [*, Equiv.swap_apply_def]
      rcases k with (_ | _ | _ | k) <;> simp +arith +decide [Nat.mod_eq_of_lt] at *
    have h_sigma_a : σ a = b := by
      ext
      simp [a, b, hσ_val]
      linarith
    replace hσ_sq := congr_arg (fun f ↦ f a) hσ_sq
    replace hτ_sq := congr_arg (fun f ↦ f a) hτ_sq
    aesop
  have hb : g b = c := by
    have hb : τ b = b := by
      have hb_mod : (b : ℕ) % lcmN k = 1 := by
        exact Nat.mod_eq_of_lt (show 1 < lcmN k from Nat.le_trans (by decide) (lcmN_ge_12 hk))
      ext
      simp [hτ_val, hb_mod]
      norm_num [Fin.ext_iff, Equiv.swap_apply_def]
      rw [Nat.mod_eq_of_lt] <;> norm_num
      · exact Or.inl <| Or.inr <| Nat.lt_of_lt_of_le (by decide) <| lcmN_ge_12 <| by linarith
      · exact lt_of_lt_of_le (by decide) (lcmN_ge_12 (by linarith))
    have hc : σ b = a := by
      rw [Fin.ext_iff, hσ_val]
      norm_num
      exact ⟨by linarith, by rcases k with (_ | _ | k) <;> trivial⟩
    have hd : τ a = c := by
      refine' Fin.ext _
      simp [hτ_val, a, c]
      rw [Nat.mod_eq_of_lt]
      linarith [lcmN_ge_12 hk]
    simp [g, hb, hc, hd]
    rw [← Fin.val_inj, hσ_val]
    norm_num [Nat.mod_eq_of_lt]
    rcases k with (_ | _ | _ | _ | k) <;> simp +arith +decide [Nat.mod_eq_of_lt] at *
    rw [Nat.div_eq_of_lt] <;> norm_num [Equiv.swap_apply_def]
  have hc : g c = a := by
    -- Apply τ to c, which gives 0.
    have hτc : τ c = a := by
      refine' Fin.ext _
      rcases k with (_ | _ | _ | _ | k) <;> simp +arith +decide at *
      simp [hτ_val, c, a]
      exact
        ⟨by erw [Equiv.swap_apply_right],
          Or.inl <|
            Or.inr <| by
              linarith [show lcmN (k + 4) ≥ 6 by
                  exact Nat.le_trans (by decide) <| lcmN_ge_12 <| Nat.le_add_left _ _]⟩
    generalize_proofs at *
    have hσa : σ a = b := by
      specialize hσ_val a
      simp_all +decide
      simp +zetaDelta at *
      exact
        Fin.ext (by
            rw [hσ_val, Nat.mod_eq_of_lt]
            linarith)
    generalize_proofs at *
    simp +zetaDelta at *
    simp_all +decide [Equiv.Perm.ext_iff]
    grind +revert
  have hσ_val_0 : ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % (k + 1) = 0 → (σ n : ℕ) = (n : ℕ) + 1 := by
    intro n hn
    rw [hσ_val]
    simp [hn]
    rw [Nat.div_mul_cancel (Nat.dvd_of_mod_eq_zero hn), Nat.mod_eq_of_lt (by linarith)]
  have hσ_val_1 : ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % (k + 1) = 1 → (σ n : ℕ) = (n : ℕ) - 1 := by
    intro n hn
    specialize hσ_val_0 n
    specialize hσ_val_0
    specialize hσ_val n
    simp_all +decide [Equiv.swap_apply_def]
    simp +decide [Fin.ext_iff] at hσ_val ⊢
    rw [Nat.mod_eq_of_lt] <;> norm_num
    · exact eq_tsub_of_add_eq (by linarith [Nat.mod_add_div n (k + 1)])
    · linarith
  have hτ_fix :
    ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % lcmN k ≠ 0 → (n : ℕ) % lcmN k ≠ 2 → τ n = n := by
    intros n hn0 hn2
    have h_mod : (τ n).val = n.val := by
      rw [hτ_val, Equiv.swap_apply_def]
      simp [hn0]
      split_ifs <;> simp_all +decide [Fin.ext_iff]
      · exact False.elim <| hn2 <| Nat.mod_eq_of_lt <| by linarith [lcmN_ge_12 hk]
      · rw [Nat.div_add_mod']
    exact Fin.ext h_mod
  have hσ_fix : ∀ n : Fin (lcmN (k + 1)), (n : ℕ) % (k + 1) ≥ 2 → σ n = n := by
    intro n hn
    have h0 : (n : ℕ) % (k + 1) ≠ ((0 : Fin (k + 1)) : ℕ) := by
      simp
      omega
    have h1 : (n : ℕ) % (k + 1) ≠ ((1 : Fin (k + 1)) : ℕ) := by
      have : ((1 : Fin (k + 1)) : ℕ) = 1 := by simp [Nat.mod_eq_of_lt (by omega : 1 < k + 1)]
      omega
    exact lcmRepeat_swap_fix (by omega : (0 : ℕ) < k + 1) σ 0 1 hσ_val n h0 h1
  have hfix : ∀ n : Fin (lcmN (k + 1)), n ≠ a → n ≠ b → n ≠ c → g n = n := by
    intro n hna hnb hnc
    have hn_ge3 : (n : ℕ) ≥ 3 := by
      have : (n : ℕ) ≠ 0 := fun h ↦ hna (Fin.ext h)
      have : (n : ℕ) ≠ 1 := fun h ↦ hnb (Fin.ext h)
      have : (n : ℕ) ≠ 2 := fun h ↦ hnc (Fin.ext h)
      omega
    apply invol_comm_fix hσ_sq hτ_sq
    by_cases h_col : (n : ℕ) % lcmN k ≥ 3
    · -- Case 1: column ≥ 3 → use Left (τ fixes n, τ fixes σ n)
      left
      constructor
      · exact hτ_fix n (by omega) (by omega)
      · -- Need: τ fixes σ(n)
        by_cases hmod0 : (n : ℕ) % (k + 1) = 0
        · -- σ(n) has value n+1, and (n+1) % lcmN k ∉ {0,2}
          have := composite_col_plus1 hk hne h_not_prime (n : ℕ) h_col hmod0
          have hσn_val : (σ n : ℕ) = (n : ℕ) + 1 := hσ_val_0 n hmod0
          have hσn_mod_ne0 : (σ n : ℕ) % lcmN k ≠ 0 := by
            rw [hσn_val]
            exact this.1
          have hσn_mod_ne2 : (σ n : ℕ) % lcmN k ≠ 2 := by
            rw [hσn_val]
            exact this.2
          exact hτ_fix (σ n) hσn_mod_ne0 hσn_mod_ne2
        · by_cases hmod1 : (n : ℕ) % (k + 1) = 1
          · -- σ(n) has value n-1, and (n-1) % lcmN k ∉ {0,2}
            have := composite_col_minus1 hk hne h_not_prime (n : ℕ) h_col hmod1
            have hσn_val : (σ n : ℕ) = (n : ℕ) - 1 := hσ_val_1 n hmod1
            have hσn_mod_ne0 : (σ n : ℕ) % lcmN k ≠ 0 := by
              rw [hσn_val]
              exact this.1
            have hσn_mod_ne2 : (σ n : ℕ) % lcmN k ≠ 2 := by
              rw [hσn_val]
              exact this.2
            exact hτ_fix (σ n) hσn_mod_ne0 hσn_mod_ne2
          · -- n % (k+1) ≥ 2, so σ fixes n
            have : (n : ℕ) % (k + 1) ≥ 2 := by omega
            rw [hσ_fix n this]
            exact hτ_fix n (by omega) (by omega)
    · -- Case 2: column ≤ 2 → n ≥ lcmN k → use Right (σ fixes n, σ fixes τ n)
      push_neg at h_col
      right
      have hn_ge_lcmN : (n : ℕ) ≥ lcmN k := by
        by_contra h
        push_neg at h
        have : (n : ℕ) % lcmN k = (n : ℕ) := Nat.mod_eq_of_lt h
        omega
      constructor
      · exact
          hσ_fix n
            (mod_ge_two_of_composite_prime_power hk hne h_not_prime (n : ℕ) hn_ge_lcmN n.isLt
              (by omega))
      · -- Need: σ fixes τ(n)
        have hτn_ge : (τ n : ℕ) ≥ lcmN k := by
          rw [hτ_val]
          have := Nat.div_pos hn_ge_lcmN lcmN_pos
          nlinarith [Nat.zero_le
              ((↑(Equiv.swap (0 : Fin (lcmN k)) 2 ⟨↑n % lcmN k, Nat.mod_lt _ lcmN_pos⟩) : ℕ))]
        have hτn_mod : (τ n : ℕ) % lcmN k ≤ 2 := by
          have h_mod_cases : ∀ x : Fin (lcmN k), x.val < 3 → (Equiv.swap 0 2 x).val ≤ 2 := by
            -- By definition of swap, we know that swapping 0 and 2 will either keep x the same or swap it with 0 or 2.
            intros x hx
            simp [Equiv.swap_apply_def]
            split_ifs <;> norm_num [Fin.ext_iff]
            · exact Nat.mod_le _ _
            · linarith
          simp [*, Nat.add_mod, Nat.mod_eq_of_lt]
        exact
          hσ_fix _
            (mod_ge_two_of_composite_prime_power hk hne h_not_prime _ hτn_ge (τ n).isLt hτn_mod)
  exact
    ⟨g, hg_mem,
      is_three_cycle_of_vals (by simp [a, b]) (by simp [b, c]) (by simp [a, c]) ha hb hc hfix⟩

/-! ### Prime commutator proof -/

/-- When `k+1` is prime and `lcmN` grows, `lcmN(k+1) = (k+1) * lcmN(k)`. -/
lemma lcmN_succ_prime {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_prime : Nat.Prime (k + 1)) : lcmN (k + 1) = (k + 1) * lcmN k := by
  have := lcmN_growth (by linarith) hne
  obtain ⟨p, hp₁, hp₂, hp₃⟩ := this
  rw [Nat.prime_dvd_prime_iff_eq] at hp₂ <;> aesop

/-- When `k+1` is prime and `lcmN` grows, `gcd(k+1, lcmN k) = 1`. -/
lemma coprime_prime_lcmN {k : ℕ} (hk : k ≥ 4) (hne : lcmN (k + 1) ≠ lcmN k)
    (h_prime : Nat.Prime (k + 1)) : Nat.Coprime (k + 1) (lcmN k) := by
  refine' h_prime.coprime_iff_not_dvd.mpr _
  exact not_dvd_lcmN_of_ne hne

/-- CRT existence for `Fin (p * L)`. -/
lemma crt_fin_exists {p L : ℕ} (hp : 0 < p) (hL : 0 < L) (hcop : Nat.Coprime p L)
    (a : ℕ) (ha : a < p) (b : ℕ) (hb : b < L) :
    ∃ n : Fin (p * L), n.val % p = a ∧ n.val % L = b := by
  obtain ⟨n, hn⟩ := Nat.chineseRemainder hcop a b
  use ⟨n % (p * L), Nat.mod_lt _ (Nat.mul_pos hp hL)⟩
  simp_all +decide [Nat.ModEq, Nat.mod_eq_of_lt]

/-- CRT uniqueness for `Fin (p * L)`. -/
lemma crt_fin_unique {p L : ℕ} (hp : 0 < p) (hL : 0 < L) (hcop : Nat.Coprime p L)
    (n m : Fin (p * L)) (h : n.val % p = m.val % p ∧ n.val % L = m.val % L) : n = m := by
  have h_crt : (n.val : ℕ) ≡ (m.val : ℕ) [MOD (p * L)] := by
    rw [← Nat.modEq_and_modEq_iff_modEq_mul]
    tauto
    assumption
  exact Fin.ext (Nat.mod_eq_of_lt n.2 ▸ Nat.mod_eq_of_lt m.2 ▸ h_crt)

/-!
In the prime case, orbit cancellation extracts a single 3-cycle from the commutator.
- `result = g * g'' * g''` cancels shared orbits, leaving one 3-cycle.
-/

/-- Trichotomy for the `swap (0, 1) (k+1)` class transposition: at every point `n`, either it
fixes `n`, or `σ₀ n = n + 1`, or `σ₀ n + 1 = n`. -/
lemma swap01_lcmRepeat_val_trichotomy {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) :
    (σ₀ n).val = n.val ∨ (σ₀ n).val = n.val + 1 ∨ (σ₀ n).val + 1 = n.val := by
  rcases n with ⟨_ | _ | n, hn⟩ <;> simp +arith +decide at *
  · norm_num [Fin.ext_iff, hσ₀]
    exact eq_or_lt_of_le' (Nat.zero_le _)
  · rcases k with (_ | _ | k) <;> simp_all +arith +decide [Nat.div_eq_of_lt]
    · contradiction
    · native_decide +revert
    · simp_all +decide [Fin.ext_iff, Equiv.swap_apply_def]
  · erw [hσ₀]
    rcases k with (_ | _ | k) <;> simp +arith +decide at *
    · rcases n with (_ | _ | n) <;> tauto
    · rw [Equiv.swap_apply_def]
      norm_num
      split_ifs <;> simp_all +arith +decide
      · exact Or.inr <| Or.inl <| by linarith [Nat.mod_add_div (n + 2) (k + 3)]
      · exact Or.inr <| Or.inr <| by linarith [Nat.mod_add_div (n + 2) (k + 3)]
      · exact Or.inl (by rw [Nat.mod_add_div'])

/-- If `n % L = 5` and `m` differs by at most 1, then `m % L ∉ {0, 2}`. -/
lemma mod_ne_zero_two_of_close {L n m : ℕ} (hL : L ≥ 7) (hn : n % L = 5)
    (hm : m = n ∨ m = n + 1 ∨ m + 1 = n) : m % L ≠ 0 ∧ m % L ≠ 2 := by
  rcases hm with (rfl | rfl | hm) <;> simp [Nat.add_mod, hn]
  · rcases L with (_ | _ | _ | _ | _ | _ | _ | L) <;> simp_all +arith +decide [Nat.mod_eq_of_lt]
  · constructor <;> intro con <;> have := Nat.mod_add_div n L <;>
        have := Nat.mod_add_div m L <;> simp_all +decide
    · nlinarith [show n / L = m / L by nlinarith]
    · nlinarith [show n / L = m / L by nlinarith]

/-- If `n % L = L-1` and `m` differs by at most 1 (without wrapping), then `m % L ∉ {0, 2}`. -/
lemma mod_ne_zero_two_of_close_Lm1 {L n m : ℕ} (hL : L ≥ 7) (hn : n % L = L - 1)
    (hm : m = n ∨ m + 1 = n) : m % L ≠ 0 ∧ m % L ≠ 2 := by
  rcases hm with (rfl | hm) <;> rcases L with (_ | _ | L) <;> simp_all +arith +decide
  · grind
  · constructor <;> intro h <;> have := congr_arg (· % (L + 2)) hm <;>
      norm_num [Nat.add_mod, h, hn] at this
    · linarith
    · rcases L with (_ | _ | L) <;> cases this
      · contradiction
      · contradiction

/-- `σ₀` does not increase `n` when `p ≠ 0`. -/
lemma swap01_no_inc {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) ≠ 0) :
    (σ₀ n).val = n.val ∨ (σ₀ n).val + 1 = n.val := by
  rw [← Nat.mod_add_div n (k + 1)]
  rcases n : n.val % (k + 1) with (_ | _ | n) <;> simp_all +decide [Equiv.swap_apply_def]
  · simp [add_comm, mul_comm]
    grobner
  · simp [Fin.ext_iff, mul_comm]
    cases k <;> simp_all +arith +decide [Nat.mod_eq_of_lt]

/-- `h₁` maps `l = 5` to `l = L-1`. -/
lemma swap_lcmk_5_to_Lm1 {k : ℕ} (hk : k ≥ 4) (h₁ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hh₁ :
      ∀ n : Fin (lcmN (k + 1)),
        (h₁ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (⟨5, by linarith [lcmN_ge_12 hk]⟩ : Fin (lcmN k))
                ⟨lcmN k - 1, Nat.sub_one_lt_of_le (by linarith [lcmN_ge_12 hk]) (le_refl _)⟩
                ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ :
              ℕ))
    (n : Fin (lcmN (k + 1))) (hn : n.val % lcmN k = 5) : (h₁ n).val % lcmN k = lcmN k - 1 := by
  simp_all +decide [Equiv.swap_apply_def]

/-- `h₁` maps `l = L-1` to `l = 5`. -/
lemma swap_lcmk_Lm1_to_5 {k : ℕ} (hk : k ≥ 4) (h₁ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hh₁ :
      ∀ n : Fin (lcmN (k + 1)),
        (h₁ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (⟨5, by linarith [lcmN_ge_12 hk]⟩ : Fin (lcmN k))
                ⟨lcmN k - 1, Nat.sub_one_lt_of_le (by linarith [lcmN_ge_12 hk]) (le_refl _)⟩
                ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ :
              ℕ))
    (n : Fin (lcmN (k + 1))) (hn : n.val % lcmN k = lcmN k - 1) : (h₁ n).val % lcmN k = 5 := by
  rcases x : lcmN k with (_ | _ | _ | _ | _ | _ | k) <;>
    simp_all +arith +decide [Nat.mod_eq_of_lt]
  · linarith [show lcmN k ≥ 12 by exact lcmN_ge_12 hk]
  · exact absurd x (by linarith [lcmN_ge_12 hk])
  · exact absurd x (by linarith [lcmN_ge_12 hk])
  · exact absurd x (by linarith [show lcmN k ≥ 12 by exact lcmN_ge_12 hk])
  · exact absurd x (by linarith [lcmN_ge_12 hk])

/-- CRT: elements of `Fin(lcmN(k+1))` are determined by residues mod `(k+1)` and `lcmN(k)`. -/
lemma fin_lcmN_eq_of_mod_eq {k : ℕ} (a b : Fin (lcmN (k + 1)))
    (hp : a.val % (k + 1) = b.val % (k + 1)) (hL : a.val % lcmN k = b.val % lcmN k) : a = b := by
  have h_cong : (a : ℕ) % lcmN (k + 1) = (b : ℕ) % lcmN (k + 1) := by
    rw [Nat.modEq_of_dvd]
    have h_eq : (k + 1 : ℤ) ∣ (b.val - a.val : ℤ) ∧ (lcmN k : ℤ) ∣ (b.val - a.val : ℤ) := by
      exact ⟨by simpa using Nat.modEq_iff_dvd.mp hp, by simpa using Nat.modEq_iff_dvd.mp hL⟩
    convert Int.coe_lcm_dvd h_eq.1 h_eq.2 using 1
    norm_cast
    exact lcmN_succ k ▸ Nat.lcm_comm _ _
  exact Fin.ext (Nat.mod_eq_of_lt a.2 ▸ Nat.mod_eq_of_lt b.2 ▸ h_cong)

/-- `σ₀` adds 1 when `n % (k+1) = 0`. -/
lemma swap01_block_val_p0 {k : ℕ} (hk : k ≥ 1) (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) = 0) : (σ₀ n).val = n.val + 1 := by
  -- Substitute n % (k + 1) = 0 into the expression for σ₀ n.
  simp [hσ₀, hp]
  rw [Nat.div_mul_cancel (Nat.dvd_of_mod_eq_zero hp), Nat.mod_eq_of_lt]
  linarith

/-- `σ₀` subtracts 1 when `n % (k+1) = 1`. -/
lemma swap01_block_val_p1 {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) = 1) : (σ₀ n).val = n.val - 1 := by
  rw [← Nat.mod_add_div n (k + 1), hp]
  rcases k with (_ | _ | k) <;> simp_all +arith +decide [Nat.div_eq_of_lt]
  ring

/-- `τ₀` adds 2 when `n % lcmN(k) = 0`. -/
lemma swap02_block_val_L0 {k : ℕ} (hk : k ≥ 3) (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hL : n.val % lcmN k = 0) : (τ₀ n).val = n.val + 2 := by
  rcases k with (_ | _ | _ | k) <;> simp_all +arith +decide
  rw [Nat.mod_eq_of_lt]
  · linarith [Nat.mod_add_div n (lcmN (k + 3))]
  · refine'
      lt_of_lt_of_le _
        (Nat.le_of_dvd _ <|
          Finset.dvd_lcm <|
            show k + 3 ∈ Finset.Ioc 0 (k + 3) from Finset.mem_Ioc.mpr ⟨Nat.succ_pos _, le_rfl⟩)
    norm_num
    exact lcmN_pos

/-- `τ₀` subtracts 2 when `n % lcmN(k) = 2`. -/
lemma swap02_block_val_L2 {k : ℕ} (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hL : n.val % lcmN k = 2) : (τ₀ n).val = n.val - 2 := by
  simp_all +decide [Equiv.swap_apply_def]
  simp [← hL, Fin.ext_iff]
  exact Eq.symm (Nat.sub_eq_of_eq_add <| by linarith [Nat.mod_add_div n (lcmN k)])

/-- `σ₀` fixes `n` when `n % (k+1) ≥ 2`. -/
lemma swap01_fix_of_mod_ge_2 {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) ≥ 2) : σ₀ n = n := by
  ext
  rw [hσ₀, Equiv.swap_apply_def]
  split_ifs <;> simp_all +decide [Fin.ext_iff]
  · cases k <;> contradiction
  · rw [Nat.div_add_mod']

/-- `τ₀` fixes `n` when `n % lcmN(k) ∉ {0, 2}`. -/
lemma swap02_fix_of_mod_ne_0_2 {k : ℕ} (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (h0 : n.val % lcmN k ≠ 0) (h2 : n.val % lcmN k ≠ 2) : τ₀ n = n := by
  refine' Fin.ext _
  rw [hτ₀, Equiv.swap_apply_def]
  split_ifs <;> simp_all +decide [Fin.ext_iff]
  · rcases x : lcmN k with (_ | _ | _ | k) <;> simp_all +arith +decide [Nat.mod_eq_of_lt]
  · rw [Nat.div_add_mod']

/-- `σ₀` maps `p = 0` to `p = 1`. -/
lemma swap01_mod_p_of_p0 {k : ℕ} (hk : k ≥ 1) (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) = 0) : (σ₀ n).val % (k + 1) = 1 := by
  simp [*, Nat.add_mod]
  linarith

/-- `σ₀` maps `p = 1` to `p = 0`. -/
lemma swap01_mod_p_of_p1 {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) = 1) : (σ₀ n).val % (k + 1) = 0 := by
  rcases k with (_ | _ | k) <;> simp_all +decide [Equiv.swap_apply_def]

/-- `σ₀` preserves `p` when `p ≥ 2`. -/
lemma swap01_mod_p_of_p_ge_2 {k : ℕ} (σ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hp : n.val % (k + 1) ≥ 2) :
    (σ₀ n).val % (k + 1) = n.val % (k + 1) := by
  -- From swap01_fix_of_mod_ge_2, σ₀ n = n, so (σ₀ n).val % (k+1) = n.val % (k+1).
  have hσ₀_n_eq_n : σ₀ n = n := by
    apply swap01_fix_of_mod_ge_2
    assumption
    assumption
  rw [hσ₀_n_eq_n]

/-- `τ₀` maps `l = 0` to `l = 2`. -/
lemma swap02_mod_L_of_L0 {k : ℕ} (hk : k ≥ 3) (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hl : n.val % lcmN k = 0) : (τ₀ n).val % lcmN k = 2 := by
  rcases k with (_ | _ | _ | k) <;> simp_all +arith +decide
  rw [Nat.mod_eq_of_lt]
  exact
    lt_of_lt_of_le (by decide)
      (Nat.le_of_dvd
        (by exact Nat.pos_of_ne_zero (by exact mt Finset.lcm_eq_zero_iff.mp (by aesop)))
        (Finset.dvd_lcm
          (Finset.mem_Icc.mpr ⟨by linarith, by linarith⟩ : 3 ∈ Finset.Icc 1 (k + 3))))

/-- `τ₀` maps `l = 2` to `l = 0`. -/
lemma swap02_mod_L_of_L2 {k : ℕ} (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (n : Fin (lcmN (k + 1))) (hl : n.val % lcmN k = 2) : (τ₀ n).val % lcmN k = 0 := by
  simp [hτ₀, hl, Equiv.swap_apply_def]
  norm_num [Fin.ext_iff]
  rcases k with (_ | _ | _ | _ | k) <;> simp_all +arith +decide [Nat.mod_eq_of_lt]
  rw [Nat.mod_eq_of_lt (by
        linarith [show lcmN (k + 4) > 2 from
            lt_of_lt_of_le (by decide) (lcmN_ge_12 (by linarith))])]

/-- `τ₀` preserves `l` when `l ∉ {0, 2}`. -/
lemma swap02_mod_L_of_L_ne_0_2 {k : ℕ} (τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
