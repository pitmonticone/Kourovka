/-- `ct2_01` belongs to `CT 4`. -/
lemma mem_ct2_01 : ct2_01 ∈ CT 4 :=
  lcmRepeat_mem_CT (by omega) (by omega) (by omega) _ _

/-- `ct3_01` belongs to `CT 4`. -/
lemma mem_ct3_01 : ct3_01 ∈ CT 4 :=
  lcmRepeat_mem_CT (by omega) (by omega) (by omega) _ _

