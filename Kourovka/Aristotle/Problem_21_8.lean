lemma st_period3_l0 {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Equiv.Perm (Fin (lcmN (k + 1))))
    (hσ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (σ₀ n : ℕ) =
          (n : ℕ) / (k + 1) * (k + 1) +
            (Equiv.swap (0 : Fin (k + 1)) 1 ⟨(n : ℕ) % (k + 1), Nat.mod_lt _ (by omega)⟩ : ℕ))
    (hτ₀ :
      ∀ n : Fin (lcmN (k + 1)),
        (τ₀ n : ℕ) =
          (n : ℕ) / lcmN k * lcmN k +
            (Equiv.swap (0 : Fin (lcmN k)) 2 ⟨(n : ℕ) % lcmN k, Nat.mod_lt _ lcmN_pos⟩ : ℕ))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin (lcmN (k + 1)))
    (hl : m.val % lcmN k = 0) (hm_not_p1 : σ₀ (τ₀ m) ≠ m)
    (hm_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ m))) ≠ m) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  by_cases hp : m.val % (k + 1) ≥ 2
  · have hp' : (τ₀ m).val % (k + 1) = (m.val % (k + 1) + 2) % (k + 1) := by
      convert swap02_mod_p_of_L0 (show k ≥ 3 by linarith) τ₀ hτ₀ m hl using 1
    by_cases hp'' : (τ₀ m).val % (k + 1) ≥ 2
    · have h_contradiction : σ₀ (τ₀ m) = τ₀ m := by
        exact swap01_fix_of_mod_ge_2 σ₀ hσ₀ (τ₀ m) hp''
      have h_contradiction : σ₀ (τ₀ (τ₀ m)) = σ₀ m := by
        rw [show τ₀ (τ₀ m) = m from by simpa [eq_comm] using congr_arg (fun f ↦ f m) hτ₀_sq]
      have h_contradiction : σ₀ m = m := by exact swap01_fix_of_mod_ge_2 σ₀ hσ₀ m hp
      grind +splitImp
    · have h_div : (k + 1) ∣ (m.val % (k + 1) + 2) ∨ (k + 1) ∣ (m.val % (k + 1) + 1) := by
        have h_div :
          (m.val % (k + 1) + 2) % (k + 1) = 0 ∨ (m.val % (k + 1) + 2) % (k + 1) = 1 := by omega
        exact
          Or.imp (fun h ↦ Nat.dvd_of_mod_eq_zero h)
            (fun h ↦
              ⟨(m % (k + 1) + 2) / (k + 1), by
                linarith [Nat.mod_add_div (m % (k + 1) + 2) (k + 1)]⟩)
