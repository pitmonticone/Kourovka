  apply st_reduce
  · exact hσ₀_sq
  · exact hτ₀_sq
  · have hτfix : τ₀ m = m := by exact swap02_fix_of_mod_ne_0_2 τ₀ hτ₀ m hl0 hl2
    have hn0_or_n2 : (σ₀ m).val % lcmN k = 0 ∨ (σ₀ m).val % lcmN k = 2 := by
      contrapose! hm_not_p2
      have hτfix : τ₀ (σ₀ m) = σ₀ m := by
        exact swap02_fix_of_mod_ne_0_2 τ₀ hτ₀ _ hm_not_p2.1 hm_not_p2.2
      simp_all +decide [Equiv.Perm.ext_iff]
    have hσ_inv : ∀ n, σ₀ (σ₀ n) = n := fun n ↦ by
      have h := congr_fun (congr_arg (↑·) hσ₀_sq) n
      simpa [Equiv.Perm.mul_apply]
    have hτ_inv : ∀ n, τ₀ (τ₀ n) = n := fun n ↦ by
      have h := congr_fun (congr_arg (↑·) hτ₀_sq) n
      simpa [Equiv.Perm.mul_apply]
    have hn_not_p1 : σ₀ (τ₀ (σ₀ m)) ≠ σ₀ m := by
      intro h
      have h1 := congr_arg σ₀ h
      simp only [hσ_inv] at h1
      have h2 := congr_arg τ₀ h1
      simp only [hτ_inv] at h2
      rw [hτfix] at h2
      exact hm_not_p1 (by rw [hτfix, h2])
    have hn_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m)))) ≠ σ₀ m := by
      intro h
      have h1 := congr_arg σ₀ h
      simp only [hσ_inv] at h1
      have h2 := congr_arg τ₀ h1
      simp only [hτ_inv] at h2
      rw [hτfix] at h2
      exact
        hm_not_p2 (by
            rw [hτfix]
            exact h2)
    cases hn0_or_n2 <;> simp_all +decide only [ne_eq]
    · convert st_period3_l0 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq (σ₀ m) _ hn_not_p1 hn_not_p2 using 1
      aesop
    · apply st_period3_l2 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq (σ₀ m)
