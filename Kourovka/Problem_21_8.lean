import Kourovka.Util.ShiftPeriodic
import Kourovka.Mathlib.PermRepeat
import Mathlib.Algebra.Order.Antidiag.Nat
import Mathlib.Data.ZMod.IntUnitsPower
import Mathlib.GroupTheory.GroupAction.Jordan
import Mathlib.Order.CompletePartialOrder

/-!
# Kourovka Notebook Problem 21.8

For an integer `m > 0` and `0 ≤ r < m`, the *class transposition* `τ_{r(m)}` swaps the residue
classes `r (mod m)` and `r' (mod m')`; the group `CT_same k` is generated by all class transpositions
with moduli at most `k`. This file proves that for every `k > 3` this group is the full symmetric
group on `N = lcm(2, 3, …, k)` letters: `kourovka_21_8` exhibits an isomorphism
`CT_same k ≃* Perm (Fin (lcmSeq k))`.

## Outline

The argument runs through a finite model `CT k : Subgroup (Perm (Fin (lcmSeq k)))`, the image of
`CT_same k` under reduction modulo `lcmSeq k` (`reductionHom`).

* `CT_eq_top_four`: `CT 4 = ⊤`, proved by realizing every adjacent transposition on
  `Fin (lcmSeq 4)` (`adj_swap_mem`) and invoking that they generate the symmetric group.
* `CT_eq_top_of_ge_four`: `CT k = ⊤` for all `k ≥ 4`, by induction on `k`. The step splits on
  whether `lcmSeq (k + 1) = lcmSeq k`: the easy case syncs the action (`sync_CT_le_CT_succ`), the
  growth case shows `CT (k + 1)` is preprimitive (`CT_growth_isPreprimitive`), contains a 3-cycle
  (`CT_growth_contains_three_cycle`) hence the alternating group (`CT_growth_alt_le`), and contains
  an odd permutation (`CT_growth_odd_perm`), so it is everything (`eq_top_of_alt_le_of_odd`).
* `reductionHom_injective` and `reductionHom_surjective` transfer `CT k = ⊤` back to `CT_same k`,
  giving the bijection behind `kourovka_21_8`.

Several membership facts about the finite model `CT 4` are certified by `native_decide` on explicit
permutations of `Fin (lcmSeq 4) = Fin 12`.
-/

open Nat Equiv

namespace Kourovka

/-- Shorthand for elements of `Fin (lcmSeq 4)`. -/
abbrev F4 (n : ℕ) (h : n < lcmSeq 4 := by native_decide) : Fin (lcmSeq 4) :=
  ⟨n, h⟩

/-! ### Explicit generators of `CT 4` -/

section generators

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `1` modulo `2`. -/
def ct2_01 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 2) 1).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (2 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `1` modulo `3`. -/
def ct3_01 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 3) 1).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (3 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `2` modulo `3`. -/
def ct3_02 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 3) 2).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (3 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `1` and `2` modulo `3`. -/
def ct3_12 : Perm (Fin (lcmSeq 4)) :=
  (swap (1 : Fin 3) 2).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (3 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `1` modulo `4`. -/
def ct4_01 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 4) 1).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (4 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `2` modulo `4`. -/
def ct4_02 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 4) 2).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (4 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `0` and `3` modulo `4`. -/
def ct4_03 : Perm (Fin (lcmSeq 4)) :=
  (swap (0 : Fin 4) 3).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (4 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `1` and `3` modulo `4`. -/
def ct4_13 : Perm (Fin (lcmSeq 4)) :=
  (swap (1 : Fin 4) 3).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (4 : ℕ) ∈ Finset.Ioc 0 4))

/-- Class transposition on `Fin (lcmSeq 4)` swapping residues `2` and `3` modulo `4`. -/
def ct4_23 : Perm (Fin (lcmSeq 4)) :=
  (swap (2 : Fin 4) 3).dvdRepeat (dvd_lcmSeq_of_mem (by native_decide : (4 : ℕ) ∈ Finset.Ioc 0 4))

end generators

section CT_defs

/-- The subgroup of `Perm (Fin (lcmSeq k))` generated by class transpositions of modulus `d`. -/
def CT' (d k : ℕ) : Subgroup (Perm (Fin (k.lcmSeq))) :=
  if hd : d ∈ Finset.Ioc 0 k then
    Subgroup.closure
      (Set.range (fun (⟨r₁, r₂⟩ : Fin d × Fin d) ↦ (swap r₁ r₂).dvdRepeat (dvd_lcmSeq_of_mem hd)))
  else ⊥

/-- `CT k` is the subgroup generated by class transpositions of all moduli `2 ≤ d ≤ k`. -/
def CT (k : ℕ) : Subgroup (Perm (Fin (k.lcmSeq))) :=
  ⨆ i ∈ Finset.Icc 2 k, CT' i k

end CT_defs

section membership

/-- Every modulus-`d` class transposition (`2 ≤ d ≤ k`) belongs to `CT k`. -/
lemma dvdRepeat_mem_CT (d k : ℕ) (hd_ioc : d ∈ Finset.Ioc 0 k) (hd_icc : d ∈ Finset.Icc 2 k)
    (r₁ r₂ : Fin d) : (swap r₁ r₂).dvdRepeat (dvd_lcmSeq_of_mem hd_ioc) ∈ CT k := by
  apply (le_iSup₂_of_le d hd_icc le_rfl : CT' d k ≤ CT k)
  simp only [CT', hd_ioc, dite_true]
  exact Subgroup.subset_closure ⟨⟨r₁, r₂⟩, rfl⟩

/-- `ct2_01 ∈ CT 4`. -/
lemma mem_ct2_01 : ct2_01 ∈ CT 4 :=
  dvdRepeat_mem_CT 2 4 (by native_decide) (by native_decide) 0 1
/-- `ct3_01 ∈ CT 4`. -/
lemma mem_ct3_01 : ct3_01 ∈ CT 4 :=
  dvdRepeat_mem_CT 3 4 (by native_decide) (by native_decide) 0 1
/-- `ct3_02 ∈ CT 4`. -/
lemma mem_ct3_02 : ct3_02 ∈ CT 4 :=
  dvdRepeat_mem_CT 3 4 (by native_decide) (by native_decide) 0 2
/-- `ct3_12 ∈ CT 4`. -/
lemma mem_ct3_12 : ct3_12 ∈ CT 4 :=
  dvdRepeat_mem_CT 3 4 (by native_decide) (by native_decide) 1 2
/-- `ct4_01 ∈ CT 4`. -/
lemma mem_ct4_01 : ct4_01 ∈ CT 4 :=
  dvdRepeat_mem_CT 4 4 (by native_decide) (by native_decide) 0 1
/-- `ct4_02 ∈ CT 4`. -/
lemma mem_ct4_02 : ct4_02 ∈ CT 4 :=
  dvdRepeat_mem_CT 4 4 (by native_decide) (by native_decide) 0 2
/-- `ct4_03 ∈ CT 4`. -/
lemma mem_ct4_03 : ct4_03 ∈ CT 4 :=
  dvdRepeat_mem_CT 4 4 (by native_decide) (by native_decide) 0 3
/-- `ct4_13 ∈ CT 4`. -/
lemma mem_ct4_13 : ct4_13 ∈ CT 4 :=
  dvdRepeat_mem_CT 4 4 (by native_decide) (by native_decide) 1 3
/-- `ct4_23 ∈ CT 4`. -/
lemma mem_ct4_23 : ct4_23 ∈ CT 4 :=
  dvdRepeat_mem_CT 4 4 (by native_decide) (by native_decide) 2 3

end membership

/-! ### Adjacent transpositions on `Fin (lcmSeq 4)` lie in `CT 4`

Each adjacent transposition `(i, i+1)` is written as an explicit word in the generators (an identity
checked by `native_decide`), and the corresponding membership follows by closure under products and
conjugation. -/

section conjugation

/--
`CT 4` is closed under conjugation `g * s * g` (here `g` is its own inverse in the uses below). -/
lemma mem_conj {g s : Perm (Fin (lcmSeq 4))} (hg : g ∈ CT 4) (hs : s ∈ CT 4) : g * s * g ∈ CT 4 :=
  (CT 4).mul_mem ((CT 4).mul_mem hg hs) hg

/-- The transposition `(6, 7)` as an explicit word in the generators of `CT 4`. -/
lemma swap_67_eq : ct3_01 * ct4_01 * ct3_01 * ct4_01 * ct3_01 * ct4_01 = swap (F4 6) (F4 7) := by
  native_decide

/-- The transposition `(6, 7)` lies in `CT 4`. -/
lemma mem_swap_67 : swap (F4 6) (F4 7) ∈ CT 4 :=
  swap_67_eq ▸
    (CT 4).mul_mem
      ((CT 4).mul_mem
        ((CT 4).mul_mem ((CT 4).mul_mem ((CT 4).mul_mem mem_ct3_01 mem_ct4_01) mem_ct3_01)
          mem_ct4_01)
        mem_ct3_01)
      mem_ct4_01

/-- Conjugating `(6, 7)` by `ct4_13` gives `(5, 6)`. -/
lemma swap_56_eq : ct4_13 * swap (F4 6) (F4 7) * ct4_13 = swap (F4 5) (F4 6) := by native_decide

/-- The transposition `(5, 6)` lies in `CT 4`. -/
lemma mem_swap_56 : swap (F4 5) (F4 6) ∈ CT 4 :=
  swap_56_eq ▸ mem_conj mem_ct4_13 mem_swap_67

/-- Conjugating `(6, 7)` by `ct3_02` gives `(7, 8)`. -/
lemma swap_78_eq : ct3_02 * swap (F4 6) (F4 7) * ct3_02 = swap (F4 7) (F4 8) := by native_decide

/-- The transposition `(7, 8)` lies in `CT 4`. -/
lemma mem_swap_78 : swap (F4 7) (F4 8) ∈ CT 4 :=
  swap_78_eq ▸ mem_conj mem_ct3_02 mem_swap_67

/-- Conjugating `(5, 6)` by `ct4_02` gives `(4, 5)`. -/
lemma swap_45_eq : ct4_02 * swap (F4 5) (F4 6) * ct4_02 = swap (F4 4) (F4 5) := by native_decide

/-- The transposition `(4, 5)` lies in `CT 4`. -/
lemma mem_swap_45 : swap (F4 4) (F4 5) ∈ CT 4 :=
  swap_45_eq ▸ mem_conj mem_ct4_02 mem_swap_56

/-- The transposition `(3, 4)` as an explicit word in the generators of `CT 4`. -/
lemma swap_34_eq :
    ct4_02 * (ct3_01 * (ct4_02 * swap (F4 6) (F4 7) * ct4_02) * ct3_01) * ct4_02 =
      swap (F4 3) (F4 4) :=
  by native_decide

/-- The transposition `(3, 4)` lies in `CT 4`. -/
lemma mem_swap_34 : swap (F4 3) (F4 4) ∈ CT 4 :=
  swap_34_eq ▸ mem_conj mem_ct4_02 (mem_conj mem_ct3_01 (mem_conj mem_ct4_02 mem_swap_67))

/-- The transposition `(8, 9)` as an explicit word in the generators of `CT 4`. -/
lemma swap_89_eq :
    ct3_12 * (ct4_01 * (ct3_02 * swap (F4 6) (F4 7) * ct3_02) * ct4_01) * ct3_12 =
      swap (F4 8) (F4 9) :=
  by native_decide

/-- The transposition `(8, 9)` lies in `CT 4`. -/
lemma mem_swap_89 : swap (F4 8) (F4 9) ∈ CT 4 :=
  swap_89_eq ▸ mem_conj mem_ct3_12 (mem_conj mem_ct4_01 (mem_conj mem_ct3_02 mem_swap_67))

/-- The transposition `(9, 10)` as an explicit word in the generators of `CT 4`. -/
lemma swap_910_eq :
    ct2_01 * (ct3_02 * (ct2_01 * (ct3_02 * swap (F4 6) (F4 7) * ct3_02) * ct2_01) * ct3_02) *
        ct2_01 =
      swap (F4 9) (F4 10) :=
  by native_decide

/-- The transposition `(9, 10)` lies in `CT 4`. -/
lemma mem_swap_910 : swap (F4 9) (F4 10) ∈ CT 4 :=
  swap_910_eq ▸
    mem_conj mem_ct2_01
      (mem_conj mem_ct3_02 (mem_conj mem_ct2_01 (mem_conj mem_ct3_02 mem_swap_67)))

/-- The transposition `(10, 11)` as an explicit word in the generators of `CT 4`. -/
lemma swap_1011_eq :
    ct4_02 * (ct3_02 * (ct2_01 * (ct3_02 * swap (F4 6) (F4 7) * ct3_02) * ct2_01) * ct3_02) *
        ct4_02 =
      swap (F4 10) (F4 11) :=
  by native_decide

/-- The transposition `(10, 11)` lies in `CT 4`. -/
lemma mem_swap_1011 : swap (F4 10) (F4 11) ∈ CT 4 :=
  swap_1011_eq ▸
    mem_conj mem_ct4_02
      (mem_conj mem_ct3_02 (mem_conj mem_ct2_01 (mem_conj mem_ct3_02 mem_swap_67)))

/-- The transposition `(0, 1)` as an explicit word in the generators of `CT 4`. -/
lemma swap_01_eq :
    ct4_03 *
          (ct3_01 * (ct4_03 * (ct3_01 * (ct4_03 * swap (F4 6) (F4 7) * ct4_03) * ct3_01) * ct4_03) *
            ct3_01) *
        ct4_03 =
      swap (F4 0) (F4 1) :=
  by native_decide

/-- The transposition `(0, 1)` lies in `CT 4`. -/
lemma mem_swap_01 : swap (F4 0) (F4 1) ∈ CT 4 :=
  swap_01_eq ▸
    mem_conj mem_ct4_03
      (mem_conj mem_ct3_01
        (mem_conj mem_ct4_03 (mem_conj mem_ct3_01 (mem_conj mem_ct4_03 mem_swap_67))))

/-- The transposition `(1, 2)` as an explicit word in the generators of `CT 4`. -/
lemma swap_12_eq :
    ct4_23 *
          (ct3_01 * (ct4_03 * (ct3_01 * (ct4_03 * swap (F4 6) (F4 7) * ct4_03) * ct3_01) * ct4_03) *
            ct3_01) *
        ct4_23 =
      swap (F4 1) (F4 2) :=
  by native_decide

/-- The transposition `(1, 2)` lies in `CT 4`. -/
lemma mem_swap_12 : swap (F4 1) (F4 2) ∈ CT 4 :=
  swap_12_eq ▸
    mem_conj mem_ct4_23
      (mem_conj mem_ct3_01
        (mem_conj mem_ct4_03 (mem_conj mem_ct3_01 (mem_conj mem_ct4_03 mem_swap_67))))

/-- The transposition `(2, 3)` as an explicit word in the generators of `CT 4`. -/
lemma swap_23_eq :
    ct3_01 *
          (ct4_03 * (ct2_01 * (ct3_01 * (ct4_02 * swap (F4 6) (F4 7) * ct4_02) * ct3_01) * ct2_01) *
            ct4_03) *
        ct3_01 =
      swap (F4 2) (F4 3) :=
  by native_decide

/-- The transposition `(2, 3)` lies in `CT 4`. -/
lemma mem_swap_23 : swap (F4 2) (F4 3) ∈ CT 4 :=
  swap_23_eq ▸
    mem_conj mem_ct3_01
      (mem_conj mem_ct4_03
        (mem_conj mem_ct2_01 (mem_conj mem_ct3_01 (mem_conj mem_ct4_02 mem_swap_67))))

end conjugation

/-- All adjacent transpositions on `Fin (lcmSeq 4)` are in `CT 4`. -/
lemma adj_swap_mem : ∀ i : Fin 11, swap (i.castSucc) (i.succ) ∈ CT 4 := by
  intro i
  fin_cases i
  · exact mem_swap_01
  · exact mem_swap_12
  · exact mem_swap_23
  · exact mem_swap_34
  · exact mem_swap_45
  · exact mem_swap_56
  · exact mem_swap_67
  · exact mem_swap_78
  · exact mem_swap_89
  · exact mem_swap_910
  · exact mem_swap_1011

/-- `CT 4 = ⊤`. -/
theorem CT_eq_top_four : CT 4 = ⊤ := by
  rw [eq_top_iff]
  rintro σ -
  have hσ : σ ∈ (Submonoid.closure _ : Submonoid (Perm (Fin (lcmSeq 4)))) :=
    Perm.mclosure_swap_castSucc_succ (n := 11) ▸ Submonoid.mem_top _
  induction hσ using Submonoid.closure_induction with
  | mem _ hm =>
    obtain ⟨i, rfl⟩ := hm
    exact adj_swap_mem i
  | one => exact (CT 4).one_mem
  | mul _ _ _ _ h1 h2 => exact (CT 4).mul_mem h1 h2

/--
`k + 1 ≤ lcmSeq k` for `k ≥ 4`, since `k * (k - 1)` divides `lcmSeq k` and `k * (k - 1) ≥ k + 1`. -/
lemma succ_le_lcmSeq {k : ℕ} (hk : k ≥ 4) : k + 1 ≤ k.lcmSeq := by
  trans k * (k - 1)
  · nlinarith [Nat.sub_add_cancel (by linarith : 1 ≤ k)]
  · apply le_of_eq_of_le (b := k.lcm (k - 1))
    · rcases k with _ | k
      · contradiction
      · simp_all [Nat.lcm]
    · apply le_of_dvd k.lcmSeq_pos
      apply Nat.lcm_dvd <;>
        { apply dvd_lcmSeq_of_mem
          simp_all
          linarith
        }

/-- `lcmSeq k ≥ 12` for `k ≥ 4`, since `lcmSeq 4 = 12` divides `lcmSeq k`. -/
lemma lcmSeq_ge_12 {k : ℕ} (hk : k ≥ 4) : k.lcmSeq ≥ 12 := by
  rw [show 12 = lcmSeq 4 by decide]
  exact lcmSeq_mono hk

/-- `lcmSeq (k + 1) ≥ 6` in the growth case. -/
lemma lcmSeq_succ_ge_six {k : ℕ} (hk : k ≥ 4) : (k + 1).lcmSeq ≥ 6 := by
  rw [show 6 = lcmSeq 3 by decide]
  exact lcmSeq_mono (by linarith)

/-- For `0 < r` with `r * lcmSeq k < lcmSeq (k + 1)`, `¬(k + 1) ∣ r * lcmSeq k`. -/
lemma not_dvd_mul_lcmSeq {k : ℕ} (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (r : ℕ) (hr_pos : 0 < r)
    (hr_lt : r * k.lcmSeq < (k + 1).lcmSeq) : ¬((k + 1) ∣ r * k.lcmSeq) := by
  obtain ⟨p, m, hp, hm₁, hm₂⟩ := exist_prime_of_lcmSeq_ne_succ hne
  have h_div_lcm : ¬(k + 1 ∣ k.lcmSeq) := mt lcmSeq_succ_eq_iff_dvd.mpr hne
  contrapose! h_div_lcm
  refine Coprime.dvd_of_dvd_mul_left (hm₁ ▸ ?_) h_div_lcm
  refine Coprime.pow_left _ (hp.coprime_iff_not_dvd.mpr ?_)
  rw [hm₂, mul_lt_mul_iff_left₀ k.lcmSeq_pos] at hr_lt
  exact not_dvd_of_pos_of_lt hr_pos hr_lt

/-- The points `r * lcmSeq k - 1` and `r * lcmSeq k` lie in the same `(k + 1)`-block at a row
boundary. -/
lemma same_block_at_boundary {k : ℕ} (r : ℕ) (hndvd : ¬((k + 1) ∣ r * k.lcmSeq)) :
    (r * k.lcmSeq - 1) / (k + 1) = (r * k.lcmSeq) / (k + 1) := by
  rcases n : r * k.lcmSeq
  · simp
  · exact (succ_div_of_not_dvd (n ▸ hndvd)).symm

/-- Any permutation from `CT k`, synchronized to the bigger space, lies in `CT (k + 1)`. -/
lemma syncPerm_mem_CT {k : ℕ} (ih : CT k = ⊤) (σ : Perm (Fin (k.lcmSeq))) :
    σ.dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ) ∈ CT (k + 1) := by
  rw [eq_top_iff] at ih
  have hσ :
    σ ∈
      Subgroup.closure
        (⋃ d,
          ⋃ hd : d ∈ Finset.Icc 2 k,
            Set.range
              (fun (r : Fin d × Fin d) ↦
                (swap r.1 r.2).dvdRepeat
                  (dvd_lcmSeq_of_mem
                    (Finset.mem_Ioc.mpr
                      ⟨by linarith [(Finset.mem_Icc.mp hd).1], (Finset.mem_Icc.mp hd).2⟩)))) := by
    convert ih (Subgroup.mem_top σ) using 1
    unfold CT CT'
    simp only [Finset.mem_Icc, Subgroup.closure_iUnion, Finset.mem_Ioc]
    grind only
  induction hσ using Subgroup.closure_induction with
  | mem σ hσ =>
    unfold CT CT'
    simp only [Finset.mem_Icc, Set.mem_iUnion, Set.mem_range, Prod.exists] at *
    obtain ⟨d, ⟨hd₁, hd₂⟩, r₁, r₂, rfl⟩ := hσ
    apply Subgroup.mem_iSup_of_mem d
    apply Subgroup.mem_iSup_of_mem ⟨hd₁, by linarith⟩
    suffices 0 < d ∧ d ≤ (k + 1) by
      simp_all only [top_le_iff, Finset.mem_Ioc, and_self, ↓reduceDIte]
      apply Subgroup.mem_closure_of_mem
      use ⟨r₁, r₂⟩
      exact dvdRepeat_dvd _ _ _ _
    constructor <;> linarith
  | one =>
    convert Subgroup.one_mem _
    simp only [Perm.one_def, dvdRepeat_refl]
  | mul x y _ _ hx hy =>
    convert Subgroup.mul_mem _ hx hy
    convert (dvdRepeatHom_apply _ _).symm
    exact (dvdRepeatHom _).map_mul _ _ ▸ rfl
  | inv x _ hx => exact Subgroup.inv_mem _ hx

/-- Any two elements in the same row are connected by an element of `CT (k + 1)`. -/
lemma CT_growth_same_row {k : ℕ} (ih : CT k = ⊤) (a b : Fin ((k + 1).lcmSeq))
    (hab : (a : ℕ) / k.lcmSeq = (b : ℕ) / k.lcmSeq) : ∃ g ∈ CT (k + 1), g a = b := by
  refine ⟨(swap ⟨a.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩
            ⟨b.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩).dvdRepeat
        (k.lcmSeq_dvd_lcmSeq_succ),
      syncPerm_mem_CT ih _, ?_⟩
  simp [Fin.ext_iff, Fin.modNat, hab, mod_add_div]

/-- Some element of `CT (k + 1)` maps `r * lcmSeq k - 1` to `r * lcmSeq k` across the row
boundary. -/
lemma CT_growth_boundary_swap {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (r : ℕ)
    (hr_pos : 0 < r) (hr_lt : r * k.lcmSeq < (k + 1).lcmSeq) :
    ∃ g ∈ CT (k + 1), g ⟨r * k.lcmSeq - 1, by omega⟩ = ⟨r * k.lcmSeq, hr_lt⟩ := by
  refine ⟨(swap ⟨(r * k.lcmSeq - 1) % (k + 1), mod_lt _ (succ_pos _)⟩
            ⟨(r * k.lcmSeq) % (k + 1), mod_lt _ (succ_pos _)⟩).dvdRepeat
        (dvd_lcmSeq_of_mem (Finset.right_mem_Ioc.mpr k.zero_lt_succ)),
      ?_, ?_⟩
  · refine Subgroup.mem_iSup_of_mem (k + 1) ?_
    simp only [Finset.mem_Icc, reduceLeDiff, le_refl, and_true, CT', Finset.mem_Ioc,
      lt_add_iff_pos_left, Order.lt_add_one_iff, _root_.zero_le, and_self, ↓reduceDIte,
      Subgroup.mem_iSup_prop, exists_prop]
    refine Or.inr ⟨?_, Subgroup.subset_closure ⟨⟨_, _⟩, rfl⟩⟩
    linarith
  · ext
    simp only [dvdRepeat_apply_val, Fin.modNat, Fin.cast_mk, swap_apply_left]
    nth_rw 3 [← mod_add_div (r * k.lcmSeq) (k + 1)]
    rw [same_block_at_boundary _ (not_dvd_mul_lcmSeq hne r hr_pos hr_lt)]

/-- Row-by-row induction: any row is reachable from row `0`. -/
lemma CT_growth_reach_row_aux {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤)
    (r : ℕ) (hr : r * k.lcmSeq < (k + 1).lcmSeq) :
    ∃ g ∈ CT (k + 1), (g ⟨0, lcmSeq_pos _⟩ : ℕ) / k.lcmSeq = r := by
  induction r with
  | zero =>
    refine ⟨1, Subgroup.one_mem _, ?_⟩
    simp
  | succ r ih =>
    obtain ⟨g₁, g₁_mem, hg₁⟩ := ih (by nlinarith)
    have :
      g₁ ⟨0, (k + 1).lcmSeq_pos⟩ / k.lcmSeq =
        (⟨(r + 1) * k.lcmSeq - 1, by omega⟩ : Fin (k + 1).lcmSeq) / k.lcmSeq := by
      rw [hg₁, Fin.val_mk, add_mul, one_mul, Nat.add_sub_assoc k.lcmSeq_pos, mul_comm,
        mul_add_div k.lcmSeq_pos, div_eq_of_lt (sub_one_lt_of_le k.lcmSeq_pos (by rfl)), add_zero]
    obtain ⟨g₂, g₂_mem, hg₂⟩ :=
      CT_growth_same_row ‹_› (g₁ ⟨0, (k + 1).lcmSeq_pos⟩) ⟨(r + 1) * k.lcmSeq - 1, by omega⟩ this
    obtain ⟨g₃, g₃_mem, hg₃⟩ := CT_growth_boundary_swap hk hne (r + 1) (succ_pos _) hr
    refine ⟨g₃ * g₂ * g₁, ?_, ?_⟩
    · exact Subgroup.mul_mem _ (Subgroup.mul_mem _ g₃_mem g₂_mem) g₁_mem
    · simp only [Perm.coe_mul, Function.comp_apply, hg₂, hg₃, Nat.mul_div_cancel _ k.lcmSeq_pos]

/-- Any element is reachable from `0` using elements of `CT (k + 1)`. -/
lemma CT_growth_reach_row {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤)
    (b : Fin ((k + 1).lcmSeq)) : ∃ g ∈ CT (k + 1), g ⟨0, lcmSeq_pos _⟩ = b := by
  obtain ⟨g₁, hg₁⟩ :=
    CT_growth_reach_row_aux hk hne ih ((b : ℕ) / k.lcmSeq)
      (lt_of_le_of_lt (div_mul_le_self _ _) b.2)
  obtain ⟨g₂, hg₂⟩ := CT_growth_same_row ih (g₁ ⟨0, lcmSeq_pos _⟩) b hg₁.2
  refine ⟨g₂ * g₁, Subgroup.mul_mem _ hg₂.1 hg₁.1, ?_⟩
  simpa using hg₂.2

/-- `CT (k + 1)` acts transitively in the growth case. -/
lemma CT_growth_transitive {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤) :
    MulAction.IsPretransitive (CT (k + 1)) (Fin ((k + 1).lcmSeq)) := by
  constructor
  intro x y
  obtain ⟨g₁, hg₁⟩ := CT_growth_reach_row hk hne ih x
  obtain ⟨g₂, hg₂⟩ := CT_growth_reach_row hk hne ih y
  refine ⟨⟨g₂ * g₁⁻¹, Subgroup.mul_mem _ hg₂.1 (Subgroup.inv_mem _ hg₁.1)⟩, ?_⟩
  simp [← hg₁.2, ← hg₂.2]

/-- The commutator `σ * τ * σ * τ` fixes `n` when `σ` and `τ` locally commute at `n`. -/
lemma invol_comm_fix {α : Type*} [DecidableEq α] {σ τ : Perm α} (hσ : σ * σ = 1) (hτ : τ * τ = 1)
    {n : α} (h : (τ n = n ∧ τ (σ n) = σ n) ∨ (σ n = n ∧ σ (τ n) = τ n)) : (σ * τ * σ * τ) n = n := by
  rw [Perm.ext_iff] at *
  simp only [Perm.mul_apply] at *
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp [h1, h2, hσ, hτ]

/-- A permutation cyclically sending `a ↦ b ↦ c ↦ a` and fixing everything else is a 3-cycle. -/
lemma isThreeCycle_of_vals {N : ℕ} {f : Perm (Fin N)} {a b c : Fin N} (hab : a ≠ b) (hbc : b ≠ c)
    (hac : a ≠ c) (ha : f a = b) (hb : f b = c) (hc : f c = a)
    (hfix : ∀ n : Fin N, n ≠ a → n ≠ b → n ≠ c → f n = n) : f.IsThreeCycle := by
  rw [← card_support_eq_three_iff]
  suffices f.support = {a, b, c} by
    rw [this, Finset.card_eq_three]
    exact ⟨a, b, c, hab, hac, hbc, rfl⟩
  ext x
  simp only [Perm.mem_support, Finset.mem_insert, Finset.mem_singleton]
  grind

/-- `dvdRepeat` of a swap is an involution. -/
lemma dvdRepeat_swap_sq {m n : ℕ} (hm : m ∣ n) (a b : Fin m) :
    (swap a b).dvdRepeat hm * (swap a b).dvdRepeat hm = 1 := by
  unfold dvdRepeat classRepeat
  ext x
  simp only [Perm.coe_mul, Function.comp_apply, permCongr_apply, finCongr_symm, finCongr_apply,
    finProdFinEquiv_symm_apply, extendRepeatRight_apply, swap_apply_def, Fin.ext_iff,
    Fin.coe_modNat, Fin.val_cast, Fin.cast_cast, Fin.cast_eq_self, symm_apply_apply,
    ite_eq_left_iff, finProdFinEquiv_apply_val, Fin.coe_divNat, Perm.coe_one, id_eq]
  split_ifs with h₁ h₂ h₃ <;> simp_all <;> linarith [mod_add_div x m]

/-- `dvdRepeat` of a swap fixes elements whose residue is not `a` or `b`. -/
lemma dvdRepeat_swap_fix {m n : ℕ} (hm : m ∣ n) (a b : Fin m) (x : Fin n) (ha : x.val % m ≠ a.val)
    (hb : x.val % m ≠ b.val) : (swap a b).dvdRepeat hm x = x := by
  unfold dvdRepeat classRepeat
  ext
  rw [← mod_add_div x m]
  simp [swap_apply_def, extendRepeatRight, Fin.ext_iff, *]


/-- The `dvdRepeat` of `swap 0 1` with modulus `k + 1` lies in `CT (k + 1)`. -/
lemma swap01_dvdRepeat_mem_CT {k : ℕ} (hk : k ≥ 4) :
    (swap (0 : Fin (k + 1)) 1).dvdRepeat
        (dvd_lcmSeq_of_mem
          (show k + 1 ∈ Finset.Ioc 0 (k + 1) from Finset.right_mem_Ioc.mpr (by omega))) ∈
      CT (k + 1) := by
  unfold CT
  apply Subgroup.mem_sSup_of_mem
  · refine ⟨k + 1, ?_⟩
    simp only [Finset.mem_Icc, reduceLeDiff, le_refl, and_true, CT', Finset.mem_Ioc,
      lt_add_iff_pos_left, Order.lt_add_one_iff, _root_.zero_le, and_self, ↓reduceDIte]
    rw [ciSup_pos]
    linarith
  · exact Subgroup.subset_closure ⟨⟨0, 1⟩, rfl⟩

/-- `σ₀` fixes every `n` with `n % (k + 1) ≥ 2`. -/
lemma σ_fix_of_mod_ge_2 {k : ℕ} (σ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ k.zero_lt_succ⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (n : Fin ((k + 1).lcmSeq)) (hp : n.val % (k + 1) ≥ 2) : σ₀ n = n := by
  ext
  rw [hσ₀, swap_apply_def]
  split_ifs with h₁ h₂ <;> simp_all [Fin.ext_iff]
  · linarith [mod_le 1 (k + 1)]
  · exact mod_add_div _ _

/-- `τ₀` fixes every `n` with `n % lcmSeq k ∉ {0, 2}`. -/
lemma τ_fix_of_mod_ne_0_2 {k : ℕ} (τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (n : Fin ((k + 1).lcmSeq)) (h0 : n.val % k.lcmSeq ≠ 0) (h2 : n.val % k.lcmSeq ≠ 2) : τ₀ n = n := by
  ext
  rw [hτ₀ n, swap_apply_def]
  have : n % k.lcmSeq ≠ 2 % k.lcmSeq := by
    by_cases! h : 3 ≤ k
    · convert h2
      rw [mod_eq_of_lt]
      apply lt_of_lt_of_le _ (lcmSeq_mono h)
      decide
    · interval_cases k <;> native_decide +revert
  simp only [Fin.ext_iff, Fin.coe_ofNat_eq_mod, zero_mod, h0, ↓reduceIte, this]
  exact mod_add_div (↑n) k.lcmSeq

/-- When `n % (k + 1) = 0`, `σ₀` maps `n` to `n + 1`. -/
lemma σ_val_of_p0 {k : ℕ} (hk : k ≥ 1) (σ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (n : Fin ((k + 1).lcmSeq)) (hp : n.val % (k + 1) = 0) : (σ₀ n).val = n.val + 1 := by
  simp_all only [Fin.zero_eta, swap_apply_left, Fin.coe_ofNat_eq_mod,
    Nat.mul_div_eq_iff_dvd.mpr (Nat.dvd_iff_mod_eq_zero.mpr hp)]
  rw [mod_eq_of_lt (by linarith), add_comm]

/-- When `n % (k + 1) = 1`, `σ₀` maps `n` to `n - 1`. -/
lemma σ_val_of_p1 {k : ℕ} (σ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (n : Fin ((k + 1).lcmSeq)) (hp : n.val % (k + 1) = 1) : (σ₀ n).val = n.val - 1 := by
  rw [← mod_add_div n (k + 1), hp]
  rcases k with (_ | k) <;> simp_all

/-- When `n % lcmSeq k = 0`, `τ₀` maps `n` to `n + 2`. -/
lemma τ_val_of_l0 {k : ℕ} (hk : k ≥ 3) (τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (n : Fin ((k + 1).lcmSeq)) (hl : n.val % k.lcmSeq = 0) : (τ₀ n).val = n.val + 2 := by
  rw [hτ₀, ← mod_add_div n (k.lcmSeq), hl]
  norm_num [mod_eq_of_lt, div_eq_of_lt]
  ring_nf
  rcases k with (_ | _ | _ | k) <;> simp_all
  rw [mod_eq_of_lt, Nat.mul_div_cancel_left _ (lcmSeq_pos _)]
  apply lt_of_lt_of_le (b := lcmSeq 3)
  · decide
  · refine lcmSeq_mono ?_
    linarith

/-- When `n % lcmSeq k = 2`, `τ₀` maps `n` to `n - 2`. -/
lemma τ_val_of_l2 {k : ℕ} (hk : k ≥ 4) (τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (n : Fin ((k + 1).lcmSeq)) (hl : n.val % k.lcmSeq = 2) : (τ₀ n).val = n.val - 2 := by
  simp only [hτ₀, hl, swap_apply_def, Fin.ext_iff, Fin.coe_ofNat_eq_mod, zero_mod,
    OfNat.ofNat_ne_zero, ↓reduceIte]
  rw [if_pos]
  · refine eq_tsub_of_add_eq ?_
    norm_num
    linarith [mod_add_div n k.lcmSeq]
  · rw [mod_eq_of_lt]
    linarith [lcmSeq_ge_12 hk]

/-- If `σ₀` and `τ₀` are involutions and `f = σ₀ ∘ τ₀`, then `f³ m = m` whenever `f⁴ m = f m`. -/
lemma st_reduce' {n : ℕ} (σ₀ τ₀ : Perm (Fin n)) (m : Fin n)
    (h : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))))) = σ₀ (τ₀ m)) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m :=
  by simp_all

/-- Orbit 1: `m % (k + 1) = 0` and `m % lcmSeq k = 0`. -/
lemma orbit1_period3' {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (m : Fin ((k + 1).lcmSeq)) (hp : m.val % (k + 1) = 0)
    (hl : m.val % k.lcmSeq = 0) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  convert st_reduce' σ₀ τ₀ m _ using 1
  have h_step1 : (τ₀ m).val = m.val + 2 := by convert τ_val_of_l0 (by linarith) τ₀ hτ₀ m hl using 1
  have h_step2 : (σ₀ (τ₀ m)).val = m.val + 2 := by
    convert σ_fix_of_mod_ge_2 σ₀ hσ₀ (τ₀ m) _ using 1
    · simp only [Fin.ext_iff, h_step1]
    · rw [h_step1, add_mod, hp, mod_eq_of_lt]
      all_goals rw [mod_eq_of_lt]
      all_goals linarith
  have h_step3 : (τ₀ (σ₀ (τ₀ m))).val = m.val := by
    convert τ_val_of_l2 hk τ₀ hτ₀ (σ₀ (τ₀ m)) _ using 1
    · rw [h_step2, Nat.add_sub_cancel]
    · norm_num [h_step2, add_mod, hl]
      rw [mod_eq_of_lt]
      linarith [lcmSeq_ge_12 hk]
  have h_step4 : (σ₀ (τ₀ (σ₀ (τ₀ m)))).val = m.val + 1 := by
    convert σ_val_of_p0 (by linarith) σ₀ hσ₀ (τ₀ (σ₀ (τ₀ m))) _ using 1
    · rw [h_step3]
    · rw [h_step3]
      exact hp
  have h_step5 : τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m)))) = σ₀ (τ₀ (σ₀ (τ₀ m))) := by
    apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀
    · rw [h_step4, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
      · exact Nat.one_ne_zero
      · linarith [lcmSeq_ge_12 hk]
    · rw [h_step4, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
      · exact Ne.symm add_one_add_one_ne_one
      · linarith [lcmSeq_ge_12 hk]
  simp_rw [Equiv.ext_iff, Perm.coe_mul, Function.comp_apply] at hσ₀_sq
  simp [h_step5, hσ₀_sq, Fin.ext_iff, h_step3]

/-- Orbit 2: `m % (k + 1) = 1` and `m % lcmSeq k = 0`. -/
lemma orbit2_period3' {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (m : Fin ((k + 1).lcmSeq)) (hp : m.val % (k + 1) = 1) (hl : m.val % k.lcmSeq = 0) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  have h1 : (τ₀ m).val = m.val + 2 := τ_val_of_l0 (by linarith) τ₀ hτ₀ m hl
  have h2 : (σ₀ (τ₀ m)).val = m.val + 2 := by
    convert σ_fix_of_mod_ge_2 σ₀ hσ₀ (τ₀ m) _ using 1
    · simp only [Fin.ext_iff, h1]
    · rw [h1, add_mod, hp, mod_eq_of_lt] <;> rw [mod_eq_of_lt] <;> linarith
  have h3 : (τ₀ (σ₀ (τ₀ m))).val = m.val := by
    convert τ_val_of_l2 hk τ₀ hτ₀ (σ₀ (τ₀ m)) _ using 1
    · rw [h2, Nat.add_sub_cancel]
    · rw [h2, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
      linarith [lcmSeq_ge_12 hk]
  have h4 : (σ₀ m).val = m.val - 1 := σ_val_of_p1 σ₀ hσ₀ m hp
  have h5 : (τ₀ (σ₀ m)).val = m.val - 1 := by
    rw [← h4]
    congr 1
    have m_val_pos : m.val ≠ 0 := by
      by_contra! h
      simp [h] at hp
    apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀ (σ₀ m)
    all_goals rw [h4]
    all_goals intro h
    all_goals rw [← sub_one_add_one m_val_pos, add_mod, h, mod_eq_of_lt] at hl
    · rw [zero_add, one_mod_eq_zero_iff] at hl
      linarith [lcmSeq_ge_12 hk]
    · rw [mod_eq_of_lt] <;> linarith [lcmSeq_ge_12 hk]
    · linarith [le_of_add_right_le (le_of_eq hl)]
    · rw [mod_eq_of_lt] <;> linarith [lcmSeq_ge_12 hk]
  have h6 : (σ₀ (τ₀ (σ₀ m))).val = m.val := by
    rw [hσ₀, h5, ← mod_add_div m (k + 1), hp]
    norm_num [add_mod, mul_mod, mod_eq_of_lt]
    linarith
  rw [Fin.ext_iff, ← h6]
  congr
  rw [Fin.ext_iff, h3]

/-- Orbit 3: `m % (k + 1) = k - 1` and `m % lcmSeq k = 0`. -/
lemma orbit3_period3' {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (m : Fin ((k + 1).lcmSeq)) (hp : m.val % (k + 1) + 2 = k + 1) (hl : m.val % k.lcmSeq = 0) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  ext
  have h1 : (τ₀ m).val = m.val + 2 := τ_val_of_l0 (by linarith) τ₀ hτ₀ m hl
  have h2 : (σ₀ (τ₀ m)).val = m.val + 3 := by
    convert σ_val_of_p0 (by linarith) σ₀ hσ₀ (τ₀ m) _ using 1 <;> rw [h1]
    rw [add_mod, mod_eq_of_lt (a := 2), hp]
    · exact mod_self _
    · linarith
  have h3 : (τ₀ (σ₀ (τ₀ m))).val = m.val + 3 := by
    rw [← h2, ← Fin.ext_iff]
    apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀ (σ₀ (τ₀ m))
    all_goals rw [h2, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
    all_goals linarith [lcmSeq_ge_12 hk]
  have h4 : (σ₀ (τ₀ (σ₀ (τ₀ m)))).val = m.val + 2 := by
    convert σ_val_of_p1 σ₀ hσ₀ _ _ using 1 <;> rw [h3]
    · norm_num
    · rw [add_mod, mod_eq_of_lt (a := 3), show 3 = 2 + 1 by norm_num, ← add_assoc, hp, add_mod_left,
        mod_eq_of_lt]
      all_goals linarith [hk]
  have h5 : (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))).val = m.val := by
    convert τ_val_of_l2 (by linarith) τ₀ hτ₀ (σ₀ (τ₀ (σ₀ (τ₀ m)))) _ using 1
    · rw [h4, Nat.add_sub_cancel]
    · rw [h4, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
      linarith [lcmSeq_ge_12 hk]
  rw [← h5, ← Fin.ext_iff]
  apply σ_fix_of_mod_ge_2 σ₀ hσ₀
  rw [h5]
  linarith

/-- Orbit 4: `m % (k + 1) = k` and `m % lcmSeq k = 0`. -/
lemma orbit4_period3' {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (m : Fin ((k + 1).lcmSeq)) (hp : m.val % (k + 1) = k) (hl : m.val % k.lcmSeq = 0) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  have h_step1 : (τ₀ m : ℕ) = m.val + 2 := τ_val_of_l0 (by linarith) τ₀ hτ₀ m hl
  have h_step2 : (σ₀ (τ₀ m) : ℕ) = m.val + 1 := by
    convert σ_val_of_p1 σ₀ hσ₀ (τ₀ m) _ using 1 <;> rw [h_step1]
    · norm_num
    · rw [add_mod, hp, add_mod, mod_mod, mod_eq_of_lt (a := k), mod_eq_of_lt (a := 2),
        show k + 2 = (k + 1) + 1 by norm_num, add_mod_left, mod_eq_of_lt]
      all_goals linarith
  have h_step3 : (τ₀ (σ₀ (τ₀ m)) : ℕ) = m.val + 1 := by
    rw [← h_step2, ← Fin.ext_iff]
    apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀ (σ₀ (τ₀ m)) <;> norm_num [h_step2, add_mod, hl]
    · linarith [lcmSeq_ge_12 hk]
    · rw [mod_eq_of_lt] <;> linarith [lcmSeq_ge_12 hk]
  have h_step4 : (σ₀ (τ₀ (σ₀ (τ₀ m))) : ℕ) = m.val + 2 := by
    convert σ_val_of_p0 (by linarith) σ₀ hσ₀ (τ₀ (σ₀ (τ₀ m))) _ using 1 <;> rw [h_step3]
    rw [add_mod, hp]
    norm_num [mod_eq_of_lt]
  have h_step5 : (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m)))) : ℕ) = m.val := by
    convert τ_val_of_l2 (by linarith) τ₀ hτ₀ (σ₀ (τ₀ (σ₀ (τ₀ m)))) _ using 1
    · norm_num [h_step4]
    · rw [h_step4, add_mod, hl, zero_add, mod_mod, mod_eq_of_lt]
      linarith [lcmSeq_ge_12 hk]
  rw [Fin.ext h_step5]
  apply σ_fix_of_mod_ge_2 σ₀ hσ₀ m
  linarith [hp]

/-- Period-3 orbit when `m % lcmSeq k = 0`, `f m ≠ m`, and `f² m ≠ m`. -/
lemma period3_l0 {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq))
    (hl : m.val % k.lcmSeq = 0) (hm_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ m))) ≠ m) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  by_cases hp : m.val % (k + 1) ≥ 2
  · by_cases! hτ : (τ₀ m).val % (k + 1) ≥ 2
    · simp_all [σ_fix_of_mod_ge_2 σ₀ hσ₀ m hp, σ_fix_of_mod_ge_2 σ₀ hσ₀ _ hτ, Perm.ext_iff]
    · have h_cases : m.val % (k + 1) + 2 = k + 1 ∨ m.val % (k + 1) = k := by
        have : (m.val + 2) % (k + 1) < 2 := by
          convert hτ
          simp only [hτ₀, hl, Fin.mk_zero', swap_apply_left, Fin.coe_ofNat_eq_mod,
            mul_div_self_eq_mod_sub_self, tsub_zero, add_comm, Nat.add_left_cancel_iff]
          refine (mod_eq_of_lt ?_).symm
          linarith [lcmSeq_ge_12 hk]
        rw [add_mod, mod_eq_of_lt (by linarith : 2 < k + 1)] at this
        have : (m.val % (k + 1) + 2) < (k + 1) + 2 := by
          linarith [(m : ℕ).mod_lt (by linarith : 0 < k + 1)]
        by_cases h_cases : (m.val % (k + 1) + 2) < (k + 1)
        · simp_all [mod_eq_of_lt]
        · omega
      rcases h_cases with h | h
      · exact orbit3_period3' hk σ₀ τ₀ hσ₀ hτ₀ m h hl
      · exact orbit4_period3' hk σ₀ τ₀ hσ₀ hτ₀ m h hl
  · interval_cases _ : (m : ℕ) % (k + 1)
    · exact orbit1_period3' hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq m ‹_› hl
    · exact orbit2_period3' hk σ₀ τ₀ hσ₀ hτ₀ m ‹_› hl

/-- Period-3 when `m % lcmSeq k = 2`. -/
lemma period3_l2 {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq))
    (hl : m.val % k.lcmSeq = 2) (hm_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ m))) ≠ m) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  have h_tau_m : τ₀ m = ⟨m.val - 2, lt_of_le_of_lt (sub_le _ _) m.2⟩ := by
    ext
    exact τ_val_of_l2 hk τ₀ hτ₀ m hl
  have := period3_l0 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq ⟨m.val - 2, lt_of_le_of_lt (sub_le _ _) m.2⟩
  contrapose! this
  simp_all only [ne_eq]
  refine ⟨?_, ?_, ?_⟩
  · rw [← mod_add_div m (k.lcmSeq), hl]
    norm_num [add_mod, mul_mod]
  all_goals intro h
  all_goals have := congr_arg τ₀ h
  all_goals simp_all [Perm.ext_iff]
  all_goals grind only

/-- Period-3 when `m % lcmSeq k ∉ {0, 2}`. -/
lemma period3_other {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq))
    (hl0 : m.val % k.lcmSeq ≠ 0) (hl2 : m.val % k.lcmSeq ≠ 2)
    (hm_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ m))) ≠ m) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  have τ₀_const : τ₀ m = m := τ_fix_of_mod_ne_0_2 τ₀ hτ₀ m hl0 hl2
  have mod_val : (σ₀ m).val % (k.lcmSeq) = 0 ∨ (σ₀ m).val % (k.lcmSeq) = 2 := by
    contrapose! hm_not_p2
    simp only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq] at hσ₀_sq
    rw [τ₀_const, τ_fix_of_mod_ne_0_2 τ₀ hτ₀ _ hm_not_p2.1 hm_not_p2.2, hσ₀_sq m]
  rw [← τ₀.injective.eq_iff, ← σ₀.injective.eq_iff, τ₀_const]
  rcases mod_val with h_mod | h_mod
  · apply period3_l0 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq (σ₀ m) h_mod
    rw [← τ₀_const, σ₀.injective.ne_iff, τ₀.injective.ne_iff]
    exact hm_not_p2
  · apply period3_l2 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq (σ₀ m) h_mod
    rw [← τ₀_const, σ₀.injective.ne_iff, τ₀.injective.ne_iff]
    exact hm_not_p2

/-- Period-3 orbit, combined. -/
theorem period3_all {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq))
    (hm_not_p2 : σ₀ (τ₀ (σ₀ (τ₀ m))) ≠ m) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  by_cases hl0 : m.val % k.lcmSeq = 0
  · exact period3_l0 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m hl0 hm_not_p2
  · by_cases hl2 : m.val % k.lcmSeq = 2
    · exact period3_l2 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m hl2 hm_not_p2
    · exact period3_other hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m hl0 hl2 hm_not_p2

/-- When `k + 1` is prime and grows the sequence, `lcmSeq (k + 1) = (k + 1) * lcmSeq k`. -/
lemma prime_lcmSeq_eq {k : ℕ} (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (h_prime : (k + 1).Prime) :
    (k + 1).lcmSeq = (k + 1) * k.lcmSeq := by
  rw [k.lcmSeq_succ, Nat.lcm, Nat.div_eq_self, ← coprime_iff_gcd_eq_one,
    h_prime.coprime_iff_not_dvd, ← lcmSeq_succ_eq_iff_dvd, ← ne_eq]
  exact Or.intro_right _ hne

/-- When `k + 1` is prime and grows the sequence, `k + 1` is coprime to `lcmSeq k`. -/
lemma prime_coprime {k : ℕ} (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (h_prime : (k + 1).Prime) :
    (k + 1).Coprime (k.lcmSeq) := by
  rw [h_prime.coprime_iff_not_dvd, ← lcmSeq_succ_eq_iff_dvd]
  exact hne

/-- Chinese remainder theorem on `Fin (p * L)` for coprime `p, L`: any residues modulo `p` and `L`
are simultaneously realized. -/
lemma crt_fin_exists {p L : ℕ} (hp : 0 < p) (hL : 0 < L) (hcop : p.Coprime L) (a : ℕ) (ha : a < p)
    (b : ℕ) (hb : b < L) : ∃ n : Fin (p * L), n.val % p = a ∧ n.val % L = b := by
  obtain ⟨n, hn⟩ := chineseRemainder hcop a b
  use ⟨n % (p * L), mod_lt _ (Nat.mul_pos hp hL)⟩
  simp_all [ModEq, mod_eq_of_lt]

/-- The `swap 0 1` repeat `σ₀` either fixes a point or shifts its value by `±1`. -/
lemma swap01_val_trichotomy {k : ℕ} (σ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (n : Fin ((k + 1).lcmSeq)) :
    (σ₀ n).val = n.val ∨ (σ₀ n).val = n.val + 1 ∨ (σ₀ n).val + 1 = n.val := by
  rcases k with (_ | _ | k)
  · simp
  · native_decide +revert
  · rcases n with ⟨_ | _ | n, hn⟩ <;> simp_all [mod_eq_of_lt]
    rw [swap_apply_def]
    split_ifs <;> simp_all +arith [mod_add_div]
    · refine Or.inr <| Or.inl <| ?_
      linarith [mod_add_div (n + 2) (k + 3)]
    · refine Or.inr <| Or.inr <| ?_
      linarith [mod_add_div (n + 2) (k + 3)]

/-- A value within `1` of a residue-`5` point (mod `L ≥ 7`) has residue neither `0` nor `2`. -/
lemma mod_ne_zero_two_of_close {L n m : ℕ} (hL : L ≥ 7) (hn : n % L = 5)
    (hm : m = n ∨ m = n + 1 ∨ m + 1 = n) : m % L ≠ 0 ∧ m % L ≠ 2 := by
  obtain ⟨l, rfl⟩ := Nat.exists_eq_add_of_le hL
  rcases hm with (rfl | rfl | rfl)
  · simp_all
  · rw [add_mod, mod_eq_of_lt (a := 1) (by linarith), hn, mod_eq_of_lt (by linarith)]
    norm_num
  · rw [add_mod, mod_eq_of_lt (a := 1) (by linarith)] at hn
    constructor <;> intro h <;> rw [h, mod_eq_of_lt (by linarith)] at hn <;> contradiction

/-- A value at or one below a residue-`(L-1)` point (mod `L ≥ 7`) has residue neither `0` nor `2`. -/
lemma mod_ne_zero_two_of_close_Lm1 {L n m : ℕ} (hL : L ≥ 7) (hn : n % L = L - 1)
    (hm : m = n ∨ m + 1 = n) : m % L ≠ 0 ∧ m % L ≠ 2 := by
  rcases hm with (rfl | rfl)
  · constructor <;> (intro h; rw [h] at hn; grind only)
  · rw [Nat.add_mod, Nat.mod_eq_of_lt (a := 1) (by linarith)] at hn
    constructor <;> (intro h; rw [h, Nat.mod_eq_of_lt (by linarith)] at hn; grind only)

/-- Off the `0`-residue, `σ₀` either fixes a point or decreases its value by `1`. -/
lemma swap01_no_inc {k : ℕ} (σ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (n : Fin ((k + 1).lcmSeq)) (hp : n.val % (k + 1) ≠ 0) :
    (σ₀ n).val = n.val ∨ (σ₀ n).val + 1 = n.val := by
  rcases (swap01_val_trichotomy σ₀ hσ₀ n) with h | h | h
  · exact Or.inl h
  · rw [hσ₀, swap_apply_def, mul_div_self_eq_mod_sub_self] at h
    split_ifs at h with h' <;> simp_all only [Fin.ext_iff]
    · contradiction
    · grind
    · rw [Nat.add_sub_cancel' (mod_le _ _)] at h
      linarith
  · exact Or.inr h

/-- For prime `k + 1` with growth, equal residues modulo `k + 1` and `lcmSeq k` force equality. -/
lemma fin_lcmSeq_eq_of_mod_eq {k : ℕ} (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (h_prime : (k + 1).Prime)
    (a b : Fin ((k + 1).lcmSeq)) (hp : a.val % (k + 1) = b.val % (k + 1))
    (hL : a.val % k.lcmSeq = b.val % k.lcmSeq) : a = b := by
  have h_crt : a.val ≡ b.val [MOD (k + 1) * k.lcmSeq] := by
    rw [← modEq_and_modEq_iff_modEq_mul]
    tauto
    exact prime_coprime hne h_prime
  rw [← prime_lcmSeq_eq hne h_prime] at h_crt
  exact Fin.ext (mod_eq_of_lt a.2 ▸ mod_eq_of_lt b.2 ▸ h_crt)

/-- The synced `swap (5, L-1)` (with `L = lcmSeq k`) sends residue-`5` points to residue-`(L-1)`. -/
lemma swap_5_Lm1_maps_5 {k : ℕ} (hk : k ≥ 4) (h₁ : Perm (Fin ((k + 1).lcmSeq)))
    (hh₁ : ∀ x : Fin ((k + 1).lcmSeq), (h₁ x : ℕ) =
      (swap (⟨5, by linarith [lcmSeq_ge_12 hk]⟩ : Fin (k.lcmSeq))
        ⟨k.lcmSeq - 1, sub_one_lt_of_le (by linarith [lcmSeq_ge_12 hk]) (le_refl _)⟩
        ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (n : Fin ((k + 1).lcmSeq)) (hn : n.val % k.lcmSeq = 5) : (h₁ n).val % k.lcmSeq = k.lcmSeq - 1 :=
  by simp_all [swap_apply_def]

/-- The synced `swap (5, L-1)` (with `L = lcmSeq k`) sends residue-`(L-1)` points to residue-`5`. -/
lemma swap_5_Lm1_maps_Lm1 {k : ℕ} (hk : k ≥ 4) (h₁ : Perm (Fin ((k + 1).lcmSeq)))
    (hh₁ : ∀ x : Fin ((k + 1).lcmSeq), (h₁ x : ℕ) =
      (swap (⟨5, by linarith [lcmSeq_ge_12 hk]⟩ : Fin (k.lcmSeq))
        ⟨k.lcmSeq - 1, sub_one_lt_of_le (by linarith [lcmSeq_ge_12 hk]) (le_refl _)⟩
        ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (n : Fin ((k + 1).lcmSeq)) (hn : n.val % k.lcmSeq = k.lcmSeq - 1) : (h₁ n).val % k.lcmSeq = 5 := by
  specialize hh₁ n
  simp_all only [swap_apply_right, add_mul_mod_self_left]
  rw [mod_eq_of_lt]
  linarith [lcmSeq_ge_12 hk]

/-- Cube symmetry `(σ₀τ₀)³ = (τ₀σ₀)³` at a point fixed by `σ₀τ₀`. -/
lemma cube_sym_period1 {α : Type*} [DecidableEq α] {σ₀ τ₀ : Perm α} (hσ_sq : σ₀ * σ₀ = 1)
    (hτ_sq : τ₀ * τ₀ = 1) (m : α) (h : σ₀ (τ₀ m) = m) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) := by
  simp_all only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq]
  grind

/-- Cube symmetry `(σ₀τ₀)³ = (τ₀σ₀)³` at a point of `σ₀τ₀`-period dividing `2`. -/
lemma cube_sym_period2 {α : Type*} [DecidableEq α] {σ₀ τ₀ : Perm α} (hσ_sq : σ₀ * σ₀ = 1)
    (hτ_sq : τ₀ * τ₀ = 1) (m : α) (h : σ₀ (τ₀ (σ₀ (τ₀ m))) = m) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) := by
  simp_all only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq]
  grind

/-- Cube symmetry `(σ₀τ₀)³ = (τ₀σ₀)³` at a point of `σ₀τ₀`-period dividing `3`. -/
lemma cube_sym_period3 {α : Type*} [DecidableEq α] {σ₀ τ₀ : Perm α} (hσ_sq : σ₀ * σ₀ = 1)
    (hτ_sq : τ₀ * τ₀ = 1) (m : α) (h : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) := by
  simp_all only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq]
  grind

/--
If neither involution fixes `m` compatibly and `σ₀ (τ₀ m) ≠ m`, then `m` has `σ₀τ₀`-period `3`. -/
lemma period3_of_both_move {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq))
    (h_not_fix : ¬(((τ₀ m = m) ∧ (τ₀ (σ₀ m) = σ₀ m)) ∨ ((σ₀ m = m) ∧ (σ₀ (τ₀ m) = τ₀ m))))
    (h_not_p1 : σ₀ (τ₀ m) ≠ m) : σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  apply period3_all hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m
  simp only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq] at *
  push_neg at h_not_fix
  by_cases! hτ₀_m : τ₀ m = m <;> by_cases! hσ₀_m : σ₀ m = m
  · grind
  · grind
  · grind
  · by_contra h
    have hτ_mod : m.val % k.lcmSeq = 0 ∨ m.val % k.lcmSeq = 2 := by
      contrapose! hτ₀_m
      exact τ_fix_of_mod_ne_0_2 τ₀ hτ₀ m hτ₀_m.1 hτ₀_m.2
    suffices τ₀ (σ₀ m) = σ₀ m by grind
    rw [← Fin.val_ne_iff] at hσ₀_m
    rcases (swap01_val_trichotomy σ₀ hσ₀ m) with (h₁ | h₁ | h₁) <;> try contradiction
    · apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀ <;> rcases hτ_mod with (h₂ | h₂)
      all_goals rw [h₁, add_mod, h₂, mod_eq_of_lt (a := 1), mod_eq_of_lt]
      all_goals linarith [lcmSeq_ge_12 hk]
    · apply τ_fix_of_mod_ne_0_2 τ₀ hτ₀ <;> rcases hτ_mod with (h₂ | h₂)
      all_goals by_contra h
      all_goals apply congr_arg (fun n ↦ n % k.lcmSeq) at h₁
      all_goals rw [h₂, add_mod, h, mod_eq_of_lt (a := 1), mod_eq_of_lt] at h₁
      all_goals linarith [lcmSeq_ge_12 hk]

/-- The orbit period of any element under `σ₀ τ₀` divides `3`. -/
lemma period_divides_3 {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq)) :
    σ₀ (τ₀ m) = m ∨ σ₀ (τ₀ (σ₀ (τ₀ m))) = m ∨ σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = m := by
  by_cases h1 : σ₀ (τ₀ m) = m
  · exact Or.inl h1
  · by_cases h2 : ((τ₀ m = m) ∧ (τ₀ (σ₀ m) = σ₀ m)) ∨ ((σ₀ m = m) ∧ (σ₀ (τ₀ m) = τ₀ m))
    · exact Or.inr (Or.inl (invol_comm_fix hσ₀_sq hτ₀_sq h2))
    · exact Or.inr (Or.inr (period3_of_both_move hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m h2 h1))

/-- Cube symmetry: `(σ₀ τ₀)³ = (τ₀ σ₀)³` pointwise. -/
lemma cube_sym {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) (m : Fin ((k + 1).lcmSeq)) :
    σ₀ (τ₀ (σ₀ (τ₀ (σ₀ (τ₀ m))))) = τ₀ (σ₀ (τ₀ (σ₀ (τ₀ (σ₀ m))))) := by
  rcases period_divides_3 hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq m with h1 | h2 | h3
  · exact cube_sym_period1 hσ₀_sq hτ₀_sq m h1
  · exact cube_sym_period2 hσ₀_sq hτ₀_sq m h2
  · exact cube_sym_period3 hσ₀_sq hτ₀_sq m h3

/-- The commutator `g = σ₀ * τ₀ * σ₀ * τ₀` satisfies `g³ = 1`. -/
lemma commutator_cubed {k : ℕ} (hk : k ≥ 4) (σ₀ τ₀ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ₀ : ∀ x : Fin ((k + 1).lcmSeq), (σ₀ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (hτ₀ : ∀ x : Fin ((k + 1).lcmSeq), (τ₀ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ₀_sq : σ₀ * σ₀ = 1) (hτ₀_sq : τ₀ * τ₀ = 1) :
    let g := (σ₀ * τ₀ * σ₀ * τ₀)
    g * g * g = 1 := by
  ext n
  have := cube_sym hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq n
  simp only [Perm.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq] at hσ₀_sq hτ₀_sq
  simp [this, hσ₀_sq, hτ₀_sq]

/-- `CT (k + 1)` contains a 3-cycle when `k + 1` is prime. -/
lemma CT_growth_three_cycle_prime {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (ih : CT k = ⊤) (h_prime : (k + 1).Prime) : ∃ σ ∈ CT (k + 1), σ.IsThreeCycle := by
  have hL_ge := lcmSeq_ge_12 hk
  have hN_eq := prime_lcmSeq_eq hne h_prime
  have hcop := prime_coprime hne h_prime
  set σ₀ :=
    (swap (0 : Fin (k + 1)) 1).dvdRepeat
      (dvd_lcmSeq_of_mem
        (show k + 1 ∈ Finset.Ioc 0 (k + 1) from Finset.mem_Ioc.mpr ⟨by omega, le_refl _⟩))
  have hσ₀_mem : σ₀ ∈ CT (k + 1) := swap01_dvdRepeat_mem_CT hk
  have hσ₀ :
    ∀ x : Fin (lcmSeq (k + 1)),
      (σ₀ x : ℕ) =
        (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
          (k + 1) * (x.val / (k + 1)) :=
    fun x ↦ by convert dvdRepeat_apply_val _ _ _ using 1
  have hσ₀_sq : σ₀ * σ₀ = 1 := dvdRepeat_swap_sq _ _ _
  set τ₀ := (swap (0 : Fin (k.lcmSeq)) 2).dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ)
  have hτ₀_mem : τ₀ ∈ CT (k + 1) := syncPerm_mem_CT ih _
  have hτ₀ :
    ∀ x : Fin (lcmSeq (k + 1)),
      (τ₀ x : ℕ) =
        (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
          k.lcmSeq * (x.val / k.lcmSeq) :=
    fun x ↦ by convert dvdRepeat_apply_val _ _ _ using 1
  have hτ₀_sq : τ₀ * τ₀ = 1 := dvdRepeat_swap_sq _ _ _
  set h₁ :=
    (swap (⟨5, by linarith⟩ : Fin (k.lcmSeq))
          ⟨k.lcmSeq - 1, sub_one_lt_of_le (by linarith) (le_refl _)⟩).dvdRepeat
      (k.lcmSeq_dvd_lcmSeq_succ)
  have hh₁_mem : h₁ ∈ CT (k + 1) := syncPerm_mem_CT ih _
  have hh₁ :
    ∀ x : Fin (lcmSeq (k + 1)),
      (h₁ x : ℕ) =
        (swap (⟨5, by linarith⟩ : Fin (k.lcmSeq))
              ⟨k.lcmSeq - 1, sub_one_lt_of_le (by linarith) (le_refl _)⟩
              ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ :
            ℕ) +
          k.lcmSeq * (x.val / k.lcmSeq) :=
    fun x ↦ by convert dvdRepeat_apply_val _ _ _ using 1
  have hh₁_sq : h₁ * h₁ = 1 := dvdRepeat_swap_sq _ _ _
  have hh₁_invol : ∀ x, h₁ (h₁ x) = x := by
    intro x
    simpa [Perm.mul_apply] using congr_fun (congr_arg (↑·) hh₁_sq) x
  have hτ₀_fix :
    ∀ n : Fin (lcmSeq (k + 1)), n.val % k.lcmSeq ≠ 0 → n.val % k.lcmSeq ≠ 2 → τ₀ n = n :=
    fun n h0 h2 ↦ τ_fix_of_mod_ne_0_2 τ₀ hτ₀ n h0 h2
  have hh₁_fix :
    ∀ n : Fin (lcmSeq (k + 1)), n.val % k.lcmSeq ≠ 5 → n.val % k.lcmSeq ≠ k.lcmSeq - 1 → h₁ n = n := by
    intro n h5 hLm1
    specialize hh₁ n
    simp only [swap_apply_def, Fin.ext_iff, h5, ↓reduceIte, hLm1] at hh₁
    rw [Fin.ext_iff, hh₁, mod_add_div]
  set g := σ₀ * τ₀ * σ₀ * τ₀
  set g'' := h₁ * g * h₁
  set result := g * g'' * g''
  obtain ⟨A', hA'_p, hA'_L⟩ :=
    crt_fin_exists k.succ_pos k.lcmSeq_pos hcop 3 (by omega) 2 (by linarith)
  set A : Fin ((k + 1).lcmSeq) := (finCongr hN_eq.symm) A'
  have hA_p : A.val % (k + 1) = 3 := hA'_p
  have hA_L : A.val % k.lcmSeq = 2 := hA'_L
  have hA_lt : A.val < lcmSeq (k + 1) := A.2
  have hA_ge : A.val ≥ k.lcmSeq + 2 := by
    by_cases! hA_lt : A.val < k.lcmSeq
    · rw [mod_eq_of_lt hA_lt] at hA_L
      rw [hA_L, mod_eq_of_lt (by linarith)] at hA_p
      contradiction
    · obtain ⟨a, ha⟩ := Nat.exists_eq_add_of_le hA_lt
      rw [ha, add_mod_left] at hA_L
      rw [ha, ge_iff_le, Nat.add_le_add_iff_left, ← hA_L]
      exact a.mod_le k.lcmSeq
  have hA_quot_ge : A.val / k.lcmSeq ≥ 1 := Nat.div_pos (by omega) (k.lcmSeq_pos)
  have hpL_bound : A.val < (k + 1) * k.lcmSeq := hN_eq ▸ hA_lt
  set Am2 : Fin ((k + 1).lcmSeq) := ⟨A.val - 2, by omega⟩
  have hAm2_p : Am2.val % (k + 1) = 1 := by
    show (A.val - 2) % (k + 1) = 1
    rw [← A.val.mod_add_div (k + 1), hA_p]
    trans ((k + 1) * (A / (k + 1)) + 1) % (k + 1)
    · grind
    · rw [mul_add_mod, mod_eq_of_lt]
      exact h_prime.one_lt
  have hAm2_L : Am2.val % k.lcmSeq = 0 := by
    show (A.val - 2) % k.lcmSeq = 0
    rw [← A.val.div_add_mod k.lcmSeq, hA_L, Nat.add_sub_cancel]
    exact mul_mod_right _ _
  set B : Fin ((k + 1).lcmSeq) := ⟨A.val - 3, by omega⟩
  have hB_p : B.val % (k + 1) = 0 := by
    show (A.val - 3) % (k + 1) = 0
    rw [← A.val.div_add_mod (k + 1), hA_p, Nat.add_sub_cancel]
    exact mul_mod_right _ _
  have hB_L : B.val % k.lcmSeq = k.lcmSeq - 1 := by
    show (A.val - 3) % k.lcmSeq = k.lcmSeq - 1
    rw [← A.val.mod_add_div k.lcmSeq, hA_L]
    trans (k.lcmSeq * (A.val / k.lcmSeq - 1) + (k.lcmSeq - 1)) % k.lcmSeq
    · congr
      apply Nat.sub_eq_of_eq_add
      nlinarith only [Nat.sub_add_cancel hA_quot_ge, Nat.sub_add_cancel k.lcmSeq_pos]
    · rw [mul_add_mod, self_sub_mod]
  set C : Fin ((k + 1).lcmSeq) := ⟨A.val - k.lcmSeq + 3, by omega⟩
  have hC_L : C.val % k.lcmSeq = 5 := by
    show (A.val - k.lcmSeq + 3) % k.lcmSeq = 5
    rw [← A.val.mod_add_div k.lcmSeq, hA_L, add_mod, ← mod_eq_sub_mod (by nlinarith),
      add_mul_mod_self_left, ← add_mod]
    refine mod_eq_of_lt ?_
    linarith
  have hAB : A ≠ B := by
    simp only [ne_eq, Fin.ext_iff, show B.val = A.val - 3 from rfl]
    omega
  have hBC : B ≠ C := by
    simp only [ne_eq, Fin.ext_iff, show B.val = A.val - 3 from rfl,
      show C.val = A.val - lcmSeq k + 3 from rfl]
    omega
  have hAC : A ≠ C := by
    simp only [ne_eq, Fin.ext_iff, show C.val = A.val - lcmSeq k + 3 from rfl]
    omega
  refine ⟨result, ?_, ?_⟩
  · have hg : g ∈ CT (k + 1) :=
      Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hσ₀_mem hτ₀_mem) hσ₀_mem) hτ₀_mem
    have hg'' : g'' ∈ CT (k + 1) := Subgroup.mul_mem _ (Subgroup.mul_mem _ hh₁_mem hg) hh₁_mem
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hg hg'') hg''
  · have hσ₀_A : σ₀ A = A := σ_fix_of_mod_ge_2 _ hσ₀ _ (by norm_num [hA_p])
    have hτ₀_A : τ₀ A = Am2 := Fin.ext (τ_val_of_l2 hk τ₀ hτ₀ A hA'_L)
    have hσ₀_Am2 : σ₀ Am2 = B := Fin.ext (σ_val_of_p1 _ hσ₀ Am2 hAm2_p)
    have hτ₀_B : τ₀ B = B := hτ₀_fix B (by omega) (by omega)
    have hτ₀_Am2 : τ₀ Am2 = A := by
      rw [← hτ₀_A]
      simp only [Equiv.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq] at hτ₀_sq
      exact hτ₀_sq A
    have hσ₀_B : σ₀ B = Am2 := by
      rw [← hσ₀_Am2]
      simp only [Equiv.ext_iff, Perm.coe_mul, Function.comp_apply, Perm.coe_one, id_eq] at hσ₀_sq
      exact hσ₀_sq Am2
    have hg_A : g A = Am2 := by
      show σ₀ (τ₀ (σ₀ (τ₀ A))) = Am2
      rw [hτ₀_A, hσ₀_Am2, hτ₀_B, hσ₀_B]
    have hg_Am2 : g Am2 = B := by
      show σ₀ (τ₀ (σ₀ (τ₀ Am2))) = B
      rw [hτ₀_Am2, hσ₀_A, hτ₀_A, hσ₀_Am2]
    have hg_B : g B = A := by
      show σ₀ (τ₀ (σ₀ (τ₀ B))) = A
      rw [hτ₀_B, hσ₀_B, hτ₀_Am2, hσ₀_A]
    have hg_C : g C = C := by
      apply invol_comm_fix hσ₀_sq hτ₀_sq
      left
      constructor
      · apply hτ₀_fix C <;> norm_num [hC_L]
      · apply hτ₀_fix (σ₀ C)
        · refine (mod_ne_zero_two_of_close ?_ hC_L (swap01_val_trichotomy σ₀ hσ₀ C)).1
          linarith
        · refine (mod_ne_zero_two_of_close ?_ hC_L (swap01_val_trichotomy σ₀ hσ₀ C)).2
          linarith
    have hh₁_A : h₁ A = A :=
      hh₁_fix A (by norm_num [hA_L]) (by
          rw [hA_L]
          omega)
    have hh₁_Am2 : h₁ Am2 = Am2 :=
      hh₁_fix Am2 (by norm_num [hAm2_L]) (by
          rw [hAm2_L]
          omega)
    have hh₁_B : h₁ B = C := by
      simp only [Fin.ext_iff, hh₁, hB_L, swap_apply_right]
      show 5 + k.lcmSeq * ((A.val - 3) / k.lcmSeq) = A.val - k.lcmSeq + 3
      suffices (A - 3) / k.lcmSeq = (A / k.lcmSeq) - 1 by
        rw [this, Nat.mul_sub, mul_one, show 5 = 2 + 3 by norm_num, add_comm, ← Nat.add_assoc,
          Nat.add_right_cancel_iff, add_comm, ← Nat.add_sub_assoc, ← hA_L, mod_add_div]
        nlinarith
      rw [show 3 = 2 + 1 by norm_num, ← Nat.sub_sub, ← hA_L, ← mul_div_self_eq_mod_sub_self,
        mul_sub_div, Nat.zero_div, zero_add]
      exact Nat.mul_pos k.lcmSeq_pos (Nat.div_pos (by omega) k.lcmSeq_pos)
    have hh₁_C : h₁ C = B := hh₁_B ▸ hh₁_invol B
    have hg''_A : g'' A = Am2 := by
      show h₁ (g (h₁ A)) = Am2
      rw [hh₁_A, hg_A, hh₁_Am2]
    have hg''_Am2 : g'' Am2 = C := by
      show h₁ (g (h₁ Am2)) = C
      rw [hh₁_Am2, hg_Am2, hh₁_B]
    have hg''_B : g'' B = B := by
      show h₁ (g (h₁ B)) = B
      rw [hh₁_B, hg_C, hh₁_C]
    have hg''_C : g'' C = A := by
      show h₁ (g (h₁ C)) = A
      rw [hh₁_C, hg_B, hh₁_A]
    have hres_A : result A = C := by
      show (g * g'' * g'') A = C
      simp [hg''_A, hg''_Am2, hg_C]
    have hres_B : result B = A := by
      show (g * g'' * g'') B = A
      simp [hg''_B, hg_B]
    have hres_C : result C = B := by
      show (g * g'' * g'') C = B
      simp [hg''_C, hg''_A, hg_Am2]
    have hg_cubed : g * g * g = 1 := commutator_cubed hk σ₀ τ₀ hσ₀ hτ₀ hσ₀_sq hτ₀_sq
    have hg_cubed_app : ∀ x, g (g (g x)) = x := by simpa [Equiv.ext_iff] using hg_cubed
    have hg2_fix : ∀ x, g (g x) = x → g x = x := fun x h ↦
      (congr_arg g h).symm.trans (hg_cubed_app x)
    have hg_fix_gn : ∀ x, g (g x) = g x → g x = x := fun x h ↦
      hg2_fix x ((congr_arg g h).symm.trans (hg_cubed_app x))
    have hg_L5 : ∀ m : Fin (lcmSeq (k + 1)), m.val % k.lcmSeq = 5 → g m = m := by
      intro m hm
      apply invol_comm_fix hσ₀_sq hτ₀_sq
      left
      refine ⟨by
          apply hτ₀_fix m <;>
            ( rw [hm]
              omega),
          ?_⟩
      apply hτ₀_fix (σ₀ m)
      · refine (mod_ne_zero_two_of_close ?_ hm (swap01_val_trichotomy σ₀ hσ₀ m)).1
        linarith
      · refine (mod_ne_zero_two_of_close ?_ hm (swap01_val_trichotomy σ₀ hσ₀ m)).2
        linarith
    have hg_Lm1 : ∀ m : Fin (lcmSeq (k + 1)), m.val % k.lcmSeq = k.lcmSeq - 1 → m ≠ B → g m = m := by
      intro m hm hmB
      have hm_p_ne0 : m.val % (k + 1) ≠ 0 := fun hp ↦
        hmB <| fin_lcmSeq_eq_of_mod_eq hne h_prime m B (hp.trans hB_p.symm) (hm.trans hB_L.symm)
      apply invol_comm_fix hσ₀_sq hτ₀_sq
      left
      refine ⟨hτ₀_fix m (by omega) (by omega), ?_⟩
      apply hτ₀_fix (σ₀ m)
      · refine (mod_ne_zero_two_of_close_Lm1 ?_ hm (swap01_no_inc σ₀ hσ₀ m hm_p_ne0)).1
        linarith
      · refine (mod_ne_zero_two_of_close_Lm1 ?_ hm (swap01_no_inc σ₀ hσ₀ m hm_p_ne0)).2
        linarith
    have hres_fix : ∀ n : Fin (lcmSeq (k + 1)), n ≠ A → n ≠ C → n ≠ B → result n = n := by
      intro n hnA hnC hnB
      show (g * g'' * g'') n = n
      by_cases hnAm2 : n = Am2
      · subst hnAm2
        simp [hg''_Am2, hg''_C, hg_A]
      · by_cases hgn : g n = n
        · have hg''n : g'' n = n := by
            show h₁ (g (h₁ n)) = n
            by_cases hh1n : h₁ n = n
            · rw [hh1n, hgn, hh1n]
            · have : g (h₁ n) = h₁ n := by
                by_cases hL5 : n.val % k.lcmSeq = 5
                · have : h₁ n ≠ B := fun heq ↦ hnC (by rw [← hh₁_invol n, heq, hh₁_B])
                  exact hg_Lm1 (h₁ n) (swap_5_Lm1_maps_5 hk h₁ hh₁ n hL5) this
                · by_cases hLm1 : n.val % k.lcmSeq = k.lcmSeq - 1
                  · exact hg_L5 (h₁ n) (swap_5_Lm1_maps_Lm1 hk h₁ hh₁ n hLm1)
                  · exact absurd (hh₁_fix n hL5 hLm1) hh1n
              rw [this]
              exact hh₁_invol n
          simp [hg''n, hgn]
        · have hn5 : n.val % k.lcmSeq ≠ 5 := fun h ↦ hgn (hg_L5 n h)
          have hnLm1 : n.val % k.lcmSeq ≠ k.lcmSeq - 1 := fun h ↦ hgn (hg_Lm1 n h hnB)
          have hh1n : h₁ n = n := hh₁_fix n hn5 hnLm1
          have hgn5 : (g n).val % k.lcmSeq ≠ 5 := fun h ↦ hgn (hg_fix_gn n (hg_L5 (g n) h))
          have hgnLm1 : (g n).val % k.lcmSeq ≠ k.lcmSeq - 1 := by
            intro h
            by_cases hgnB : g n = B
            · apply hnAm2
              rw [← hg_cubed_app n, hgnB, hg_B, hg_A]
            · exact hgn (hg_fix_gn n (hg_Lm1 (g n) h hgnB))
          have hh1gn : h₁ (g n) = g n := hh₁_fix (g n) hgn5 hgnLm1
          have hg2n5 : (g (g n)).val % k.lcmSeq ≠ 5 := fun h ↦
            hgn (hg2_fix n ((hg_L5 (g (g n)) h).symm.trans (hg_cubed_app n)))
          have hg2nLm1 : (g (g n)).val % k.lcmSeq ≠ k.lcmSeq - 1 := by
            intro h
            by_cases hg2B : g (g n) = B
            · refine hnA ?_
              rw [← hg_cubed_app n, hg2B, hg_B]
            · exact hgn (hg2_fix n ((hg_Lm1 (g (g n)) h hg2B).symm.trans (hg_cubed_app n)))
          have hh1g2n : h₁ (g (g n)) = g (g n) := hh₁_fix (g (g n)) hg2n5 hg2nLm1
          have hgppn : g'' n = g n := by
            show h₁ (g (h₁ n)) = g n
            rw [hh1n, hh1gn]
          have hgppgn : g'' (g n) = g (g n) := by
            show h₁ (g (h₁ (g n))) = g (g n)
            rw [hh1gn, hh1g2n]
          simp [hgppn, hgppgn, hg_cubed_app]
    exact isThreeCycle_of_vals hAC hBC.symm hAB hres_A hres_C hres_B hres_fix

/-- In the composite case, elements with small column in rows ≥ 1 have `n % (k + 1) ≥ 2`. -/
lemma mod_ge_two_of_composite {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (h_not_prime : ¬(k + 1).Prime) (n : ℕ) (hn_ge : n ≥ k.lcmSeq) (hn_lt : n < (k + 1).lcmSeq)
    (h_col : n % k.lcmSeq ≤ 2) : 2 ≤ n % (k + 1) := by
  obtain ⟨p, m, hp, hk, hkp⟩ := exist_prime_of_lcmSeq_ne_succ hne
  obtain ⟨q, hq⟩ : p ^ m ∣ k.lcmSeq := by
    apply dvd_lcmSeq_of_mem
    rw [Finset.mem_Ioc]
    refine ⟨Nat.pow_pos hp.pos, ?_⟩
    apply le_of_lt_add_one
    rw [hk]
    exact pow_lt_pow_right₀ hp.one_lt (Nat.lt_succ_iff.mpr (le_refl m))
  have m_pos : m ≠ 0 := by
    by_contra!
    rw [hk, this, zero_add, pow_one] at h_not_prime
    contradiction
  rw [← n.mod_add_div k.lcmSeq, hk, pow_succ, add_mod, hq, Nat.mul_assoc, mul_mod_mul_left, ← hq]
  have h_mod : (q * (n / k.lcmSeq)) % p ≠ 0 := by
    by_contra h
    rw [← dvd_iff_mod_eq_zero, hp.dvd_mul] at h
    rcases h with h | h
    · apply hne
      rw [lcmSeq_succ_eq_iff_dvd, hk, hq, pow_succ]
      exact Nat.mul_dvd_mul_left _ h
    · apply not_dvd_of_pos_of_lt _ _ h
      · exact Nat.div_pos hn_ge k.lcmSeq_pos
      · rw [Nat.div_lt_iff_lt_mul k.lcmSeq_pos, ← hkp]
        exact hn_lt
  rw [mod_eq_of_lt, mod_eq_of_lt]
  · apply le_add_left_of_le
    trans p ^ m
    · apply le_trans hp.two_le
      exact le_pow (zero_lt_of_ne_zero m_pos)
    · apply Nat.le_mul_of_pos_right
      exact zero_lt_of_ne_zero h_mod
  · grind
  · nth_rw 6 [← sub_one_add_one hp.ne_zero]
    rw [lt_iff_add_one_le, mul_add, mul_one, add_comm, ← Nat.add_assoc, add_comm]
    apply Nat.add_le_add
    · apply Nat.mul_le_mul_left
      rw [le_iff_lt_add_one, sub_one_add_one hp.ne_zero]
      exact mod_lt _ hp.pos
    · rw [add_comm, mod_eq_of_lt]
      · apply add_one_le_of_lt
        apply lt_of_le_of_lt h_col
        suffices 1 < m ∨ 2 < p by
          rcases this with h | h
          · apply lt_of_le_of_lt hp.two_le
            nth_rw 1 [← pow_one p]
            exact Nat.pow_lt_pow_right hp.one_lt h
          · apply lt_of_lt_of_le h
            exact Nat.le_self_pow m_pos p
        by_contra! ⟨h₁, h₂⟩
        interval_cases m
        · contradiction
        · rw [pow_succ, pow_one] at hk
          nlinarith
      · grind

/-- In the composite case, if `n % (k + 1) = 0` then `(n + 1) % lcmSeq k ∉ {0, 2}`. -/
lemma composite_col_plus1 {k : ℕ} (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (h_not_prime : ¬(k + 1).Prime)
    (n : ℕ) (h_mod : n % (k + 1) = 0) : (n + 1) % k.lcmSeq ≠ 0 ∧ (n + 1) % k.lcmSeq ≠ 2 := by
  obtain ⟨p, m, hp, hk, hkp⟩ := exist_prime_of_lcmSeq_ne_succ hne
  have h_div : p ^ m ∣ k.lcmSeq := by
    apply dvd_lcmSeq_of_mem
    rw [Finset.mem_Ioc]
    refine ⟨Nat.pow_pos hp.pos, ?_⟩
    apply le_of_lt_add_one
    rw [hk]
    exact pow_lt_pow_right₀ hp.one_lt (Nat.lt_succ_iff.mpr (le_refl m))
  have h_mod_p : n % p ^ m = 0 := by
    apply mod_eq_zero_of_dvd
    apply dvd_trans (pow_dvd_pow _ (m.le_add_right 1))
    rw [← hk, dvd_iff_mod_eq_zero]
    exact h_mod
  have m_pos : m ≠ 0 := by
    by_contra!
    rw [hk, this, zero_add, pow_one] at h_not_prime
    contradiction
  have h_mod_p : (n + 1) % p ^ m = 1 := by
    rw [add_mod, h_mod_p, zero_add, mod_mod, mod_eq_of_lt]
    exact lt_of_lt_of_le hp.one_lt (Nat.le_self_pow m_pos _)
  have := mod_mod_of_dvd (n + 1) h_div
  constructor <;> intro h <;> simp_all
  by_cases! hpm : p = 2 ∧ m = 1
  · rw [hpm.1, hpm.2, pow_one, mod_self] at this
    contradiction
  · rw [mod_eq_of_lt] at this
    · contradiction
    · by_cases! hp2 : p = 2
      · grind
      · apply lt_of_lt_of_le (Nat.lt_of_le_of_ne hp.two_le hp2.symm)
        exact Nat.le_self_pow m_pos _

/--
In the composite case, if `col ≥ 3` and `n % (k + 1) = 1`, then `(n - 1) % lcmSeq k ∉ {0, 2}`. -/
lemma composite_col_minus1 {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (h_not_prime : ¬(k + 1).Prime) (n : ℕ) (h_col : n % k.lcmSeq ≥ 3) (h_mod : n % (k + 1) = 1) :
    (n - 1) % k.lcmSeq ≠ 0 ∧ (n - 1) % k.lcmSeq ≠ 2 := by
  obtain ⟨p, m, hp, hk_eq, hkp⟩ := exist_prime_of_lcmSeq_ne_succ hne
  have h_div : p ^ m ∣ k.lcmSeq := by
    apply dvd_lcmSeq_of_mem
    rw [Finset.mem_Ioc]
    refine ⟨Nat.pow_pos hp.pos, ?_⟩
    apply le_of_lt_add_one
    rw [hk_eq]
    exact pow_lt_pow_right₀ hp.one_lt (Nat.lt_succ_iff.mpr (le_refl m))
  have m_pos : m ≠ 0 := by
    by_contra!
    rw [hk_eq, this, zero_add, pow_one] at h_not_prime
    contradiction
  have h_mod_p : ((n - 1) % k.lcmSeq) % p ^ m = 0 := by
    rw [mod_mod_of_dvd _ h_div, ← dvd_iff_mod_eq_zero]
    apply Nat.dvd_trans (pow_dvd_pow _ (Nat.le_add_right _ _))
    rw [← hk_eq]
    apply dvd_of_mod_eq_zero
    rw [← n.mod_add_div (k + 1), h_mod]
    norm_num [add_mod, mul_mod]
  constructor <;> intro h
  · rcases n with (_ | n) <;> simp_all
    rw [add_mod, h, zero_add, mod_mod, mod_eq_of_lt] at h_col
    · contradiction
    · linarith [lcmSeq_ge_12 hk]
  · rw [h] at h_mod_p
    have hp2 : p = 2 := by
      apply le_antisymm _ hp.two_le
      by_contra!
      rw [mod_eq_of_lt] at h_mod_p
      · contradiction
      · apply lt_of_lt_of_le this
        exact Nat.le_self_pow m_pos _
    subst hp2
    have hm1 : m = 1 := by
      apply le_antisymm
      · by_contra!
        rw [mod_eq_of_lt] at h_mod_p
        · contradiction
        · grind
      · omega
    subst hm1
    simp only [reduceAdd, reducePow, reduceEqDiff] at hk_eq
    omega

/-- In the composite case, the commutator `g = σ τ σ τ` maps `0 ↦ 1`. -/
lemma composite_g_val_zero {k : ℕ} (hk : k ≥ 4) (σ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ : ∀ x : Fin ((k + 1).lcmSeq), (σ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (τ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ : ∀ x : Fin ((k + 1).lcmSeq), (τ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq)) :
    (σ * τ * σ * τ) ⟨0, lcmSeq_pos _⟩ = ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
  have hτ0 : τ ⟨0, lcmSeq_pos _⟩ = ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hτ, Fin.coe_ofNat_eq_mod, zero_mod, swap_apply_left,
      Nat.zero_div, mul_zero, add_zero]
    rw [mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk])]
  have hσ2 :
    σ ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 2 < k + 1), swap_apply_def,
      Fin.coe_ofNat_eq_mod, zero_mod, OfNat.ofNat_ne_zero, ↓reduceIte,
      mod_eq_of_lt (by linarith : 1 < k + 1), OfNat.ofNat_ne_one, Nat.add_eq_left,
      _root_.mul_eq_zero, Nat.add_eq_zero_iff, one_ne_zero, and_false, Nat.div_eq_zero_iff,
      Order.lt_add_one_iff, false_or]
    linarith
  have hτ2 : τ ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨0, lcmSeq_pos _⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hτ, swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod,
      ↓reduceIte, Nat.add_eq_zero_iff, Fin.val_eq_zero_iff, ite_eq_right_iff, imp_self,
      _root_.mul_eq_zero, Nat.div_eq_zero_iff, or_self_left, true_and]
    right
    linarith [lcmSeq_ge_12 hk]
  have hσ0 : σ ⟨0, lcmSeq_pos _⟩ = ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp [Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 1 < k + 1)]
  simp only [Perm.coe_mul, Function.comp_apply, hτ0, hσ2, hτ2, hσ0]

/-- The commutator `g` maps `1 ↦ 2`. -/
lemma composite_g_val_one {k : ℕ} (hk : k ≥ 4) (σ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ : ∀ x : Fin ((k + 1).lcmSeq), (σ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (τ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ : ∀ x : Fin ((k + 1).lcmSeq), (τ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq)) :
    (σ * τ * σ * τ) ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ =
      ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
  have hτ1 :
    τ ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.ext_iff, hτ, mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 1 < k.lcmSeq),
      swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod, one_ne_zero, ↓reduceIte,
      mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 2 < k.lcmSeq), OfNat.one_ne_ofNat,
      Nat.add_eq_left, _root_.mul_eq_zero, Nat.div_eq_zero_iff, or_self_left]
    right
    linarith [lcmSeq_ge_12 hk]
  have hσ1 : σ ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨0, lcmSeq_pos _⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 1 < k + 1),
      swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod, one_ne_zero, ↓reduceIte, zero_add,
      _root_.mul_eq_zero, Nat.add_eq_zero_iff, and_false, Nat.div_eq_zero_iff, lt_add_iff_pos_left,
      false_or]
    linarith
  have hτ0 : τ ⟨0, lcmSeq_pos _⟩ = ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hτ, Fin.coe_ofNat_eq_mod, zero_mod, swap_apply_left,
      Nat.zero_div, mul_zero, add_zero]
    rw [mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk])]
  have hσ2 :
    σ ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 2 < k + 1), swap_apply_def,
      Fin.coe_ofNat_eq_mod, zero_mod, OfNat.ofNat_ne_zero, ↓reduceIte,
      mod_eq_of_lt (by linarith : 1 < k + 1), OfNat.ofNat_ne_one, Nat.add_eq_left,
      _root_.mul_eq_zero, Nat.add_eq_zero_iff, one_ne_zero, and_false, Nat.div_eq_zero_iff,
      Order.lt_add_one_iff, false_or]
    linarith
  simp only [Perm.coe_mul, Function.comp_apply, hτ1, hσ1, hτ0, hσ2]

/-- The commutator `g` maps `2 ↦ 0`. -/
lemma composite_g_val_two {k : ℕ} (hk : k ≥ 4) (σ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ : ∀ x : Fin ((k + 1).lcmSeq), (σ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (τ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ : ∀ x : Fin ((k + 1).lcmSeq), (τ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq)) :
    (σ * τ * σ * τ) ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨0, lcmSeq_pos _⟩ := by
  have hτ2 : τ ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨0, lcmSeq_pos _⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hτ, swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod,
      ↓reduceIte, Nat.add_eq_zero_iff, Fin.val_eq_zero_iff, ite_eq_right_iff, imp_self,
      _root_.mul_eq_zero, Nat.div_eq_zero_iff, or_self_left, true_and]
    right
    linarith [lcmSeq_ge_12 hk]
  have hσ0 : σ ⟨0, lcmSeq_pos _⟩ = ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp [Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 1 < k + 1)]
  have hτ1 :
    τ ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ := by
    simp only [Fin.ext_iff, hτ, mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 1 < k.lcmSeq),
      swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod, one_ne_zero, ↓reduceIte,
      mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 2 < k.lcmSeq), OfNat.one_ne_ofNat,
      Nat.add_eq_left, _root_.mul_eq_zero, Nat.div_eq_zero_iff, or_self_left]
    right
    linarith [lcmSeq_ge_12 hk]
  have hσ1 : σ ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩ = ⟨0, lcmSeq_pos _⟩ := by
    simp only [Fin.mk_zero', Fin.ext_iff, hσ, mod_eq_of_lt (by linarith : 1 < k + 1),
      swap_apply_def, Fin.coe_ofNat_eq_mod, zero_mod, one_ne_zero, ↓reduceIte, zero_add,
      _root_.mul_eq_zero, Nat.add_eq_zero_iff, and_false, Nat.div_eq_zero_iff, lt_add_iff_pos_left,
      false_or]
    linarith
  simp only [Perm.coe_mul, Function.comp_apply, hτ2, hσ0, hτ1, hσ1]

/-- The commutator `g` fixes all elements other than `0, 1, 2` in the composite case. -/
lemma composite_g_fix {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (h_not_prime : ¬(k + 1).Prime) (σ : Perm (Fin ((k + 1).lcmSeq)))
    (hσ : ∀ x : Fin ((k + 1).lcmSeq), (σ x : ℕ) =
      (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
      (k + 1) * (x.val / (k + 1)))
    (τ : Perm (Fin ((k + 1).lcmSeq)))
    (hτ : ∀ x : Fin ((k + 1).lcmSeq), (τ x : ℕ) =
      (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
      k.lcmSeq * (x.val / k.lcmSeq))
    (hσ_sq : σ * σ = 1) (hτ_sq : τ * τ = 1) (n : Fin ((k + 1).lcmSeq)) (hn0 : n ≠ ⟨0, lcmSeq_pos _⟩)
    (hn1 : n ≠ ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩)
    (hn2 : n ≠ ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩) : (σ * τ * σ * τ) n = n := by
  apply invol_comm_fix hσ_sq hτ_sq
  simp only [Perm.ext_iff] at hσ_sq hτ_sq
  by_cases! h_col : n.val % k.lcmSeq ≥ 3
  · have τ_fix : τ n = n := by apply τ_fix_of_mod_ne_0_2 τ hτ <;> linarith
    refine Or.inl ⟨τ_fix, ?_⟩
    by_cases! h_mod : n.val % (k + 1) = 0 ∨ n.val % (k + 1) = 1
    · rcases h_mod with h_mod | h_mod
      · have h_add : (σ n).val = n.val + 1 := by
          simp only [hσ, h_mod, Fin.zero_eta, swap_apply_left, Fin.coe_ofNat_eq_mod]
          rw [mod_eq_of_lt (by linarith : 1 < k + 1)]
          linarith [mod_add_div n (k + 1)]
        apply τ_fix_of_mod_ne_0_2 τ hτ <;> rw [h_add]
        · exact (composite_col_plus1 hne h_not_prime n h_mod).1
        · exact (composite_col_plus1 hne h_not_prime n h_mod).2
      · have h_sub : (σ n).val = n.val - 1 := by
          simp only [hσ, h_mod, swap_apply_def, Fin.ext_iff, Fin.coe_ofNat_eq_mod, zero_mod,
            one_ne_zero, ↓reduceIte, mod_eq_of_lt (by linarith : 1 < k + 1), zero_add]
          rw [mul_div_self_eq_mod_sub_self, h_mod]
        apply τ_fix_of_mod_ne_0_2 τ hτ <;> rw [h_sub]
        · exact (composite_col_minus1 hk hne h_not_prime n h_col h_mod).1
        · exact (composite_col_minus1 hk hne h_not_prime n h_col h_mod).2
    · have h_fix : σ n = n := σ_fix_of_mod_ge_2 σ hσ _ (by omega)
      apply τ_fix_of_mod_ne_0_2 τ hτ <;>
        ( rw [h_fix]
          omega)
  · have h_n_ge_lcmSeq : n.val ≥ k.lcmSeq := by
      by_contra! h
      rw [mod_eq_of_lt h] at h_col
      simp only [ne_eq, Fin.ext_iff] at hn0 hn1 hn2
      omega
    refine Or.inr ⟨σ_fix_of_mod_ge_2 σ hσ _ ?_, σ_fix_of_mod_ge_2 σ hσ _ ?_⟩
    · exact mod_ge_two_of_composite hk hne h_not_prime n h_n_ge_lcmSeq n.is_lt (by linarith)
    · apply mod_ge_two_of_composite hk hne h_not_prime _ _ (Fin.is_lt _)
      · simp only [hτ, swap_apply_def, Fin.mk_eq_zero, add_mul_mod_self_left]
        split_ifs <;> norm_num
        · exact mod_le _ _
        · omega
      · rw [hτ]
        apply le_trans (k.lcmSeq.le_add_left _)
        apply Nat.add_le_add_left
        nth_rw 1 [← mul_one k.lcmSeq]
        apply Nat.mul_le_mul_left
        exact Nat.div_pos h_n_ge_lcmSeq k.lcmSeq_pos

/-- `CT (k + 1)` contains a 3-cycle in the composite growth case. -/
lemma CT_growth_three_cycle_composite {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (ih : CT k = ⊤) (h_not_prime : ¬(k + 1).Prime) : ∃ σ ∈ CT (k + 1), σ.IsThreeCycle := by
  set σ :=
    (swap (0 : Fin (k + 1)) 1).dvdRepeat
      (dvd_lcmSeq_of_mem
        (show k + 1 ∈ Finset.Ioc 0 (k + 1) from Finset.mem_Ioc.mpr ⟨by omega, le_refl _⟩))
  set τ := (swap (0 : Fin (k.lcmSeq)) 2).dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ)
  have hσ :
    ∀ x : Fin (lcmSeq (k + 1)),
      (σ x : ℕ) =
        (swap (0 : Fin (k + 1)) 1 ⟨x.val % (k + 1), mod_lt _ (by omega)⟩ : ℕ) +
          (k + 1) * (x.val / (k + 1)) :=
    fun x ↦ by convert dvdRepeat_apply_val _ _ _ using 1
  have hτ :
    ∀ x : Fin (lcmSeq (k + 1)),
      (τ x : ℕ) =
        (swap (0 : Fin (k.lcmSeq)) 2 ⟨x.val % k.lcmSeq, mod_lt _ (lcmSeq_pos _)⟩ : ℕ) +
          k.lcmSeq * (x.val / k.lcmSeq) :=
    fun x ↦ by convert dvdRepeat_apply_val _ _ _ using 1
  have hσ_sq : σ * σ = 1 := dvdRepeat_swap_sq _ _ _
  have hτ_sq : τ * τ = 1 := dvdRepeat_swap_sq _ _ _
  refine ⟨σ * τ * σ * τ, ?_, ?_⟩
  · have hσ_mem : σ ∈ CT (k + 1) := swap01_dvdRepeat_mem_CT hk
    have hτ_mem : τ ∈ CT (k + 1) := syncPerm_mem_CT ih (swap 0 2)
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (Subgroup.mul_mem _ hσ_mem hτ_mem) hσ_mem) hτ_mem
  · apply isThreeCycle_of_vals (a := ⟨0, lcmSeq_pos _⟩) (b :=
          ⟨1, by linarith [lcmSeq_succ_ge_six hk]⟩) (c :=
          ⟨2, by linarith [lcmSeq_succ_ge_six hk]⟩) <;>
      simp
    · exact composite_g_val_zero hk σ hσ τ hτ
    · exact composite_g_val_one hk σ hσ τ hτ
    · exact composite_g_val_two hk σ hσ τ hτ
    · exact composite_g_fix hk hne h_not_prime σ hσ τ hτ hσ_sq hτ_sq

/-- `CT (k + 1)` contains a 3-cycle in the growth case. -/
theorem CT_growth_contains_three_cycle {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (ih : CT k = ⊤) : ∃ σ ∈ CT (k + 1), σ.IsThreeCycle := by
  by_cases hp : Nat.Prime (k + 1)
  · exact CT_growth_three_cycle_prime hk hne ih hp
  · exact CT_growth_three_cycle_composite hk hne ih hp

/-- If `0` is related to some non-zero `c` in row `0`, then `0` is related to every element of row
`0`. -/
lemma prim_row0_class {k : ℕ} (ih : CT k = ⊤) (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin ((k + 1).lcmSeq)) (hc0 : c ≠ 0) (hc_row0 : (c : ℕ) < k.lcmSeq) (hrel : r.r 0 c) :
    ∀ x : Fin ((k + 1).lcmSeq), (x : ℕ) < k.lcmSeq → r.r 0 x := by
  intro x hx_row0
  by_cases hx0 : x = 0
  · exact hx0.symm ▸ r.refl _
  · suffices ∃ σ : CT (k + 1), σ.1 0 = 0 ∧ σ.1 c = x by
      obtain ⟨σ, hσ0, hσc⟩ := this
      rw [← hσ0, ← hσc]
      exact hinv σ 0 c hrel
    refine ⟨⟨(swap ⟨c, hc_row0⟩ ⟨x, hx_row0⟩).dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ), ?_⟩, ?_, ?_⟩
    · exact syncPerm_mem_CT ih (swap ⟨↑c, hc_row0⟩ ⟨↑x, hx_row0⟩)
    · simp only [Fin.ext_iff, dvdRepeat_apply_val, Fin.modNat, Fin.val_cast, Fin.coe_ofNat_eq_mod,
        zero_mod, Fin.mk_zero', swap_apply_def, Nat.zero_div, mul_zero, add_zero]
      split_ifs with h <;> norm_num at *
      all_goals rw [Fin.ext_iff, Fin.val_zero] at hc0 hx0
      all_goals omega
    · simp only [Fin.ext_iff, dvdRepeat_apply_val, swap_apply_def, Fin.modNat, Fin.val_cast,
        mod_eq_of_lt hc_row0, ↓reduceIte, div_eq_of_lt hc_row0, mul_zero, add_zero]

/-- If `a ≈ b` and `a` and `b` are in different columns, then `0 ≈ 1`. -/
lemma prim_reduce_col_ne_zero {k : ℕ} (hk : k ≥ 4) (ih : CT k = ⊤)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (a b : Fin ((k + 1).lcmSeq)) (ha_row0 : (a : ℕ) < k.lcmSeq)
    (hcol_ne : (a : ℕ) % k.lcmSeq ≠ (b : ℕ) % k.lcmSeq) (hrel : r.r a b) : r.r 0 1 := by
  rw [mod_eq_of_lt ha_row0] at hcol_ne
  obtain ⟨v, hv0, hv1, hva⟩ : ∃ v : Fin (k.lcmSeq), v ≠ 0 ∧ v ≠ 1 ∧ v.val ≠ a.val := by
    suffices Finset.card (Finset.range k.lcmSeq \ {0, 1, a.val}) > 0 by
      obtain ⟨v, hv⟩ := Finset.card_pos.mp this
      simp only [Finset.mem_sdiff, Finset.mem_range, Finset.mem_insert, Finset.mem_singleton,
        not_or] at hv
      refine ⟨⟨v, hv.1⟩, ?_⟩
      simp only [ne_eq, Fin.ext_iff, Fin.coe_ofNat_eq_mod, zero_mod,
        mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 1 < k.lcmSeq)]
      exact hv.2
    rw [Finset.card_sdiff_of_subset, Finset.card_range]
    · rw [gt_iff_lt, Nat.sub_pos_iff_lt]
      apply lt_of_le_of_lt _ (by linarith [lcmSeq_ge_12 hk] : 3 < k.lcmSeq)
      grind
    · intro x hx
      simp only [Finset.mem_insert, Finset.mem_singleton, Finset.mem_range] at hx ⊢
      rcases hx with rfl | rfl | rfl <;> linarith [lcmSeq_ge_12 hk]
  obtain ⟨σ₁, hσ₁_a, hσ₁_b⟩ :
    ∃ σ₁ : Perm (Fin (k.lcmSeq)),
      σ₁ ⟨a, ha_row0⟩ = 0 ∧ σ₁ ⟨b % k.lcmSeq, mod_lt _ k.lcmSeq_pos⟩ = v := by
    use (swap ⟨b % k.lcmSeq, mod_lt _ k.lcmSeq_pos⟩ v).trans (swap ⟨a, ha_row0⟩ 0)
    constructor
    · simp only [trans_apply, swap_apply_def, hcol_ne, ↓reduceIte, Fin.ext_iff, hva.symm]
    · simp only [trans_apply, swap_apply_def, ↓reduceIte, Fin.ext_iff, hva, hv0]
  obtain ⟨σ₂, hσ₂_a, hσ₂_b⟩ :
    ∃ σ₂ : Perm (Fin (k.lcmSeq)),
      σ₂ ⟨a, ha_row0⟩ = 1 ∧ σ₂ ⟨b % k.lcmSeq, mod_lt _ k.lcmSeq_pos⟩ = v := by
    use (swap ⟨b % k.lcmSeq, mod_lt _ k.lcmSeq_pos⟩ v).trans (swap ⟨a, ha_row0⟩ 1)
    constructor
    · simp only [trans_apply, swap_apply_def, hcol_ne, ↓reduceIte, Fin.ext_iff, hva.symm]
    · simp only [trans_apply, swap_apply_def, ↓reduceIte, Fin.ext_iff, hva, hv1]
  apply r.trans (b := (dvdRepeat _ σ₁) b)
  · convert hinv ⟨_, syncPerm_mem_CT ih σ₁⟩ a b hrel using 1
    simp [Fin.ext_iff, dvdRepeat_apply_val, Fin.modNat, mod_eq_of_lt ha_row0, hσ₁_a, ha_row0]
  · symm
    convert hinv ⟨_, syncPerm_mem_CT ih σ₂⟩ a b hrel using 1
    · simp [Fin.ext_iff, dvdRepeat_apply_val, Fin.modNat, mod_eq_of_lt ha_row0, hσ₂_a,
        mod_eq_of_lt (by linarith [lcmSeq_ge_12 hk] : 1 < k.lcmSeq), ha_row0,
        mod_eq_of_lt (by linarith [lcmSeq_ge_12 (by linarith : 4 ≤ k + 1)] : 1 < (k + 1).lcmSeq)]
    · simp [Fin.ext_iff, dvdRepeat_apply_val, Fin.modNat, hσ₁_b, hσ₂_b]

/-- When `c` has column `0`, use a `CT' (k + 1)` generator to create distinct columns. -/
lemma prim_reduce_col_zero {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin ((k + 1).lcmSeq)) (hrel : r.r 0 c) (hc_ge : k.lcmSeq ≤ (c : ℕ))
    (hcol_zero : (c : ℕ) % k.lcmSeq = 0) :
    ∃ x : Fin ((k + 1).lcmSeq), x ≠ 0 ∧ (x : ℕ) < k.lcmSeq ∧ r.r 0 x := by
  have h_not_dvd : ¬(c.val % (k + 1) = 0) := by
    rw [← dvd_iff_mod_eq_zero]
    convert not_dvd_mul_lcmSeq hne (c.val / k.lcmSeq) ?_ ?_ using 1
    · rw [Nat.div_mul_cancel (dvd_of_mod_eq_zero hcol_zero)]
    · exact Nat.div_pos hc_ge k.lcmSeq_pos
    · exact lt_of_le_of_lt (div_mul_le_self _ _) c.2
  obtain ⟨m, hm⟩ : ∃ m : ℕ, m ∈ Finset.Icc 1 2 ∧ m ≠ c.val % (k + 1) := by
    by_contra! h
    linarith [h 1 (by norm_num), h 2 (by norm_num)]
  rw [Finset.mem_Icc] at hm
  have m_lt : m < (k + 1) := by linarith
  obtain ⟨g, g_mem, hg⟩ : ∃ g ∈ CT' (k + 1) (k + 1), g 0 = m ∧ g c = c := by
    refine ⟨dvdRepeat (dvd_lcmseq_self _) (swap 0 ⟨m, m_lt⟩), ?_, ?_, ?_⟩
    · unfold CT'
      simp only [Finset.mem_Ioc, lt_add_iff_pos_left, Order.lt_add_one_iff, _root_.zero_le, le_refl,
        and_self, ↓reduceDIte]
      refine Subgroup.subset_closure ⟨⟨0, ⟨m, ?_⟩⟩, rfl⟩
      linarith [hm.1.2, hk]
    · simp [dvdRepeat_apply_val, Fin.modNat]
    · ext
      simp [dvdRepeat_apply_val, swap_apply_def, Fin.modNat, hm.2.symm, h_not_dvd, mod_add_div]
  have g_mem_CT : g ∈ CT (k + 1) := by
    unfold CT
    refine Subgroup.mem_sSup_of_mem ?_ g_mem
    use k + 1
    simp only
    rw [ciSup_pos]
    rw [Finset.right_mem_Icc]
    linarith [hk]
  refine
    ⟨⟨m, lt_of_lt_of_le m_lt (le_of_dvd (k + 1).lcmSeq_pos (dvd_lcmseq_self (k + 1)))⟩, ?_, ?_, ?_⟩
  · rw [ne_eq, Fin.mk_eq_zero]
    linarith
  · simp only
    linarith [hm.1.2, lcmSeq_ge_12 hk]
  · apply r.trans hrel (r.symm _)
    convert hinv ⟨g, g_mem_CT⟩ _ _ hrel using 1
    · ext
      rw [hg.1]
    · rw [hg.2]

/-- Reduce a non-trivial equivalence to a pair within row `0`. -/
lemma prim_reduce_to_row0 {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (c : Fin ((k + 1).lcmSeq)) (hc0 : c ≠ 0) (hrel : r.r 0 c) :
    ∃ x : Fin ((k + 1).lcmSeq), x ≠ 0 ∧ (x : ℕ) < k.lcmSeq ∧ r.r 0 x := by
  by_cases hc_row0 : (c : ℕ) < k.lcmSeq
  · exact ⟨c, hc0, hc_row0, hrel⟩
  · by_cases hcol_zero : (c : ℕ) % k.lcmSeq = 0
    · exact prim_reduce_col_zero hk hne r hinv c hrel (le_of_not_gt hc_row0) hcol_zero
    · use ⟨1, lt_trans (by linarith [hk] : 1 < k + 1) (succ_le_lcmSeq (by linarith [hk]))⟩
      refine ⟨?_, ?_, ?_⟩
      · norm_num
      · exact lt_of_lt_of_le (by norm_num) (lcmSeq_ge_12 hk)
      · convert prim_reduce_col_ne_zero hk ih r hinv 0 c _ _ hrel using 1
        · ext
          rw [Fin.coe_ofNat_eq_mod, mod_eq_of_lt]
          linarith [lcmSeq_ge_12 (by linarith : k + 1 ≥ 4)]
        · exact k.lcmSeq_pos
        · symm
          simp [hcol_zero]

/-- The cross-row generator extends the equivalence class from row `0` to row `1`. -/
lemma prim_cross_row {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin ((k + 1).lcmSeq), (x : ℕ) < k.lcmSeq → r.r 0 x) :
    r.r 0
      ⟨k.lcmSeq,
        Nat.lt_of_le_of_ne (le_of_dvd (lcmSeq_pos _) (k.lcmSeq_dvd_lcmSeq_succ)) (hne.symm)⟩ := by
  have h_mod : ¬(k.lcmSeq % (k + 1) = 0) := by
    rw [← dvd_iff_mod_eq_zero]
    exact mt Nat.lcmSeq_succ_eq_iff_dvd.mpr hne
  set g :=
    dvdRepeat (dvd_lcmseq_self (k + 1))
      (swap ⟨(k.lcmSeq - 1) % (k + 1), mod_lt _ (succ_pos _)⟩
        ⟨k.lcmSeq % (k + 1), mod_lt _ (succ_pos _)⟩)
  apply r.trans (b := g 0)
  · apply hrow0
    simp only [dvdRepeat_apply_val, Fin.modNat, Fin.val_cast, Fin.coe_ofNat_eq_mod, zero_mod,
      Fin.zero_eta, swap_apply_def, Fin.zero_eq_mk, h_mod, ↓reduceIte, Nat.zero_div, mul_zero,
      add_zero, g]
    split_ifs
    · simp only
      exact lt_of_lt_of_le (mod_lt _ (k.zero_lt_succ)) (succ_le_lcmSeq hk)
    · exact k.lcmSeq_pos
  · convert hinv ⟨g, ?_⟩ 0 ⟨(k.lcmSeq - 1), _⟩ (hrow0 _ _)
    · simp only [dvdRepeat_apply_val, Fin.modNat, Fin.val_cast, swap_apply_left, g]
      rw [← succ_div_of_mod_ne_zero, sub_one_add_one, mod_add_div]
      · exact Nat.ne_zero_of_lt k.lcmSeq_pos
      · contrapose h_mod
        rw [sub_one_add_one (Nat.ne_zero_of_lt k.lcmSeq_pos)] at h_mod
        exact h_mod
    · unfold g CT
      suffices g ∈ CT' (k + 1) (k + 1) by
        refine Subgroup.mem_sSup_of_mem ?_ this
        use k + 1
        simp only
        rw [ciSup_pos]
        rw [Finset.right_mem_Icc]
        linarith [hk]
      unfold CT'
      simp only [Finset.mem_Ioc, lt_add_iff_pos_left, Order.lt_add_one_iff, _root_.zero_le, le_refl,
        and_self, ↓reduceDIte]
      exact Subgroup.subset_closure
          ⟨⟨⟨(k.lcmSeq - 1) % (k + 1), mod_lt _ (succ_pos _)⟩,
              ⟨k.lcmSeq % (k + 1), mod_lt _ (succ_pos _)⟩⟩,
            rfl⟩
    · apply sub_one_lt_of_le k.lcmSeq_pos
      exact lcmSeq_mono (k.le_add_right 1)
    · simp [k.lcmSeq_pos]

/-- Cross a row boundary at row `m`. -/
lemma prim_cross_row_m {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin ((k + 1).lcmSeq), (x : ℕ) < k.lcmSeq → r.r 0 x) (m : ℕ) (hm : 1 ≤ m)
    (hm_lt : m * k.lcmSeq < (k + 1).lcmSeq) (hprev : r.r 0 ⟨m * k.lcmSeq - 1, by omega⟩) :
    r.r 0 ⟨m * k.lcmSeq, hm_lt⟩ := by
  have h_mod : ¬(k.lcmSeq % (k + 1) = 0) := by
    rw [← dvd_iff_mod_eq_zero]
    exact mt Nat.lcmSeq_succ_eq_iff_dvd.mpr hne
  set g :=
    dvdRepeat (dvd_lcmseq_self (k + 1))
      (swap ⟨(m * k.lcmSeq - 1) % (k + 1), mod_lt _ (succ_pos _)⟩
        ⟨m * k.lcmSeq % (k + 1), mod_lt _ (succ_pos _)⟩)
  apply r.trans (b := g 0)
  · apply hrow0
    simp only [dvdRepeat_apply_val, Fin.modNat, Fin.val_cast, Fin.coe_ofNat_eq_mod, zero_mod,
      Fin.zero_eta, swap_apply_def, Fin.zero_eq_mk, Nat.zero_div, mul_zero, add_zero, g]
    split_ifs
    · simp only
      exact lt_of_lt_of_le (mod_lt _ (k.zero_lt_succ)) (succ_le_lcmSeq hk)
    · apply lt_of_lt_of_le _ (succ_le_lcmSeq hk)
      exact mod_lt _ k.zero_lt_succ
    · exact k.lcmSeq_pos
  · convert hinv ⟨g, ?_⟩ _ _ hprev
    · simp only [dvdRepeat_apply_val, Fin.modNat, Fin.val_cast, swap_apply_left, g]
      rw [same_block_at_boundary m (not_dvd_mul_lcmSeq hne m (by linarith) hm_lt), mod_add_div]
    · unfold g CT
      suffices g ∈ CT' (k + 1) (k + 1) by
        refine Subgroup.mem_sSup_of_mem ?_ this
        use k + 1
        simp only
        rw [ciSup_pos]
        rw [Finset.right_mem_Icc]
        linarith [hk]
      unfold CT'
      simp only [Finset.mem_Ioc, lt_add_iff_pos_left, Order.lt_add_one_iff, _root_.zero_le, le_refl,
        and_self, ↓reduceDIte]
      exact Subgroup.subset_closure
          ⟨⟨⟨(m * k.lcmSeq - 1) % (k + 1), mod_lt _ (succ_pos _)⟩,
              ⟨m * k.lcmSeq % (k + 1), mod_lt _ (succ_pos _)⟩⟩,
            rfl⟩

/-- Within a row, relate `0` to every column once the row's start is related to `0`. -/
lemma prim_fill_row {k : ℕ} (ih : CT k = ⊤) (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin ((k + 1).lcmSeq), (x : ℕ) < k.lcmSeq → r.r 0 x) (m : ℕ)
    (hm_lt : m * k.lcmSeq < (k + 1).lcmSeq) (hbase : r.r 0 ⟨m * k.lcmSeq, hm_lt⟩) (j : ℕ)
    (hj : j < k.lcmSeq) (hj_lt : m * k.lcmSeq + j < (k + 1).lcmSeq) :
    r.r 0 ⟨m * k.lcmSeq + j, hj_lt⟩ := by
  set σ : Perm (Fin (k.lcmSeq)) := swap ⟨0, k.lcmSeq_pos⟩ ⟨j, hj⟩
  have hσ : σ.dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ) ∈ CT (k + 1) := syncPerm_mem_CT ih σ
  apply r.trans (b := σ.dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ) 0)
  · apply hrow0
    convert hj
    simp [σ, dvdRepeat_apply_val, Fin.modNat]
  · convert hinv ⟨σ.dvdRepeat (k.lcmSeq_dvd_lcmSeq_succ), hσ⟩ 0 ⟨m * k.lcmSeq, hm_lt⟩ hbase
    simp [σ, dvdRepeat_apply_val, Fin.modNat, Nat.mul_div_cancel _ k.lcmSeq_pos]
    ring

/-- Once all of row `0` is related to `0`, every element is related to `0`. -/
lemma prim_extend_all_rows {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤)
    (r : Setoid (Fin ((k + 1).lcmSeq)))
    (hinv : ∀ (g : ↥(CT (k + 1))) (x y : Fin ((k + 1).lcmSeq)), r.r x y → r.r (g.1 x) (g.1 y))
    (hrow0 : ∀ x : Fin ((k + 1).lcmSeq), (x : ℕ) < k.lcmSeq → r.r 0 x) :
    ∀ x : Fin ((k + 1).lcmSeq), r.r 0 x := by
  intro x
  induction hm : (x / k.lcmSeq) generalizing x with
  | zero =>
    apply hrow0
    rw [← x.val.mod_add_div k.lcmSeq, hm, mul_zero, add_zero]
    exact mod_lt _ k.lcmSeq_pos
  | succ m ih_m =>
    have : (m + 1) * k.lcmSeq - 1 < (k + 1).lcmSeq := by
      apply sub_one_lt_of_le
      · exact Nat.mul_pos (succ_pos _) k.lcmSeq_pos
      · rw [← hm]
        apply le_trans (b := x.val)
        · rw [mul_comm]
          exact mul_div_le _ _
        · apply le_of_lt
          exact x.is_lt
    have hprev : r.r 0 ⟨(m + 1) * k.lcmSeq - 1, this⟩ := by
      apply ih_m
      simp only
      apply Nat.add_right_cancel (m := 1)
      rw [← succ_div_of_mod_eq_zero, sub_one_add_one, Nat.mul_div_cancel _ k.lcmSeq_pos]
      · exact Nat.ne_of_gt (Nat.mul_pos (succ_pos _) k.lcmSeq_pos)
      · rw [sub_one_add_one, mul_mod_left (m + 1) k.lcmSeq]
        apply Nat.ne_of_gt
        apply Nat.mul_pos (succ_pos _) k.lcmSeq_pos
    have hfirst :
      r.r 0
        ⟨(m + 1) * k.lcmSeq, by
          apply lt_of_le_of_lt _ x.is_lt
          rw [← hm, mul_comm]
          exact mul_div_le _ _⟩ := by
      convert prim_cross_row_m hk hne r hinv hrow0 (m + 1) (by linarith) _ _
      exact hprev
    by_cases h_mod : x.val % k.lcmSeq = 0
    · convert hfirst
      rw [← hm, Nat.div_mul_cancel]
      exact Nat.dvd_iff_mod_eq_zero.mpr h_mod
    · convert prim_fill_row ih r hinv hrow0 (m + 1) _ _ (x.val % k.lcmSeq) _ _
      · rw [← hm, div_add_mod']
      · grind
      · exact hfirst
      · exact mod_lt _ k.lcmSeq_pos
      · rw [← hm, div_add_mod']
        exact x.is_lt

/-- `CT (k + 1)` preserves only trivial equivalence relations. -/
lemma CT_growth_primitive {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤) :
    ∀ (r : Setoid (Fin ((k + 1).lcmSeq))),
      (∀ (g : ↥(CT (k + 1))) (a b : Fin ((k + 1).lcmSeq)), r.r a b → r.r (g.1 a) (g.1 b)) →
        (∀ a b : Fin ((k + 1).lcmSeq), r.r a b) ∨ (∀ a b : Fin ((k + 1).lcmSeq), r.r a b → a = b) := by
  intro r hinv
  by_cases! h : ∀ x y, r.r x y → x = y
  · right
    exact h
  · left
    obtain ⟨a, b, hab, hne_ab⟩ := h
    obtain ⟨⟨g, hg_mem⟩, hg_eq⟩ :=
      (CT_growth_transitive hk hne ih).exists_smul_eq a ⟨0, lcmSeq_pos _⟩
    have hga : g a = 0 := by simpa using hg_eq
    have h0c : r.r 0 (g b) := by
      have := hinv ⟨g, hg_mem⟩ a b hab
      rwa [hga] at this
    have hc_ne : g b ≠ 0 := by
      intro heq
      apply hne_ab
      refine g.injective ?_
      rw [hga, heq]
    obtain ⟨x, hx_ne, hx_row0, hx_rel⟩ := prim_reduce_to_row0 hk hne ih r hinv (g b) hc_ne h0c
    have hrow0 := prim_row0_class ih r hinv x hx_ne hx_row0 hx_rel
    have hall := prim_extend_all_rows hk hne ih r hinv hrow0
    exact fun x y ↦ r.trans (r.symm (hall x)) (hall y)

open Pointwise in
/-- `CT (k + 1)` is preprimitive. -/
lemma CT_growth_isPreprimitive {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq)
    (ih : CT k = ⊤) : MulAction.IsPreprimitive (CT (k + 1)) (Fin ((k + 1).lcmSeq)) := by
  let : MulAction.IsPretransitive (CT (k + 1)) (Fin (lcmSeq (k + 1))) :=
    ⟨fun x y ↦ (CT_growth_transitive hk hne ih).exists_smul_eq x y⟩
  apply MulAction.IsPreprimitive.of_isTrivialBlock_base 0
  intro B hB0 hB
  rw [MulAction.IsTrivialBlock]
  set r : Setoid (Fin ((k + 1).lcmSeq)) :=
    ⟨fun x y ↦ ∃ g : ↥(CT (k + 1)), x ∈ g.1 • B ∧ y ∈ g.1 • B, by
      constructor
      · intro x
        obtain ⟨g, hg⟩ := this.exists_smul_eq 0 x
        exact ⟨g, and_self_iff.mpr ⟨0, hB0, hg⟩⟩
      · exact fun ⟨g, hg₁, hg₂⟩ ↦ ⟨g, hg₂, hg₁⟩
      · rintro x y z ⟨g, hx, hy⟩ ⟨h, hy', hz⟩
        have block_eq : g.1 • B = h.1 • B := hB.smul_eq_smul_of_nonempty ⟨y, hy, hy'⟩
        exact ⟨g, hx, block_eq ▸ hz⟩⟩
  have hinv : ∀ (g : ↥(CT (k + 1))) (x y), r.r x y → r.r (g.1 x) (g.1 y) := by
    intro g x y ⟨h, hh₁, hh₂⟩
    use g * h
    simpa only [Subgroup.coe_mul, mul_smul] using ⟨⟨x, hh₁, rfl⟩, y, hh₂, rfl⟩
  rcases CT_growth_primitive hk hne ih r hinv with h | h
  · right
    rw [Set.eq_univ_iff_forall]
    intro x
    obtain ⟨g, hg₁, hg₂⟩ := h 0 x
    suffices g.1 • B = B by exact this ▸ hg₂
    exact hB.smul_eq_of_nonempty ⟨0, hg₁, hB0⟩
  · left
    apply Set.subsingleton_of_forall_eq 0
    intro x hBx
    apply h
    use 1
    simp only [OneMemClass.coe_one, one_smul]
    exact ⟨hBx, hB0⟩

/-- The alternating group is contained in `CT (k + 1)` in the growth case. -/
lemma CT_growth_alt_le {k : ℕ} (hk : k ≥ 4) (hne : (k + 1).lcmSeq ≠ k.lcmSeq) (ih : CT k = ⊤) :
    alternatingGroup (Fin ((k + 1).lcmSeq)) ≤ CT (k + 1) := by
  obtain ⟨σ, hσ_mem, hσ_three⟩ := CT_growth_contains_three_cycle hk hne ih
  exact Perm.alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem
      (CT_growth_isPreprimitive hk hne ih) hσ_three hσ_mem

/-- Extend a subgroup of `Perm (Fin (lcmSeq k))` to `Perm (Fin (lcmSeq (k + 1)))` by repeating
the action on `Fin (lcmSeq k)`. -/
def _root_.Subgroup.Sync {k : ℕ} (H : Subgroup (Perm (Fin (k.lcmSeq)))) :
    Subgroup (Perm (Fin ((k + 1).lcmSeq))) :=
  H.map (dvdRepeatHom (k.lcmSeq_dvd_lcmSeq_succ))

/-- Syncing `CT' d k` up to `Fin (lcmSeq (k + 1))` gives `CT' d (k + 1)`. -/
lemma sync_CT_eq_CT_succ' {d k : ℕ} (hd : d ∈ Finset.Ioc 0 k) : (CT' d k).Sync = (CT' d (k + 1)) := by
  have hd' : d ∈ Finset.Ioc 0 (k + 1) := by
    simp_all only [Finset.mem_Ioc, true_and]
    linarith
  simp only [Subgroup.Sync, CT', hd, ↓reduceDIte, MonoidHom.map_closure, hd']
  apply Subgroup.closure_eq_of_le
  · rintro σ ⟨τ, ⟨⟨⟨r₁, r₂⟩, rfl⟩, rfl⟩⟩
    simp only [dvdRepeatHom_apply, SetLike.mem_coe]
    rw [← dvdRepeat_dvd _ _ (dvd_lcmSeq_of_mem hd')]
    apply Subgroup.mem_closure_of_mem
    simp only [Set.mem_range, Prod.exists, exists_apply_eq_apply2]
  · rw [Subgroup.closure_le]
    rintro σ ⟨⟨r₁, r₂⟩, rfl⟩
    apply Subgroup.mem_closure_of_mem
    simp only [Set.mem_image, Set.mem_range, Prod.exists, exists_exists_exists_and_eq]
    use r₁
    use r₂
    rw [dvdRepeatHom_apply, ← dvdRepeat_dvd]

/-- The synced copy of `CT k` is contained in `CT (k + 1)`. -/
lemma sync_CT_le_CT_succ {k : ℕ} : (CT k).Sync ≤ CT (k + 1) := by
  simp only [Subgroup.Sync, CT, Subgroup.map_iSup, iSup_le_iff]
  intro d hd
  apply le_iSup_of_le d
  have hd' : d ∈ Finset.Icc 2 (k + 1) := by
    simp_all only [Finset.mem_Icc, true_and]
    linarith
  apply le_iSup_of_le hd'
  rw [← Subgroup.Sync]
  refine le_of_eq (sync_CT_eq_CT_succ' (d := d) (k := k) ?_)
  simp_all only [Finset.mem_Icc, true_and, Finset.mem_Ioc, and_true]
  linarith

/-- The sign of `dvdRepeat` of a swap with modulus `d` is `(-1) ^ (lcmSeq k / d)`. -/
lemma sign_lcmRepeat_swap {k d : ℕ} (hd : d ∈ Finset.Ioc 0 k) (r₁ r₂ : Fin d) (hr : r₁ ≠ r₂) :
    Perm.sign ((swap r₁ r₂).dvdRepeat (dvd_lcmSeq_of_mem hd)) = (-1) ^ (k.lcmSeq / d) := by
  unfold dvdRepeat classRepeat
  simp only [Perm.sign_permCongr]
  convert Perm.sign_prodCongrRight (fun _ ↦ swap r₁ r₂)
  simp only [Perm.sign_swap hr, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- For `k ≥ 4`, there exists `d` with `2 ≤ d ≤ k + 1` and `lcmSeq (k + 1) / d` odd. -/
lemma exists_odd_divisor {k : ℕ} (hk : k ≥ 4) :
    ∃ d : ℕ, 2 ≤ d ∧ d ≤ k + 1 ∧ 0 < d ∧ Odd ((k + 1).lcmSeq / d) := by
  refine ⟨2 ^ (k + 1).lcmSeq.factorization 2, ?_, ?_, ?_, ?_⟩
  · apply Nat.le_self_pow
    apply Nat.ne_of_gt
    apply Nat.prime_two.factorization_pos_of_dvd
    · apply Nat.ne_of_gt
      exact (k + 1).lcmSeq_pos
    · apply dvd_lcmSeq_of_mem
      rw [Finset.mem_Ioc]
      constructor <;> omega
  · induction k, hk using le_induction with
    | base => native_decide
    | succ m hm ih =>
      rw [lcmSeq_succ, factorization_lcm (add_one_ne_zero _) (Nat.ne_of_gt (lcmSeq_pos _)),
        Finsupp.sup_apply]
      by_cases! h_max : (m + 1 + 1).factorization 2 ≤ (m + 1).lcmSeq.factorization 2
      · rw [Nat.max_eq_right h_max]
        exact le_trans ih (Nat.le_add_right (m + 1) 1)
      · rw [Nat.max_eq_left (le_of_lt h_max)]
        exact ordProj_le 2 (add_one_ne_zero _)
  · exact (k + 1).lcmSeq.ordProj_pos 2
  · rw [odd_iff, ← mod_two_ne_zero]
    intro h_even
    apply pow_succ_factorization_not_dvd (Nat.ne_of_gt (k + 1).lcmSeq_pos) prime_two
    rw [Nat.pow_add_one, ← dvd_div_iff_mul_dvd (ordProj_dvd _ _)]
    exact Nat.dvd_iff_mod_eq_zero.mpr h_even

/-- `CT (k + 1)` contains an odd permutation. -/
lemma CT_growth_odd_perm {k : ℕ} (hk : k ≥ 4) : ∃ σ ∈ CT (k + 1), Perm.sign σ = -1 := by
  obtain ⟨d, hd₁, hd₂, hd₃, hd₄⟩ := exists_odd_divisor hk
  refine
    ⟨(swap ⟨0, hd₃⟩ ⟨1, by omega⟩).dvdRepeat (dvd_lcmSeq_of_mem (Finset.mem_Ioc.mpr ⟨hd₃, hd₂⟩)),
      ?_, ?_⟩
  · apply Subgroup.mem_iSup_of_mem d
    simp [CT', hd₁, hd₂, hd₃]
    refine Subgroup.subset_closure ⟨⟨⟨0, hd₃⟩, ⟨1, ?_⟩⟩, rfl⟩
    omega
  · rw [← hd₄.neg_one_pow]
    refine sign_lcmRepeat_swap (Finset.mem_Ioc.mpr ⟨hd₃, hd₂⟩) ⟨0, hd₃⟩ ⟨1, ?_⟩ ?_
    norm_num

/-- If `alternatingGroup α ≤ G` and `G` contains an odd permutation, then `G = ⊤`. -/
lemma eq_top_of_alt_le_of_odd {α : Type*} [Fintype α] [DecidableEq α] {G : Subgroup (Perm α)}
    (h_alt : alternatingGroup α ≤ G) (h_odd : ∃ σ : Perm α, σ ∈ G ∧ σ.sign = -1) : G = ⊤ := by
  rw [eq_top_iff]
  intro τ _
  rcases Int.units_eq_one_or (Perm.sign τ) with h | h
  · exact h_alt (Perm.mem_alternatingGroup.mpr h)
  · obtain ⟨σ, hσG, hσsign⟩ := h_odd
    rw [show τ = (τ * σ⁻¹) * σ by group]
    apply G.mul_mem (h_alt (Perm.mem_alternatingGroup.mpr _)) hσG
    simp [map_mul, map_inv, hσsign, h]

/-- When `k ≥ 4`, `lcmSeq (k + 1) ≠ lcmSeq k`, and `CT k = ⊤`, then `CT (k + 1) = ⊤`. -/
lemma CT_succ_top_of_lcmSeq_neq {k : ℕ} (hk : k ≥ 4) (heq : (k + 1).lcmSeq ≠ k.lcmSeq)
    (CT_top : CT k = ⊤) : CT (k + 1) = ⊤ :=
  eq_top_of_alt_le_of_odd (CT_growth_alt_le hk heq CT_top) (CT_growth_odd_perm hk)

/-- When `lcmSeq (k + 1) = lcmSeq k` and `CT k = ⊤`, then `CT (k + 1) = ⊤`. -/
lemma CT_succ_top_of_lcmSeq_eq {k : ℕ} (heq : (k + 1).lcmSeq = k.lcmSeq) (CT_top : CT k = ⊤) :
    CT (k + 1) = ⊤ := by
  apply top_unique
  apply le_of_eq_of_le (Eq.symm _) sync_CT_le_CT_succ
  rw [CT_top, Subgroup.eq_top_iff']
  intro x
  refine ⟨(finCongr heq).permCongr x, SetLike.mem_coe.mpr trivial, ?_⟩
  ext
  simp [dvdRepeatHom_apply, Fin.modNat, ← heq, mod_eq_of_lt]

/-- For `k ≥ 4`, `CT k = ⊤`. -/
lemma CT_eq_top_of_ge_four {k : ℕ} (hk : 4 ≤ k) : CT k = ⊤ := by
  induction k, hk using le_induction with
  | base => exact CT_eq_top_four
  | succ k hle ih =>
    by_cases heq : (k + 1).lcmSeq = k.lcmSeq
    · exact CT_succ_top_of_lcmSeq_eq heq ih
    · exact CT_succ_top_of_lcmSeq_neq hle heq ih

/-- Restrict a permutation in `CT k` to the interval `0 ≤ n < lcmSeq k`. -/
noncomputable def reductionHom (k : ℕ) [NeZero k] : CT_same k →* Perm (Fin (k.lcmSeq)) where
  toFun σ := (CT_same_isShiftPeriodic_lcmSeq σ.2).reduce
  map_one' := IsShiftPeriodic.reduce_refl
  map_mul' σ τ := by
    ext i
    simp only [Subgroup.coe_mul, IsShiftPeriodic.reduce_apply, Perm.coe_mul, Function.comp_apply,
      Fin.val_intCast]
    zify
    repeat rw [Int.toNat_of_nonneg]
    rw [← (CT_same_isShiftPeriodic_lcmSeq σ.2).emod_eq]
    all_goals
      apply Int.emod_nonneg
      exact_mod_cast lcmSeq_ne_zero _

/-- `reductionHom k σ i = (σ i) % lcmSeq k`. -/
lemma reductionHom_apply (k : ℕ) [NeZero k] (σ : CT_same k) (i : Fin (k.lcmSeq)) :
    reductionHom k σ i = (σ.val i) % ↑k.lcmSeq := by
  unfold reductionHom
  simp only [MonoidHom.coe_mk, OneHom.coe_mk, IsShiftPeriodic.reduce_apply, Fin.val_intCast,
    Int.ofNat_toNat, sup_eq_left]
  apply Int.emod_nonneg
  exact_mod_cast k.lcmSeq_ne_zero

/-- For `2 ≤ d ≤ k`, the class transposition `τ` of two residues modulo `d` lies in `CT_same k`. -/
lemma τ_mem_CT_same_fin {d k : ℕ} [NeZero k] (hd : d ∈ Finset.Icc 2 k) (r₁ r₂ : Fin d) :
    τ ↑r₁.val ↑d ↑r₂.val ↑d ∈ CT_same k := by
  apply τ_mem_CT_same
  all_goals simp_all

/-- On the block `[0, k)`, the class transposition `τ r₁ k r₂ k` acts as the plain `swap r₁ r₂`. -/
lemma τ_apply_of_lt {r₁ r₂ k n : ℤ} (hr₁ : r₁ ∈ Finset.Ico 0 k) (hr₂ : r₂ ∈ Finset.Ico 0 k)
    (hn : n ∈ Finset.Ico 0 k) : τ r₁ k r₂ k n = swap r₁ r₂ n := by
  simp_all only [Finset.mem_Ico]
  have h_eq₁ : k ∣ n - r₁ → n = r₁ := by
    rintro ⟨a, ha⟩
    rwa [show a = 0 by nlinarith, mul_zero, sub_eq_zero] at ha
  have h_eq₂ : k ∣ n - r₂ → n = r₂ := by
    rintro ⟨a, ha⟩
    rwa [show a = 0 by nlinarith, mul_zero, sub_eq_zero] at ha
  by_cases h : r₁ = r₂
  · simp [h, τ_dvd]
  · rw [τ_apply]
    · unfold τFun
      by_cases h₁ : n = r₁ <;> by_cases h₂ : n = r₂
      all_goals
        simp_all only [sub_self, dvd_zero, and_self, imp_self, imp_false, not_false_eq_true,
          ↓reduceIte, EuclideanDomain.zero_div, zero_mul, add_zero, swap_apply_left, swap_apply_def]
    · linarith [hr₁, hr₂]
    · linarith [hr₁, hr₂]
    · simp_all only [Int.gcd_self, cast_natAbs, Int.cast_abs, Int.cast_eq, abs_dvd]
      rintro ⟨a, ha⟩
      apply h
      nlinarith [show a = 0 by nlinarith]

/-- `τ r₁ d r₂ d` permutes the block `[0, lcmSeq k)` setwise. -/
lemma τ_same_fix_Ico_lcmSeq {d : ℤ} {k : ℕ} {r₁ r₂ : ℤ} (hd : d ∈ Finset.Icc 2 ↑k)
    (hr₁ : r₁ ∈ Set.Ico 0 d) (hr₂ : r₂ ∈ Set.Ico 0 d) :
    (Finset.Ico 0 ↑k.lcmSeq).image (τ r₁ d r₂ d) = Finset.Ico 0 ↑k.lcmSeq := by
  have : d ∣ ↑k.lcmSeq := by
    rw [Int.dvd_natCast]
    apply dvd_lcmSeq_of_mem
    simp_all only [Finset.mem_Icc, Set.mem_Ico, Finset.mem_Ioc, Int.natAbs_pos, ne_eq]
    constructor
    · linarith
    · zify
      rw [abs_of_nonneg] <;> linarith
  obtain ⟨k', hk'⟩ := this
  rw [mul_comm] at hk'
  simp only [hk']
  apply τ_same_mod_setwise_Ico_mul
  all_goals simp_all only [Finset.mem_Icc, Set.mem_Ico, true_and] <;> nlinarith

/-- The reduction of `τ d r₁ r₂` equals the `dvdRepeat` of `swap r₁ r₂` under `finCongr`. -/
lemma reductionHom_τ_eq_lcmRepeat {d k : ℕ} [NeZero k] (hd : d ∈ Finset.Icc 2 k)
    (hd' : d ∈ Finset.Ioc 0 k) {r₁ r₂ : Fin d} :
    reductionHom k ⟨τ ↑r₁.val ↑d ↑r₂.val ↑d, τ_mem_CT_same_fin hd r₁ r₂⟩ =
      (swap r₁ r₂).dvdRepeat (dvd_lcmSeq_of_mem hd') := by
  ext i
  have : τ ↑r₁.val ↑d ↑r₂.val ↑d ↑i.val ∈ Finset.Ico 0 ↑k.lcmSeq := by
    obtain ⟨k', hk'⟩ := dvd_lcmSeq_of_mem hd'
    zify at hk'
    rw [mul_comm] at hk'
    rw [hk', ← τ_same_mod_setwise_Ico_mul]
    · rw [Finset.mem_image]
      refine ⟨↑i.val, ?_, rfl⟩
      simp_all [← hk']
    all_goals simp_all
  zify
  rw [reductionHom_apply, dvdRepeat_apply_val, Int.emod_eq_of_lt,
    (τ_same_isShiftPeriodic).eq_apply_mod]
  · simp only [cast_add, cast_mul, Int.natCast_ediv, add_left_inj]
    rw [τ_apply_of_lt]
    · rw [Function.Injective.map_swap (f := Fin.val), Function.Injective.map_swap (f := Nat.cast)]
      simp_all only [Finset.mem_Icc, Finset.mem_Ico, Fin.coe_modNat, Fin.val_cast, Int.natCast_emod]
      · exact CharZero.cast_injective
      · exact Fin.val_injective
    all_goals simp_all
    constructor
    · apply Int.emod_nonneg
      norm_num
      exact Nat.ne_zero_of_lt hd'
    · apply Int.emod_lt_of_pos
      norm_cast
  · exact_mod_cast (Finset.mem_Ico.mp this).1
  · exact_mod_cast (Finset.mem_Ico.mp this).2

/-- Every element of `CT_pair d d` (`2 ≤ d ≤ k`) permutes the block `[0, lcmSeq k)` setwise. -/
lemma CT_pair_fix_Ico_lcmSeq {k : ℕ} {d : ℤ} [NeZero k] (hd : d ∈ Finset.Icc 2 ↑k) {σ : Perm ℤ}
    (hσ : σ ∈ CT_pair d d) : (Finset.Ico 0 ↑k.lcmSeq).image σ = Finset.Ico 0 ↑k.lcmSeq := by
  rw [CT_pair_def] at hσ
  induction hσ using Subgroup.closure_induction with
  | mem _ hσ =>
    obtain ⟨r₁, hr₁, r₂, hr₂, rfl⟩ := hσ
    exact τ_same_fix_Ico_lcmSeq hd hr₁ hr₂
  | one => simp
  | mul _ _ _ _ h₁ h₂ => rw [Perm.coe_mul, ← Finset.image_image, h₂, h₁]
  | inv σ _ h =>
    rw [Perm.coe_inv]
    apply Finset.eq_of_subset_of_card_le
    · grind
    · rw [Finset.card_image_of_injective _ σ.symm.injective]

/-- Every element of `CT_same k` permutes the block `[0, lcmSeq k)` setwise. -/
lemma CT_same_fix_Ico_lcmSeq {k : ℕ} [NeZero k] {σ : Perm ℤ} (hσ : σ ∈ CT_same k) :
    (Finset.Ico 0 ↑k.lcmSeq).image σ = Finset.Ico 0 ↑k.lcmSeq := by
  rw [CT_same] at hσ
  induction hσ using Subgroup.iSup_induction' with
  | hp d _ hσ =>
    induction hσ using Subgroup.iSup_induction' with
    | hp hd σ hσ => exact CT_pair_fix_Ico_lcmSeq hd hσ
    | h1 => simp only [Perm.coe_one, Finset.image_id]
    | hmul _ _ _ _ h₁ h₂ => rw [Perm.coe_mul, ← Finset.image_image, h₂, h₁]
  | h1 => simp only [Perm.coe_one, Finset.image_id]
  | hmul _ _ _ _ h₁ h₂ => rw [Perm.coe_mul, ← Finset.image_image, h₂, h₁]

/-- `reductionHom k` is injective. -/
lemma reductionHom_injective {k : ℕ} [NeZero k] : Function.Injective (reductionHom k) := by
  intro σ τ h_eq
  simp only [CT_same_eq_sup_CT_pair, reductionHom, MonoidHom.coe_mk, OneHom.coe_mk] at h_eq
  apply IsShiftPeriodic.mod_eq_of_reduce_eq at h_eq
  rw [← Subtype.val_inj,
    IsShiftPeriodic.ext_iff _ (CT_same_isShiftPeriodic_lcmSeq σ.2)
      (CT_same_isShiftPeriodic_lcmSeq τ.2)]
  · intro n hn
    have hσn := CT_same_fix_Ico_lcmSeq σ.2 ▸ Finset.mem_image_of_mem σ.1 hn
    have hτn := CT_same_fix_Ico_lcmSeq τ.2 ▸ Finset.mem_image_of_mem τ.1 hn
    rw [Finset.mem_Ico] at hσn hτn
    specialize h_eq n
    rw [← (σ.1 n).emod_add_mul_ediv k.lcmSeq, ← (τ.1 n).emod_add_mul_ediv k.lcmSeq, h_eq]
    congr 2
    rw [Int.ediv_eq_zero_of_lt hσn.1 hσn.2, Int.ediv_eq_zero_of_lt hτn.1 hτn.2]
  · exact_mod_cast k.lcmSeq_pos

/-- For `k ≥ 4`, `reductionHom k` is surjective (this is where `CT k = ⊤` enters). -/
lemma reductionHom_surjective {k : ℕ} [NeZero k] (hk : 4 ≤ k) :
    Function.Surjective (reductionHom k) := by
  rw [← MonoidHom.range_eq_top, eq_top_iff, ← CT_eq_top_of_ge_four hk, CT, iSup_le_iff]
  intro d
  rw [iSup_le_iff]
  intro hd
  have hd' : d ∈ Finset.Ioc 0 k := by
    simp_all only [Finset.mem_Icc, Finset.mem_Ioc, and_true]
    omega
  simp only [CT', hd', ↓reduceDIte, CT_same_eq_sup_CT_pair, Subgroup.closure_le,
    MonoidHom.coe_range]
  rintro σ ⟨⟨r₁, r₂⟩, rfl⟩
  refine ⟨⟨τ r₁ d r₂ d, ?_⟩, ?_⟩
  · exact τ_mem_CT_same_fin hd r₁ r₂
  · exact reductionHom_τ_eq_lcmRepeat hd hd'

/-- **Kourovka Notebook Problem 21.8**.
For every integer `k ≥ 4`, the group `CT k` of class transpositions of moduli `2, 3, …, k` is
isomorphic to the symmetric group on `N` letters, where `N = lcm(2, 3, …, k)`. -/
theorem _root_.kourovka_21_8 {k : ℕ} (hk : 4 ≤ k) : Nonempty (CT_same k ≃* Perm (Fin (k.lcmSeq))) :=
  let : NeZero k := NeZero.mk (by linarith)
  ⟨MulEquiv.ofBijective (reductionHom k) ⟨reductionHom_injective, reductionHom_surjective hk⟩⟩

end Kourovka
